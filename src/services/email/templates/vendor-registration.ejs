<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Vendor Registration Received</title>
</head>

<body style="
    margin: 0;
    padding: 0;
    background-color: #FDFDFC;
    font-family: Arial, Helvetica, sans-serif;
    color: #252525;
">
    <table
        role="presentation"
        width="100%"
        cellpadding="0"
        cellspacing="0"
        border="0"
        style="background-color: #FDFDFC; margin: 0; padding: 0;"
    >
        <tr>
            <td align="center" style="padding: 32px 16px;">

                <!-- Email container -->
                <table
                    role="presentation"
                    width="600"
                    cellpadding="0"
                    cellspacing="0"
                    border="0"
                    style="
                        width: 100%;
                        max-width: 600px;
                        background-color: #FFFFFF;
                        border: 1px solid #EEEEEE;
                        border-radius: 10px;
                        overflow: hidden;
                    "
                >

                    <!-- Header -->
                    <tr>
                        <td
                            align="center"
                            style="
                                padding: 28px 24px;
                                border-bottom: 1px solid #EEEEEE;
                                background-color: #FFFFFF;
                            "
                        >
                            <img
                                src="<%= businessLogoUrl %>"
                                alt="Cococe Business"
                                width="190"
                                style="
                                    display: block;
                                    width: 190px;
                                    max-width: 100%;
                                    height: auto;
                                    border: 0;
                                "
                            >
                        </td>
                    </tr>


                    <!-- Main content -->
                    <tr>
                        <td style="padding: 36px 40px 32px;">

                            <!-- Status indicator -->
                            <table
                                role="presentation"
                                width="100%"
                                cellpadding="0"
                                cellspacing="0"
                                border="0"
                            >
                                <tr>
                                    <td align="center" style="padding-bottom: 22px;">

                                        <table
                                            role="presentation"
                                            cellpadding="0"
                                            cellspacing="0"
                                            border="0"
                                        >
                                            <tr>
                                                <td
                                                    align="center"
                                                    style="
                                                        background-color: #FEE2E3;
                                                        color: #C9171F;
                                                        padding: 8px 16px;
                                                        border-radius: 20px;
                                                        font-size: 13px;
                                                        font-weight: bold;
                                                    "
                                                >
                                                    REGISTRATION RECEIVED
                                                </td>
                                            </tr>
                                        </table>

                                    </td>
                                </tr>
                            </table>


                            <!-- Heading -->
                            <h1 style="
                                margin: 0 0 18px;
                                color: #252525;
                                font-size: 26px;
                                line-height: 34px;
                                font-weight: 700;
                                text-align: center;
                            ">
                                Thank You for Registering
                            </h1>


                            <!-- Greeting -->
                            <p style="
                                margin: 0 0 16px;
                                font-size: 15px;
                                line-height: 24px;
                                color: #444444;
                            ">
                                Hello <strong><%= firstName %> <%= lastName %></strong>,
                            </p>


                            <!-- Message -->
                            <p style="
                                margin: 0 0 16px;
                                font-size: 15px;
                                line-height: 24px;
                                color: #444444;
                            ">
                                Thank you for registering your business with
                                <strong>Cococe Business</strong>.
                                We have successfully received your vendor
                                registration request.
                            </p>

                            <p style="
                                margin: 0 0 28px;
                                font-size: 15px;
                                line-height: 24px;
                                color: #444444;
                            ">
                                Your registration has been submitted successfully
                                and is currently being reviewed by our team.
                                Please keep your registration reference number
                                for future communication.
                            </p>


                            <!-- Registration details -->
                            <table
                                role="presentation"
                                width="100%"
                                cellpadding="0"
                                cellspacing="0"
                                border="0"
                                style="
                                    background-color: #FFF5F5;
                                    border: 1px solid #FEE2E3;
                                    border-radius: 8px;
                                "
                            >
                                <tr>
                                    <td style="padding: 20px 22px;">

                                        <p style="
                                            margin: 0 0 16px;
                                            color: #C9171F;
                                            font-size: 15px;
                                            font-weight: bold;
                                        ">
                                            Registration Details
                                        </p>

                                        <table
                                            role="presentation"
                                            width="100%"
                                            cellpadding="0"
                                            cellspacing="0"
                                            border="0"
                                        >

                                            <tr>
                                                <td
                                                    width="42%"
                                                    style="
                                                        padding: 7px 0;
                                                        font-size: 14px;
                                                        color: #777777;
                                                    "
                                                >
                                                    Reference Number
                                                </td>

                                                <td
                                                    style="
                                                        padding: 7px 0;
                                                        font-size: 14px;
                                                        font-weight: bold;
                                                        color: #252525;
                                                    "
                                                >
                                                    <%= referenceNumber %>
                                                </td>
                                            </tr>


                                            <tr>
                                                <td
                                                    style="
                                                        padding: 7px 0;
                                                        font-size: 14px;
                                                        color: #777777;
                                                    "
                                                >
                                                    Vendor ID
                                                </td>

                                                <td
                                                    style="
                                                        padding: 7px 0;
                                                        font-size: 14px;
                                                        font-weight: bold;
                                                        color: #252525;
                                                    "
                                                >
                                                    <%= vendorId %>
                                                </td>
                                            </tr>


                                            <tr>
                                                <td
                                                    style="
                                                        padding: 7px 0;
                                                        font-size: 14px;
                                                        color: #777777;
                                                    "
                                                >
                                                    Name
                                                </td>

                                                <td
                                                    style="
                                                        padding: 7px 0;
                                                        font-size: 14px;
                                                        color: #252525;
                                                    "
                                                >
                                                    <%= firstName %> <%= lastName %>
                                                </td>
                                            </tr>


                                            <tr>
                                                <td
                                                    style="
                                                        padding: 7px 0;
                                                        font-size: 14px;
                                                        color: #777777;
                                                    "
                                                >
                                                    Email
                                                </td>

                                                <td
                                                    style="
                                                        padding: 7px 0;
                                                        font-size: 14px;
                                                        color: #252525;
                                                        word-break: break-word;
                                                    "
                                                >
                                                    <%= email %>
                                                </td>
                                            </tr>


                                            <tr>
                                                <td
                                                    style="
                                                        padding: 7px 0;
                                                        font-size: 14px;
                                                        color: #777777;
                                                    "
                                                >
                                                    Status
                                                </td>

                                                <td
                                                    style="
                                                        padding: 7px 0;
                                                        font-size: 14px;
                                                        font-weight: bold;
                                                        color: #C9171F;
                                                    "
                                                >
                                                    Under Review
                                                </td>
                                            </tr>

                                        </table>

                                    </td>
                                </tr>
                            </table>


                            <!-- CTA -->
                            <% if (portalUrl) { %>

                                <table
                                    role="presentation"
                                    width="100%"
                                    cellpadding="0"
                                    cellspacing="0"
                                    border="0"
                                    style="margin-top: 28px;"
                                >
                                    <tr>
                                        <td align="center">

                                            <a
                                                href="<%= portalUrl %>"
                                                style="
                                                    display: inline-block;
                                                    background-color: #ED1B24;
                                                    color: #FFFFFF;
                                                    text-decoration: none;
                                                    font-size: 14px;
                                                    font-weight: bold;
                                                    padding: 13px 24px;
                                                    border-radius: 6px;
                                                "
                                            >
                                                View Registration
                                            </a>

                                        </td>
                                    </tr>
                                </table>

                            <% } %>


                            <!-- Additional information -->
                            <p style="
                                margin: 28px 0 0;
                                padding-top: 20px;
                                border-top: 1px solid #EEEEEE;
                                font-size: 13px;
                                line-height: 21px;
                                color: #777777;
                            ">
                                If you did not submit this registration, please
                                contact Cococe Business support and provide the
                                reference number shown above.
                            </p>

                        </td>
                    </tr>


                    <!-- Footer -->
                    <tr>
                        <td
                            align="center"
                            style="
                                padding: 24px 30px;
                                background-color: #FDFDFC;
                                border-top: 1px solid #EEEEEE;
                            "
                        >

                            <img
                                src="<%= faviconUrl %>"
                                alt=""
                                width="32"
                                height="32"
                                style="
                                    display: block;
                                    width: 32px;
                                    height: 32px;
                                    margin-bottom: 10px;
                                    border: 0;
                                "
                            >

                            <p style="
                                margin: 0 0 6px;
                                font-size: 13px;
                                font-weight: bold;
                                color: #444444;
                            ">
                                Cococe Business
                            </p>

                            <p style="
                                margin: 0;
                                font-size: 12px;
                                line-height: 18px;
                                color: #999999;
                            ">
                                This is an automated notification.
                                Please do not reply directly to this email.
                            </p>

                            <p style="
                                margin: 10px 0 0;
                                font-size: 12px;
                                color: #AAAAAA;
                            ">
                                &copy; <%= year %> Cococe. All rights reserved.
                            </p>

                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>
</html>