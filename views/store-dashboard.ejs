          ['New Customer Coupon', 'Active', '47', '$1,260', 'Aug 1–Sep 30']
        ]
      },
      analytics: {
        title: 'Analytics',
        subtitle: 'Performance for Bahati Electronics',
        action: 'Export Report',
        icon: 'bar-chart-3',
        columns: ['Metric', 'Current Period', 'Previous Period', 'Change'],
        rows: [
          ['Revenue', '$24,580', '$21,850', '+12.5%'],
          ['Orders', '1,284', '1,187', '+8.2%'],
          ['Customers', '892', '780', '+14.4%'],
          ['Conversion rate', '4.8%', '4.4%', '+0.4pp'],
          ['Average order value', '$19.14', '$18.44', '+3.8%'],
          ['Refund rate', '1.8%', '2.1%', '-0.3pp']
        ]
      },
      categories: {
        title: 'Categories',
        subtitle: '8 categories · 19 subcategories',
        action: 'Add Category',
        icon: 'folder-tree',
        columns: ['Category', 'Products', 'Visibility', 'Order', 'Updated'],
        rows: [
          ['Electronics', '112', 'Visible', '1', 'Today'],
          ['Mobile Phones', '34', 'Visible', '2', 'Sep 7'],
          ['Accessories', '78', 'Visible', '3', 'Sep 6'],
          ['Audio', '24', 'Visible', '4', 'Sep 4']
        ]
      },
      storefront: {
        title: 'Storefront',
        subtitle: 'Manage how Bahati Electronics appears to customers',
        action: 'Edit Storefront',
        icon: 'store',
        columns: ['Section', 'Status', 'Last Updated'],
        rows: [
          ['Store Profile', 'Complete', 'Today'],
          ['Store Logo', 'Uploaded', 'Sep 7'],
          ['Store Banner', 'Uploaded', 'Sep 6'],
          ['Featured Products', '8 selected', 'Sep 5'],
          ['Store Policies', 'Complete', 'Sep 1']
        ]
      },
      settings: {
        title: 'Store Settings',
        subtitle: 'Configuration scoped to Bahati Electronics',
        action: 'Save Changes',
        icon: 'settings',
        columns: ['Setting', 'Configuration', 'Status'],
        rows: [
          ['Store Information', 'Bahati Electronics', 'Complete'],
          ['Store Policies', 'Returns: 14 days', 'Complete'],
          ['Shipping', '2 methods · 1 warehouse', 'Complete'],
          ['Payments', 'Marketplace payments', 'Active'],
          ['Notifications', 'Email + dashboard', 'Active'],
          ['Staff & Permissions', '4 staff members', 'Configured'],
          ['Security', '2FA enabled', 'Active']
        ]
      }
    };

    function badge(value) {
      const v = String(value).toLowerCase();
      let c = 'bg-slate-100 text-slate-600';
      if (v.includes('active') || v.includes('paid') || v.includes('healthy') || v.includes('completed') || v.includes('answered') || v.includes('visible') || v.includes('enabled') || v.includes('complete')) c = 'bg-emerald-50 text-emerald-700';
      if (v.includes('low') || v.includes('pending') || v.includes('processing') || v.includes('scheduled') || v.includes('to ship')) c = 'bg-amber-50 text-amber-700';
      if (v.includes('out of stock') || v.includes('return') || v.includes('open') || v.includes('unanswered') || v.includes('dispute')) c = 'bg-rose-50 text-rose-700';
      if (v.includes('shipped')) c = 'bg-[var(--color-brand-ultralight)] text-[var(--color-brand-dark)]';
      return `<span class="rounded-full px-2.5 py-1 text-xs font-semibold ${c}">${value}</span>`;
    }

    function renderDataPage(key) {
      const d = pageData[key],
        el = document.getElementById('page-' + key);
      const statusIndex = d.columns.findIndex(c => ['Status', 'Fulfillment', 'Payment', 'Response'].includes(c));
      const rows = d.rows.map(r => `<tr class="hover:bg-slate-50" data-row-status="${String(statusIndex >= 0 ? r[statusIndex] : '').toLowerCase()}">${r.map((x,i)=>`<td class="whitespace-nowrap px-5 py-4 ${i===0?'font-semibold':''}">${(i>0 && (String(x).toLowerCase().includes('active')||String(x).toLowerCase().includes('pending')||String(x).toLowerCase().includes('processing')||String(x).toLowerCase().includes('shipped')||String(x).toLowerCase().includes('delivered')||String(x).toLowerCase().includes('out of stock')||String(x).toLowerCase().includes('low stock')||String(x).toLowerCase().includes('answered')||String(x).toLowerCase().includes('unanswered')||String(x).toLowerCase().includes('requested')||String(x).toLowerCase().includes('approved')||String(x).toLowerCase().includes('received')||String(x).toLowerCase().includes('open')||String(x).toLowerCase().includes('resolved')||String(x).toLowerCase().includes('under review')||String(x).toLowerCase().includes('scheduled')||String(x).toLowerCase().includes('healthy')||String(x).toLowerCase().includes('visible')||String(x).toLowerCase().includes('complete')||String(x).toLowerCase().includes('enabled'))) ? badge(x) : x}${(key==='orders' && i===7)?`<button data-action="open-order" class="font-semibold text-[var(--color-brand)]">View</button>`:''}</td>`).join('')}</tr>`).join('');
      el.innerHTML = `<div class="mb-6 flex flex-col justify-between gap-4 md:flex-row md:items-end"><div><div class="mb-1 flex items-center gap-2 text-[var(--color-brand)]"><i data-lucide="${d.icon}" class="h-4 w-4"></i><span class="text-sm font-semibold">Bahati Electronics</span></div><h1 class="text-2xl font-bold tracking-tight">${d.title}</h1><p class="mt-1 text-sm text-slate-500">${d.subtitle}</p></div><div class="flex gap-2"><button class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium hover:bg-slate-50">Export</button><button data-action="generated-action" data-message="${d.action}" class="rounded-lg bg-[var(--color-brand)] px-3 py-2 text-sm font-semibold text-white hover:bg-[var(--color-brand-dark)]">${d.action}</button></div></div>
  <div class="rounded-xl border border-slate-200 bg-white shadow-sm"><div class="flex flex-col gap-3 border-b border-slate-100 p-4 md:flex-row"><div class="relative flex-1"><i data-lucide="search" class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"></i><input data-action="filter-table" placeholder="Search ${d.title.toLowerCase()}..." class="w-full rounded-lg border border-slate-200 bg-slate-50 py-2 pl-9 pr-3 text-sm outline-none focus:border-[var(--color-brand)] focus:bg-white"></div><select data-action="status-filter" class="rounded-lg border border-slate-200 px-3 py-2 text-sm outline-none focus:border-[var(--color-brand)]"><option value="all">All statuses</option><option value="active">Active</option><option value="processing">Processing</option><option value="pending">Pending</option><option value="to ship">To Ship</option><option value="shipped">Shipped</option><option value="delivered">Delivered</option><option value="out of stock">Out of stock</option><option value="low stock">Low stock</option></select><button class="rounded-lg border border-slate-200 px-3 py-2 text-sm font-medium hover:bg-slate-50"><i data-lucide="filter" class="inline h-4 w-4"></i> Filters</button></div>
  <div class="overflow-x-auto"><table class="w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500"><tr>${d.columns.map(c=>`<th class="whitespace-nowrap px-5 py-3">${c}</th>`).join('')}</tr></thead><tbody id="${key}-tbody" class="divide-y divide-slate-100">${rows}</tbody></table></div><div class="flex flex-col items-center justify-between gap-3 border-t border-slate-100 p-4 text-sm text-slate-500 sm:flex-row"><span>Showing 1–${d.rows.length} of ${d.rows.length > 4 ? '246' : d.rows.length}</span><div class="flex gap-1"><button class="rounded-lg border px-3 py-1.5 hover:bg-slate-50">Previous</button><button class="rounded-lg border bg-[var(--color-brand)] px-3 py-1.5 font-semibold text-white">1</button><button class="rounded-lg border px-3 py-1.5 hover:bg-slate-50">2</button><button class="rounded-lg border px-3 py-1.5 hover:bg-slate-50">Next</button></div></div></div>`;
      lucide.createIcons();
    }
    Object.keys(pageData).forEach(renderDataPage);

    function showPage(key, btn) {
      document.querySelectorAll('.page').forEach(p => p.classList.add('hidden'));
      const page = document.getElementById('page-' + key);
      if (page) page.classList.remove('hidden');

      document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
      if (btn) {
        btn.classList.add('active');
      } else {
        document.querySelector(`.nav-item[data-page="${key}"]`)?.classList.add('active');
      }

      closeMobileSidebar();
      window.scrollTo({
        top: 0,
        left: 0,
        behavior: 'auto'
      });
    }

    function toggleDesktopSidebar() {
      const sidebar = document.getElementById('sidebar');
      const button = document.getElementById('sidebarToggleButton');
      const collapsed = sidebar.classList.toggle('sidebar-collapsed');

      // One source of truth controls BOTH the sidebar box and the main content offset.
      document.documentElement.style.setProperty(
        '--sidebar-width',
        collapsed ? '76px' : '288px'
      );

      button?.setAttribute('aria-expanded', String(!collapsed));
      button?.setAttribute(
        'aria-label',
        collapsed ? 'Expand sidebar' : 'Collapse sidebar'
      );

      const icon = button?.querySelector('[data-lucide]');
      if (icon) {
        icon.setAttribute(
          'data-lucide',
          collapsed ? 'panel-left-open' : 'panel-left-close'
        );
        lucide.createIcons();
      }
    }

    function openMobileSidebar() {
      const sidebar = document.getElementById('sidebar');
      const backdrop = document.getElementById('sidebarBackdrop');
      sidebar.classList.remove('-translate-x-full');
      sidebar.classList.add('translate-x-0');
      backdrop.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
    }

    function closeMobileSidebar() {
      const sidebar = document.getElementById('sidebar');
      const backdrop = document.getElementById('sidebarBackdrop');
      if (!window.matchMedia('(max-width: 1023px)').matches) return;
      sidebar.classList.add('-translate-x-full');
      sidebar.classList.remove('translate-x-0');
      backdrop.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
    }

    function toggleStoreMenu() {
      document.getElementById('storeMenu').classList.toggle('hidden');
    }

    function openOrder() {
      document.getElementById('drawerOverlay').classList.remove('hidden');
      document.getElementById('orderDrawer').classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
    }

    function closeOrder() {
      document.getElementById('drawerOverlay').classList.add('hidden');
      document.getElementById('orderDrawer').classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
    }

    function toast(message) {
      const toastElement = document.getElementById('toast');
      toastElement.textContent = message;
      toastElement.classList.remove('hidden');
      window.clearTimeout(window.__toastTimer);
      window.__toastTimer = window.setTimeout(() => {
        toastElement.classList.add('hidden');
      }, 2200);
    }

    function applyTableFilters(container) {
      const searchInput = container.querySelector('[data-action="filter-table"]');
      const statusSelect = container.querySelector('[data-action="status-filter"]');
      const query = searchInput?.value.toLowerCase().trim() || '';
      const status = statusSelect?.value.toLowerCase() || 'all';
      const table = container.querySelector('tbody');

      if (!table) return;

      [...table.rows].forEach(row => {
        const matchesSearch = !query || row.innerText.toLowerCase().includes(query);
        const rowStatus = row.dataset.rowStatus || '';
        const matchesStatus = status === 'all' || rowStatus.includes(status);
        row.style.display = matchesSearch && matchesStatus ? '' : 'none';
      });
    }

    function filterTable(input) {
      const container = input.closest('.rounded-xl');
      applyTableFilters(container);
    }

    function filterTableByStatus(select) {
      const container = select.closest('.rounded-xl');
      applyTableFilters(container);
    }

    function toggleProfileMenu(menuId, buttonId) {
      const menu = document.getElementById(menuId);
      const button = document.getElementById(buttonId);
      if (!menu || !button) return;

      const willOpen = !menu.classList.contains('open');

      document.querySelectorAll('.profile-menu').forEach(item => {
        item.classList.remove('open');
        item.classList.add('closed');
      });
      document.querySelectorAll('#headerProfileButton, #sidebarProfileButton').forEach(item => {
        item.setAttribute('aria-expanded', 'false');
      });

      if (willOpen) {
        menu.classList.remove('closed');
        menu.classList.add('open');
        button.setAttribute('aria-expanded', 'true');
      }
    }

    function closeProfileMenus() {
      document.querySelectorAll('.profile-menu').forEach(menu => {
        menu.classList.remove('open');
        menu.classList.add('closed');
      });
      document.querySelectorAll('#headerProfileButton, #sidebarProfileButton').forEach(button => {
        button.setAttribute('aria-expanded', 'false');
      });
    }

    function bindEvents() {
      // Sidebar navigation
      document.querySelectorAll('.nav-item[data-page]').forEach(button => {
        button.addEventListener('click', () => showPage(button.dataset.page, button));
      });

      // Sidebar controls
      document.getElementById('sidebarToggleButton')?.addEventListener('click', toggleDesktopSidebar);
      document.getElementById('mobileMenuButton')?.addEventListener('click', openMobileSidebar);
      document.getElementById('sidebarBackdrop')?.addEventListener('click', closeMobileSidebar);
      document.getElementById('storeSwitcherButton')?.addEventListener('click', toggleStoreMenu);

      // Order drawer
      document.querySelectorAll('[data-action="open-order"]').forEach(button => {
        button.addEventListener('click', openOrder);
      });
      document.getElementById('drawerOverlay')?.addEventListener('click', closeOrder);
      document.getElementById('closeOrderButton')?.addEventListener('click', closeOrder);
      document.getElementById('markReadyButton')?.addEventListener('click', () => {
        toast('Order marked ready to ship');
      });
      document.getElementById('orderMoreButton')?.addEventListener('click', () => {
        toast('Order actions opened');
      });

      // Dashboard actions
      document.getElementById('viewStoreButton')?.addEventListener('click', () => {
        toast('Storefront preview opened');
      });
      document.getElementById('addProductButton')?.addEventListener('click', () => {
        toast('Product creation flow opened');
      });

      // Chart controls
      document.querySelectorAll('.chart-btn').forEach(button => {
        button.addEventListener('click', () => {
          document.querySelectorAll('.chart-btn').forEach(item => {
            item.classList.remove('bg-white', 'shadow-sm', 'font-semibold');
            item.classList.add('text-slate-500');
          });
          button.classList.add('bg-white', 'shadow-sm', 'font-semibold');
          button.classList.remove('text-slate-500');
          toast('Sales view updated to ' + button.textContent.trim());
        });
      });

      // Profile menus
      document.getElementById('headerProfileButton')?.addEventListener('click', (event) => {
        event.stopPropagation();
        toggleProfileMenu('headerProfileMenu', 'headerProfileButton');
      });

      document.getElementById('sidebarProfileButton')?.addEventListener('click', (event) => {
        event.stopPropagation();
        toggleProfileMenu('sidebarProfileMenu', 'sidebarProfileButton');
      });

      document.querySelectorAll('[data-profile-action]').forEach(button => {
        button.addEventListener('click', () => {
          const action = button.dataset.profileAction;
          toast(action === 'business-dashboard' ? 'Opening Business Dashboard' : 'Sign out selected');
          closeProfileMenus();
        });
      });

      document.addEventListener('click', (event) => {
        if (!event.target.closest('#headerProfileButton, #headerProfileMenu, #sidebarProfileButton, #sidebarProfileMenu')) {
          closeProfileMenus();
        }
      });

      // Generated management-page actions
      document.querySelectorAll('[data-action="generated-action"]').forEach(button => {
        button.addEventListener('click', () => toast(button.dataset.message));
      });

      document.querySelectorAll('[data-action="filter-table"]').forEach(input => {
        input.addEventListener('input', () => filterTable(input));
      });

      document.querySelectorAll('[data-action="status-filter"]').forEach(select => {
        select.addEventListener('change', () => filterTableByStatus(select));
      });

      // Close mobile navigation if viewport becomes desktop.
      window.addEventListener('resize', () => {
        if (window.matchMedia('(min-width: 1024px)').matches) {
          const sidebar = document.getElementById('sidebar');
          const backdrop = document.getElementById('sidebarBackdrop');

          sidebar.classList.remove('-translate-x-full', 'translate-x-0');
          backdrop.classList.add('hidden');
          document.body.classList.remove('overflow-hidden');

          // Restore the current desktop sidebar state after crossing breakpoints.
          document.documentElement.style.setProperty(
            '--sidebar-width',
            sidebar.classList.contains('sidebar-collapsed') ? '76px' : '288px'
          );

          const toggle = document.getElementById('sidebarToggleButton');
          if (toggle) {
            const collapsed = sidebar.classList.contains('sidebar-collapsed');
            toggle.setAttribute('aria-expanded', String(!collapsed));
            toggle.setAttribute('aria-label', collapsed ? 'Expand sidebar' : 'Collapse sidebar');
            toggle.setAttribute('title', collapsed ? 'Expand sidebar' : 'Collapse sidebar');
          }
        }
      });
    }


    // Initialize the tab/page system: dashboard visible, all other pages hidden.
    document.querySelectorAll('.page').forEach(page => {
      if (page.id === 'page-dashboard') {
        page.classList.remove('hidden');
      } else {
        page.classList.add('hidden');
      }
    });

    bindEvents();
    lucide.createIcons();

    // load-time hard reset
    window.addEventListener('load', () => {
      window.scrollTo(0, 0);
      document.documentElement.scrollTop = 0;
      document.body.scrollTop = 0;
    }, {
      once: true
    });
  </script>
</body>

</html>