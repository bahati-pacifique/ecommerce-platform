<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>COCOCE Store Center</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            cococe: {
              50: '#eff6ff',
              100: '#dbeafe',
              500: '#2563eb',
              600: '#1d4ed8',
              700: '#1e40af',
              900: '#172554'
            }
          }
        }
      }
    }
  </script>
  
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    :root {
      --sidebar-width: 288px;
      --color-brand: #ED1B24;
      --color-brand-dark: #C9171F;
      --color-brand-light: #FEE2E3;
      --color-brand-ultralight: #FFF5F5;
      --color-bg-soft: #FDFDFC;
    }

    html {
      scroll-behavior: smooth;
    }

    html,
    body {
      margin: 0;
      min-height: 100%;
    }

    #main {
      min-height: 100vh;
    }

    #content {
      display: block;
      width: 100%;
    }

    .page {
      width: 100%;
    }

    body {
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .nav-item.active {
      background: var(--color-brand-ultralight);
      color: var(--color-brand-dark);
      font-weight: 600;
    }

    .sidebar-collapsed {
      --sidebar-width: 76px;
    }

    #sidebar {
      width: var(--sidebar-width);
      overflow-x: hidden;
    }

    .sidebar-collapsed .nav-label,
    .sidebar-collapsed .section-label,
    .sidebar-collapsed .store-details,
    .sidebar-collapsed .account-details {
      display: none;
    }

    .sidebar-collapsed .nav-item {
      justify-content: center;
    }

    .sidebar-collapsed .store-switcher {
      padding: 10px;
    }

    .sidebar-collapsed .store-switcher>div:last-child {
      display: none;
    }

    .chart-grid {
      background-image: linear-gradient(to right, #e5e7eb 1px, transparent 1px), linear-gradient(to bottom, #e5e7eb 1px, transparent 1px);
      background-size: 12.5% 25%;
    }

    .line {
      fill: none;
      stroke-width: 3;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .fade {
      transition: opacity .2s ease, transform .2s ease;
    }

    .profile-menu {
      transform-origin: top right;
      z-index: 60;
    }

    .profile-menu.open {
      opacity: 1;
      transform: translateY(0) scale(1);
      pointer-events: auto;
    }

    .profile-menu.closed {
      opacity: 0;
      transform: translateY(4px) scale(.98);
      pointer-events: none;
    }




    /* Authoritative dashboard layout */
    #appShell {
      min-height: 100vh !important;
      display: block !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    #sidebar {
      position: fixed !important;
      top: 0 !important;
      bottom: 0 !important;
    }

    #main {
      display: block !important;
      position: relative !important;
      min-height: 100vh !important;
      margin-top: 0 !important;
      padding-top: 0 !important;
      transform: none !important;
    }

    #main>header {
      position: sticky !important;
      top: 0 !important;
      margin: 0 !important;
    }

    #content {
      display: block !important;
      position: relative !important;
      top: auto !important;
      margin: 0 !important;
      padding: 1.5rem !important;
      height: auto !important;
      min-height: 0 !important;
      transform: none !important;
    }

    @media (min-width: 640px) {
      #content {
        padding: 1.5rem !important;
      }
    }

    @media (min-width: 1024px) {
      #content {
        padding: 2rem !important;
      }
    }


    #content>.page:not(.hidden) {
      position: static !important;
      margin: 0 !important;
      padding: 0 !important;
      min-height: 0 !important;
      height: auto !important;
      transform: none !important;
    }
  </style>

  <script>
    // Keep the dashboard's initial viewport at the top; do not restore a stale
    // scroll position from a previous preview/session.
    if ('scrollRestoration' in history) {
      history.scrollRestoration = 'manual';
    }
    window.scrollTo(0, 0);
  </script>

</head>

<body class="bg-[var(--color-bg-soft)] text-slate-900">
  <div id="appShell" class="min-h-screen">

    <!-- Sidebar -->
    <aside id="sidebar" class="fixed inset-y-0 left-0 z-50 flex -translate-x-full flex-col border-r border-slate-200 bg-white transition-[width,transform] duration-300 ease-in-out lg:translate-x-0">
      <div class="flex h-16 min-w-0 items-center justify-between overflow-hidden border-b border-slate-200 px-5">
        <div>
          <div class="text-xl font-extrabold tracking-tight text-slate-950">COCOCE</div>
          <div class="section-label text-[10px] font-bold tracking-[.18em] text-[var(--color-brand)]">STORE CENTER</div>
        </div>
      </div>

      <div class="p-3">
        <button id="storeSwitcherButton" class="store-switcher flex w-full items-center gap-3 rounded-xl border border-slate-200 bg-slate-50 p-3 text-left hover:bg-slate-100">
          <div class="flex h-9 w-9 shrink-0 items-start justify-center rounded-lg bg-[var(--color-brand-light)] text-[var(--color-brand-dark)]">
            <i data-lucide="store" class="h-5 w-5"></i>
          </div>
          <div class="store-details min-w-0 flex-1">
            <div class="text-[10px] font-semibold uppercase tracking-wider text-slate-500">Current store</div>
            <div class="truncate text-sm font-semibold">Bahati Electronics</div>
          </div>
          <i data-lucide="chevrons-up-down" class="h-4 w-4 text-slate-400"></i>
        </button>
        <div id="storeMenu" class="mt-2 hidden rounded-xl border border-slate-200 bg-white p-2 shadow-lg">
          <div class="px-2 py-1.5 text-xs font-semibold uppercase tracking-wider text-slate-400">My Stores</div>
          <button class="flex w-full items-center gap-2 rounded-lg bg-[var(--color-brand-ultralight)] px-3 py-2 text-sm font-medium text-[var(--color-brand-dark)]">
            <i data-lucide="check" class="h-4 w-4"></i> Bahati Electronics
          </button>
          <button class="w-full rounded-lg px-3 py-2 text-left text-sm hover:bg-slate-50">Bahati Accessories</button>
          <button class="w-full rounded-lg px-3 py-2 text-left text-sm hover:bg-slate-50">Bahati Computers</button>
          <div class="my-2 border-t border-slate-100"></div>
          <button class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-sm hover:bg-slate-50"><i data-lucide="plus" class="h-4 w-4"></i>Create New Store</button>
          <button class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-sm hover:bg-slate-50"><i data-lucide="settings-2" class="h-4 w-4"></i>Manage All Stores</button>
        </div>
      </div>

      <nav class="flex-1 overflow-y-auto px-3 pb-4">
        <div class="mb-5">
          <div class="section-label px-3 pb-2 text-[10px] font-bold uppercase tracking-widest text-slate-400">Store</div>
          <button class="nav-item active flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-sm" data-page="dashboard"><i data-lucide="layout-dashboard" class="h-4 w-4"></i><span class="nav-label">Dashboard</span></button>
        </div>

        <div class="mb-5">
          <div class="section-label px-3 pb-2 text-[10px] font-bold uppercase tracking-widest text-slate-400">Catalog</div>
          <button class="nav-item flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-sm text-slate-600 hover:bg-slate-50" data-page="products"><i data-lucide="package" class="h-4 w-4"></i><span class="nav-label">Products</span></button>
          <button class="nav-item flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-sm text-slate-600 hover:bg-slate-50" data-page="categories"><i data-lucide="folder-tree" class="h-4 w-4"></i><span class="nav-label">Categories</span></button>
          <button class="nav-item flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-sm text-slate-600 hover:bg-slate-50" data-page="inventory"><i data-lucide="boxes" class="h-4 w-4"></i><span class="nav-label">Inventory</span></button>
        </div>

        <div class="mb-5">
          <div class="section-label px-3 pb-2 text-[10px] font-bold uppercase tracking-widest text-slate-400">Sales</div>
          <button class="nav-item flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-sm text-slate-600 hover:bg-slate-50" data-page="orders"><i data-lucide="shopping-bag" class="h-4 w-4"></i><span class="nav-label">Orders</span><span class="nav-label ml-auto rounded-full bg-[var(--color-brand-light)] px-2 py-0.5 text-[10px] font-bold text-[var(--color-brand-dark)]">38</span></button>
          <button class="nav-item flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-sm text-slate-600 hover:bg-slate-50" data-page="returns"><i data-lucide="package-open" class="h-4 w-4"></i><span class="nav-label">Returns</span></button>
          <button class="nav-item flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-sm text-slate-600 hover:bg-slate-50" data-page="refunds"><i data-lucide="rotate-ccw" class="h-4 w-4"></i><span class="nav-label">Refunds</span></button>
          <button class="nav-item flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-sm text-slate-600 hover:bg-slate-50" data-page="disputes"><i data-lucide="triangle-alert" class="h-4 w-4"></i><span class="nav-label">Disputes</span></button>
        </div>

        <div class="mb-5">
          <div class="section-label px-3 pb-2 text-[10px] font-bold uppercase tracking-widest text-slate-400">Customer</div>
          <button class="nav-item flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-sm text-slate-600 hover:bg-slate-50" data-page="customers"><i data-lucide="users" class="h-4 w-4"></i><span class="nav-label">Customers</span></button>
          <button class="nav-item flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-sm text-slate-600 hover:bg-slate-50" data-page="reviews"><i data-lucide="star" class="h-4 w-4"></i><span class="nav-label">Reviews</span></button>
        </div>

        <div class="mb-5">
          <div class="section-label px-3 pb-2 text-[10px] font-bold uppercase tracking-widest text-slate-400">Operations</div>
          <button class="nav-item flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-sm text-slate-600 hover:bg-slate-50" data-page="shipping"><i data-lucide="truck" class="h-4 w-4"></i><span class="nav-label">Shipping</span></button>
        </div>

        <div class="mb-5">
          <div class="section-label px-3 pb-2 text-[10px] font-bold uppercase tracking-widest text-slate-400">Growth</div>
          <button class="nav-item flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-sm text-slate-600 hover:bg-slate-50" data-page="marketing"><i data-lucide="megaphone" class="h-4 w-4"></i><span class="nav-label">Marketing</span></button>
        </div>

        <div class="mb-5">
          <div class="section-label px-3 pb-2 text-[10px] font-bold uppercase tracking-widest text-slate-400">Insights</div>
          <button class="nav-item flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-sm text-slate-600 hover:bg-slate-50" data-page="analytics"><i data-lucide="bar-chart-3" class="h-4 w-4"></i><span class="nav-label">Analytics</span></button>
        </div>

        <div class="mb-5">
          <div class="section-label px-3 pb-2 text-[10px] font-bold uppercase tracking-widest text-slate-400">Storefront</div>
          <button class="nav-item flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-sm text-slate-600 hover:bg-slate-50" data-page="storefront"><i data-lucide="store" class="h-4 w-4"></i><span class="nav-label">Storefront</span></button>
        </div>

        <div>
          <div class="section-label px-3 pb-2 text-[10px] font-bold uppercase tracking-widest text-slate-400">Configuration</div>
          <button class="nav-item flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-sm text-slate-600 hover:bg-slate-50" data-page="settings"><i data-lucide="settings" class="h-4 w-4"></i><span class="nav-label">Settings</span></button>
        </div>
      </nav>

      <div class="border-t border-slate-200 p-3">
        <button class="flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left hover:bg-slate-50">
          <i data-lucide="circle-help" class="h-4 w-4 text-slate-500"></i><span class="nav-label text-sm text-slate-600">Help & Support</span>
        </button>
        <div class="relative mt-2">
          <button id="sidebarProfileButton" class="flex w-full items-center gap-3 rounded-xl bg-slate-50 p-3 text-left hover:bg-[var(--color-brand-ultralight)]" aria-expanded="false" aria-controls="sidebarProfileMenu">
            <div class="flex h-9 w-9 shrink-0 items-start justify-center rounded-full bg-slate-900 text-xs font-bold text-white">BN</div>
            <div class="account-details min-w-0 flex-1">
              <div class="text-sm font-semibold">Bahati N.</div>
              <div class="text-xs text-slate-500">Store Owner</div>
            </div>
            <i data-lucide="chevron-up" class="account-details ml-auto h-4 w-4 text-slate-400"></i>
          </button>
          <div id="sidebarProfileMenu" class="profile-menu closed absolute bottom-full left-0 mb-2 w-full rounded-xl border border-slate-200 bg-white p-1.5 shadow-xl">
            <button data-profile-action="business-dashboard" class="flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 hover:bg-[var(--color-brand-ultralight)] hover:text-[var(--color-brand-dark)]">
              <i data-lucide="layout-dashboard" class="h-4 w-4"></i>
              Business Dashboard
            </button>
            <div class="my-1 border-t border-slate-100"></div>
            <button data-profile-action="sign-out" class="flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-rose-600 hover:bg-rose-50">
              <i data-lucide="log-out" class="h-4 w-4"></i>
              Sign out
            </button>
          </div>
        </div>
        <i data-lucide="more-horizontal" class="account-details ml-auto h-4 w-4 text-slate-400"></i>
      </div>
    </aside>

    <div id="sidebarBackdrop" class="fixed inset-0 z-40 hidden bg-slate-950/30 lg:hidden"></div>

    <!-- Main -->
    <div id="main" class="min-h-screen min-w-0 transition-[margin] duration-300 ease-in-out lg:ml-[var(--sidebar-width)]">
      <header class="sticky top-0 z-30 flex h-16 items-center gap-4 border-b border-slate-200 bg-white/95 px-4 sm:px-6 backdrop-blur">
        <button id="sidebarToggleButton" class="hidden rounded-lg p-2 text-slate-500 hover:bg-[var(--color-brand-ultralight)] hover:text-[var(--color-brand-dark)] lg:inline-flex" aria-label="Collapse sidebar" aria-expanded="true" title="Collapse sidebar">
          <i data-lucide="panel-left-close" class="h-5 w-5"></i>
        </button>

        <button id="mobileMenuButton" class="rounded-lg lg:hidden p-2 text-slate-500 hover:bg-[var(--color-brand-ultralight)] lg:hidden" aria-label="Open navigation"><i data-lucide="menu" class="h-5 w-5"></i></button>
        <div class="relative min-w-0 flex-1">
          <i data-lucide="search" class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"></i>
          <input id="globalSearch" class="w-full rounded-lg border border-slate-200 bg-slate-50 py-2 pl-10 pr-4 text-sm outline-none transition focus:border-[var(--color-brand)] focus:bg-white focus:ring-2 focus:ring-[var(--color-brand-light)]" placeholder="Search products, orders, customers..." />
        </div>
        <div class="hidden items-center gap-2 text-xs font-semibold text-emerald-700 sm:flex"><span class="h-2 w-2 rounded-full bg-emerald-500"></span> Store Active</div>
        <button class="relative rounded-lg p-2 text-slate-500 hover:bg-[var(--color-brand-ultralight)]"><i data-lucide="bell" class="h-5 w-5"></i><span class="absolute right-1.5 top-1.5 h-2 w-2 rounded-full bg-red-500"></span></button>
        <button class="rounded-lg p-2 text-slate-500 hover:bg-[var(--color-brand-ultralight)]"><i data-lucide="message-square" class="h-5 w-5"></i></button>
        <button class="rounded-lg p-2 text-slate-500 hover:bg-[var(--color-brand-ultralight)]"><i data-lucide="circle-help" class="h-5 w-5"></i></button>
        <div class="relative shrink-0 hidden sm:block">
          <button id="headerProfileButton" type="button" class="relative z-50 flex items-center gap-2 rounded-lg px-2 py-1.5 text-left hover:bg-slate-50" aria-expanded="false" aria-controls="headerProfileMenu" aria-haspopup="menu">
            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-900 text-xs font-bold text-white">BN</div>
            <div class="min-w-0">
              <div class="text-xs font-semibold">Bahati N.</div>
              <div class="text-[10px] text-slate-500">Store Owner</div>
            </div>
            <i data-lucide="chevron-down" class="h-4 w-4 shrink-0 text-slate-400"></i>
          </button>
          <div id="headerProfileMenu" class="profile-menu closed absolute right-0 top-full z-[60] mt-2 w-52 rounded-xl border border-slate-200 bg-white p-1.5 shadow-xl" role="menu">
            <button type="button" data-profile-action="business-dashboard" class="flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 hover:bg-[var(--color-brand-ultralight)] hover:text-[var(--color-brand-dark)]">
              <i data-lucide="layout-dashboard" class="h-4 w-4"></i>
              Business Dashboard
            </button>
            <div class="my-1 border-t border-slate-100"></div>
            <button type="button" data-profile-action="sign-out" class="flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50">
              <i data-lucide="log-out" class="h-4 w-4"></i>
              Sign out
            </button>
          </div>
        </div>
      </header>

      <main id="content" class="p-4 sm:p-6 lg:p-8">
        <!-- dashboard -->
        <section id="page-dashboard" class="page">
          <div class="mb-6 flex flex-col justify-between gap-4 md:flex-row md:items-end">
            <div>
              <div class="mb-1 text-sm font-medium text-[var(--color-brand)]">Bahati Electronics</div>
              <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">Store Dashboard</h1>
              <p class="mt-1 text-sm text-slate-500">Here's what's happening with your store today.</p>
            </div>
            <div class="flex flex-wrap gap-2">
              <button id="viewStoreButton" class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium shadow-sm hover:bg-slate-50"><i data-lucide="external-link" class="h-4 w-4"></i>View Store</button>
              <button id="addProductButton" class="inline-flex items-center gap-2 rounded-lg bg-[var(--color-brand)] px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-[var(--color-brand-dark)]"><i data-lucide="plus" class="h-4 w-4"></i>Add Product</button>
              <select class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium shadow-sm outline-none">
                <option>Today</option>
                <option>Last 7 Days</option>
                <option>Last 30 Days</option>
                <option>This Year</option>
                <option>Custom Range</option>
              </select>
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
            <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
              <div class="flex items-center justify-between"><span class="text-sm text-slate-500">Sales</span><span class="rounded-lg bg-[var(--color-brand-ultralight)] p-2 text-[var(--color-brand)]"><i data-lucide="banknote" class="h-4 w-4"></i></span></div>
              <div class="mt-4 text-2xl font-bold">$24,580</div>
              <div class="mt-1 text-xs"><span class="font-semibold text-emerald-600">+12.5%</span><span class="ml-1 text-slate-400">vs previous period</span></div>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
              <div class="flex items-center justify-between"><span class="text-sm text-slate-500">Orders</span><span class="rounded-lg bg-violet-50 p-2 text-violet-600"><i data-lucide="shopping-cart" class="h-4 w-4"></i></span></div>
              <div class="mt-4 text-2xl font-bold">1,284</div>
              <div class="mt-1 text-xs"><span class="font-semibold text-emerald-600">+8.2%</span><span class="ml-1 text-slate-400">vs previous period</span></div>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
              <div class="flex items-center justify-between"><span class="text-sm text-slate-500">Customers</span><span class="rounded-lg bg-emerald-50 p-2 text-emerald-600"><i data-lucide="users" class="h-4 w-4"></i></span></div>
              <div class="mt-4 text-2xl font-bold">892</div>
              <div class="mt-1 text-xs"><span class="font-semibold text-emerald-600">+14.4%</span><span class="ml-1 text-slate-400">vs previous period</span></div>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
              <div class="flex items-center justify-between"><span class="text-sm text-slate-500">Products</span><span class="rounded-lg bg-amber-50 p-2 text-amber-600"><i data-lucide="package" class="h-4 w-4"></i></span></div>
              <div class="mt-4 text-2xl font-bold">246</div>
              <div class="mt-1 text-xs text-slate-500">12 low in stock</div>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
              <div class="flex items-center justify-between"><span class="text-sm text-slate-500">Pending Orders</span><span class="rounded-lg bg-orange-50 p-2 text-orange-600"><i data-lucide="clock-3" class="h-4 w-4"></i></span></div>
              <div class="mt-4 text-2xl font-bold">38</div>
              <div class="mt-1 text-xs text-orange-600">Require attention</div>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
              <div class="flex items-center justify-between"><span class="text-sm text-slate-500">Store Rating</span><span class="rounded-lg bg-yellow-50 p-2 text-yellow-600"><i data-lucide="star" class="h-4 w-4"></i></span></div>
              <div class="mt-4 text-2xl font-bold">4.8 / 5</div>
              <div class="mt-1 text-sm tracking-wide text-yellow-500">★★★★★</div>
            </div>
          </div>

