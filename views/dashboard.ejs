            <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-lg max-h-[90vh] overflow-y-auto animate-slide-down">
              <div class="sticky top-0 bg-white border-b border-gray-100 px-6 py-4 flex items-center justify-between z-10">
                <h3 id="attributeFormModalTitle" class="text-lg font-bold text-gray-900">Create New Attribute</h3>
                <button id="closeAttributeFormModal" class="text-gray-400 hover:text-gray-600 transition">
                  <i class="fas fa-times text-xl"></i>
                </button>
              </div>

              <form id="attributeForm" class="p-6 space-y-4">
                <input type="hidden" id="attributeEditId" value="">
                <div>
                  <label for="attributeTitle" class="block text-sm font-medium text-gray-700 mb-1.5">
                    Title <span class="text-brand">*</span>
                  </label>
                  <input type="text" id="attributeTitle" placeholder="e.g., Color" class="form-input w-full px-4 py-2.5 rounded-xl border border-gray-200 text-gray-900 placeholder-gray-400 transition" required>
                </div>

                <div>
                  <label for="attributeDescription" class="block text-sm font-medium text-gray-700 mb-1.5">
                    Description
                  </label>
                  <textarea id="attributeDescription" rows="3" placeholder="Brief description of the attribute..." class="form-input w-full px-4 py-2.5 rounded-xl border border-gray-200 text-gray-900 placeholder-gray-400 transition resize-y"></textarea>
                </div>

                <div>
                  <label for="attributeDisplayOrder" class="block text-sm font-medium text-gray-700 mb-1.5">
                    Display Order
                  </label>
                  <input type="number" id="attributeDisplayOrder" value="0" class="form-input w-full px-4 py-2.5 rounded-xl border border-gray-200 text-gray-900 transition">
                  <p class="text-xs text-gray-400 mt-1">Higher number = displayed later in lists</p>
                </div>

                <div>
                  <label for="attributeStatus" class="block text-sm font-medium text-gray-700 mb-1.5">
                    Status
                  </label>
                  <select id="attributeStatus" class="form-input w-full px-4 py-2.5 rounded-xl border border-gray-200 text-gray-700 transition">
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                    <option value="disabled">Disabled</option>
                    <option value="deleted">Deleted</option>
                  </select>
                </div>

                <div class="flex items-center justify-end gap-3 pt-2">
                  <button type="button" class="cancel-create-attribute px-6 py-2.5 rounded-xl border border-gray-200 text-gray-600 hover:bg-gray-50 transition font-medium">
                    Cancel
                  </button>
                  <button type="submit" id="attributeFormSubmitBtn" class="bg-brand hover:bg-brand-dark px-6 py-2.5 rounded-xl text-white font-medium flex items-center gap-2">
                    <i class="fas fa-save"></i> <span id="attributeSubmitBtnText">Create Attribute</span>
                  </button>
                </div>
              </form>
            </div>
          </div>

