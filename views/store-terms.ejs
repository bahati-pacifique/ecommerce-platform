        <div class="flex items-center gap-4">
            <button
                type="button"
                aria-label="Account"
                class="flex h-9 w-9 items-center justify-center rounded-full bg-gray-100 text-gray-500 transition hover:bg-gray-200 hover:text-brand">
                <i class="fas fa-user text-sm"></i>
            </button>
        </div>

    </nav>

</header>


<section class="border-b border-gray-200 bg-white">

    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">

        <div class="mb-6 flex items-center gap-2 text-sm text-gray-500">

            <a href="/store/docs" class="transition hover:text-brand" target="_blank">
                Docs
            </a>
            <i class="fas fa-chevron-right text-[10px] text-gray-400"></i>
            <span class="text-gray-700">
                Store Terms
            </span>

        </div>

        <div class="max-w-3xl">

            <h1 class="text-3xl font-bold tracking-tight text-gray-950 sm:text-4xl lg:text-5xl">
                Store Terms & Conditions
            </h1>

            <p class="mt-5 max-w-2xl text-base leading-7 text-gray-600 sm:text-lg">
                These terms explain the rules and responsibilities that apply to vendors
                operating stores on the <span class="text-brand font-bold">COCOCE Marketplace</span>.
            </p>

            <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-gray-500">

                <div class="flex items-center gap-2">

                    <i class="far fa-calendar text-gray-400"></i>

                    <span>
                        Last updated
                        <strong class="font-medium text-gray-700">
                            September 4, 2026
                        </strong>
                    </span>

                </div>

                <div class="flex items-center gap-2">

                    <i class="far fa-clock text-gray-400"></i>

                    <span>
                        Estimated reading time: 10 minutes
                    </span>

                </div>

            </div>

        </div>

    </div>

</section>

<main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">

    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[240px_minmax(0,1fr)]">

