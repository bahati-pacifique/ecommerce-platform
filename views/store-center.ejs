  console.log(protocal, domainName)
</script>

<body class="bg-slate-50 text-slate-900">
  <div id="appShell" class="min-h-screen">

    <%- include('partials/sidebar', { store, user, title }) %>

    <div id="sidebarBackdrop" class="fixed inset-0 z-40 hidden bg-slate-950/30 lg:hidden"></div>

    <div id="main" class="min-h-screen min-w-0 transition-[margin] duration-300 ease-in-out lg:ml-[var(--sidebar-width)]">
      <%- include('partials/header',  { store, user }) %>
      <main id="content" class="p-4 sm:p-6 lg:p-8">
        <%- body %>
      </main>
    </div>
  </div>

  <%- include('partials/order-drawer') %>
  <div id="toast" class="fixed bottom-5 right-5 z-[80] hidden rounded-lg bg-slate-900 px-4 py-3 text-sm font-medium text-white shadow-xl"></div>

  <script type="module" src="/scripts/shell.js"></script>
  <% if (typeof pageScript !== 'undefined' && pageScript) { %>
  <script type="module" src="<%= pageScript %>"></script>
  <% } %>

  <script src="/scripts/components/notification.js"></script>
  <script src="/scripts/components/main-snackbar.js"></script>
</body>

</html>