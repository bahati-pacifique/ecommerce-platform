  <link rel="stylesheet" href="/styles/components/notification.css">
  <link rel="stylesheet" href="/styles/components/main-snackbar.css">
  <link rel="stylesheet" href="/styles/components/loaders.css">
  <link rel="stylesheet" href="/styles/components/animations.css">
  <link rel="stylesheet" href="/styles/main.css">

  <script>
    const username = '<%=locals.user.username%>';
  </script>

  <style>
    :root {
      --sidebar-width: 288px;
      --color-brand: #ED1B24;
      --color-brand-dark: #C9171F;
      --color-brand-light: #FEE2E3;
      --color-brand-ultralight: #FFF5F5;
    }

    html,
    body {
      margin: 0;
      min-height: 100%;
      font-family: 'Inter', system-ui, sans-serif;
    }

    #sidebar {
      width: var(--sidebar-width);
      overflow-x: hidden;
    }

    .sidebar-collapsed {
      --sidebar-width: 76px;
    }

    .sidebar-collapsed .nav-label,
    .sidebar-collapsed .section-label,
    .sidebar-collapsed .store-details,
    .sidebar-collapsed .account-details {
      display: none;
    }

    .sidebar-collapsed .nav-item {
      justify-content: center;
    }

    .sidebar-collapsed .store-switcher {
      padding: 10px;
    }

    .sidebar-collapsed .store-switcher>div:last-child {
      display: none;
    }

    .nav-item.active {
      background: var(--color-brand-ultralight);
      color: var(--color-brand-dark);
      font-weight: 600;
    }

    .profile-menu {
      transform-origin: top right;
      z-index: 60;
      transition: opacity .15s ease, transform .15s ease;
    }

    .profile-menu.open {
      opacity: 1;
      transform: translateY(0) scale(1);
      pointer-events: auto;
    }

    .profile-menu.closed {
      opacity: 0;
      transform: translateY(4px) scale(.98);
      pointer-events: none;
    }

    .chart-grid {
      background-image: linear-gradient(to right, #e5e7eb 1px, transparent 1px),
        linear-gradient(to bottom, #e5e7eb 1px, transparent 1px);
      background-size: 12.5% 25%;
    }

    .line {
      fill: none;
      stroke-width: 3;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    /* WELCOME PARTIALS */
    .welcome-panel {
      height: 80vh;
      width: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
      flex-direction: column;
      padding: 1rem 2.5px;
      background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
    }

    .welcome-inner {
      max-width: 720px;
      width: 100%;
      text-align: center;
    }

    .welcome-eyebrow {
      margin: 0 0 8px;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #6b7280;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .welcome-title {
      margin: 0 0 12px;
      font-size: 32px;
      line-height: 1.25;
      font-weight: 700;
      color: #111827;
    }

    .store-name {
      color: var(--color-brand);
      font-weight: 900;
    }

    .welcome-slogan {
      margin: 0 0 24px;
      font-size: 16px;
      line-height: 1.6;
      color: #4b5563;
    }

    .welcome-nav {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 12px;
      font-size: 14px;
    }

    .welcome-nav-link {
      color: #374151;
      text-decoration: none;
      padding: 6px 10px;
      border-radius: 6px;
      transition: background-color 0.15s ease, color 0.15s ease;
    }

    .welcome-nav-link:hover,
    .welcome-nav-link:focus-visible {
      background-color: var(--color-brand-light);
      color: var(--color-brand);
      outline: none;
    }

    .welcome-nav-divider {
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background-color: #d1d5db;
    }

    @media (max-width: 480px) {
      .welcome-title {
        font-size: 24px;
      }

      .welcome-slogan {
        font-size: 15px;
      }

      .welcome-nav-divider {
        display: none;
      }

      .welcome-nav {
        flex-direction: column;
        gap: 6px;
      }
    }
  </style>
</head>
<script>
  const protocal = "<%-locals.protocal%>";
  const domainName = "<%-locals.domainName%>";
  const storeId = "<%-locals.store.id%>";
</script>

<body class="bg-slate-50 text-slate-900">
  <div id="appShell" class="min-h-screen">

    <%- include('store-partials/sidebar', { store, user, title }) %>

    <div id="sidebarBackdrop" class="fixed inset-0 z-40 hidden bg-slate-950/30 lg:hidden"></div>

    <div id="main" class="min-h-screen min-w-0 transition-[margin] duration-300 ease-in-out lg:ml-[var(--sidebar-width)]">
      <%- include('store-partials/header',  { store, user }) %>
      <main id="content" class="p-4 sm:p-6 lg:p-8">
        <%- body %>
      </main>
    </div>
  </div>

  <%- include('store-partials/order-drawer') %>
  <div id="toast" class="fixed bottom-5 right-5 z-[80] hidden rounded-lg bg-slate-900 px-4 py-3 text-sm font-medium text-white shadow-xl"></div>

  <script type="module" src="/scripts/shell.js"></script>
  
  <% if (typeof pageScript !== 'undefined' && pageScript) { %>
  <script type="module" src="<%= pageScript %>"></script>
  <% } %>

  <script src="/scripts/components/notification.js"></script>
  <script src="/scripts/components/main-snackbar.js"></script>
  
</body>

</html>