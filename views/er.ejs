<body class="min-h-screen overflow-x-hidden bg-slate-50 font-[Inter,system-ui,-apple-system,BlinkMacSystemFont,Segoe_UI,sans-serif] text-slate-900 flex flex-col">

  <nav class="sticky top-0 z-20 border-b border-slate-200/80 bg-white/90 backdrop-blur-xl">
    <div class="mx-auto flex min-h-16 w-[calc(100%-24px)] max-w-[1120px] items-center justify-between gap-4 sm:min-h-[72px] sm:w-[calc(100%-32px)]">
