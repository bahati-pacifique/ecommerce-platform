<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>COCOCE — Something Went Wrong</title>
  <!-- Tailwind CSS + Inter font -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;400;500;600;700;800&display=swap');

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background: #FDFDFC;
      font-family: 'Inter', sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Animated background shapes */
    .bg-shape {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      opacity: 0.08;
      pointer-events: none;
    }

    /* Error icon animation */
    .error-icon-wrapper {
      position: relative;
      display: inline-block;
    }

    .error-icon-wrapper .pulse-ring {
      position: absolute;
      inset: -15px;
      border-radius: 50%;
      border: 2px solid rgba(237, 27, 36, 0.15);
      animation: pulseRing 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    .error-icon-wrapper .pulse-ring:nth-child(2) {
      animation-delay: 0.5s;
      inset: -30px;
      border-color: rgba(237, 27, 36, 0.08);
    }

    @keyframes pulseRing {
      0% {
        transform: scale(1);
        opacity: 0.8;
      }

      50% {
        transform: scale(1.1);
        opacity: 0.3;
      }

      100% {
        transform: scale(1);
        opacity: 0.8;
      }
    }

    /* Error code styling */
    .error-code {
      font-size: clamp(80px, 15vw, 140px);
      font-weight: 800;
      line-height: 1;
      letter-spacing: -0.04em;
      background: linear-gradient(135deg, #ED1B24 0%, #C9171F 50%, #ED1B24 100%);
      background-size: 200% 200%;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: shimmer 3s ease-in-out infinite;
      background-clip: text;
    }

    @keyframes shimmer {

      0%,
      100% {
        background-position: 0% 50%;
      }

      50% {
        background-position: 100% 50%;
      }
    }

    /* Action cards */
    .action-card {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      border: 1px solid #e5e7eb;
      background: white;
    }

    .action-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.06);
      border-color: rgba(237, 27, 36, 0.2);
    }

    .action-card:active {
      transform: scale(0.96);
    }

    /* Primary button */
    .btn-primary {
      background: #ED1B24;
      transition: all 0.3s ease;
    }

    .btn-primary:hover {
      background: #C9171F;
      transform: translateY(-2px);
      box-shadow: 0 8px 30px rgba(237, 27, 36, 0.3);
    }

    .btn-primary:active {
      transform: scale(0.96);
    }

    .btn-outline {
      border: 2px solid #e5e7eb;
      transition: all 0.3s ease;
    }

    .btn-outline:hover {
      border-color: #ED1B24;
      color: #ED1B24;
      background: #FFF5F5;
      transform: translateY(-2px);
    }

    /* Status badge */
    .error-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 16px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      background: #FEE2E3;
      color: #ED1B24;
      border: 1px solid rgba(237, 27, 36, 0.15);
    }

    /* Toast-like error details */
    .error-details {
      background: #FFF5F5;
      border: 1px solid rgba(237, 27, 36, 0.1);
      border-radius: 12px;
      padding: 16px 20px;
      max-width: 500px;
      margin: 0 auto;
    }

    .error-details code {
      font-family: 'Courier New', monospace;
      font-size: 13px;
      color: #C9171F;
      word-break: break-all;
    }

    /* Custom scrollbar */
    ::-webkit-scrollbar {
      width: 5px;
    }

    ::-webkit-scrollbar-track {
      background: #f1f1f1;
    }

    ::-webkit-scrollbar-thumb {
      background: #ED1B24;
      border-radius: 10px;
    }
  </style>
</head>

<body>

  <!-- Minimal Navigation -->
  <nav class="px-6 md:px-10 py-4 border-b border-gray-100 bg-white/80 backdrop-blur-sm">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <a href="/" class="relative inline-block group">
        <span class="text-2xl font-black tracking-tighter text-brand">COCOCE</span>
        <span class="absolute -top-2 -right-6 bg-brand/10 text-brand text-[8px] font-bold px-1.5 py-0.5 rounded-full border border-brand/20">ERROR</span>
      </a>
      <span class="error-badge text-xs">
        <span class="w-1.5 h-1.5 bg-brand rounded-full animate-pulse"></span>
        Error Report
      </span>
    </div>
  </nav>

  <!-- Main Content -->
  <main class="flex-1 flex items-center justify-center px-6 py-12 relative overflow-hidden">

    <!-- Animated background shapes -->
    <div class="bg-shape w-72 h-72 bg-brand top-[-10%] left-[-5%]"></div>
    <div class="bg-shape w-96 h-96 bg-brand/50 bottom-[-10%] right-[-5%]" style="animation-delay: 2s;"></div>
    <div class="bg-shape w-48 h-48 bg-brand-light top-1/2 left-1/3" style="animation-delay: 4s;"></div>

    <div class="w-full max-w-3xl text-center relative z-10">

      <!-- Error Icon -->
      <div class="error-icon-wrapper mb-6">
        <div class="pulse-ring"></div>
        <div class="pulse-ring"></div>
        <div class="w-24 h-24 bg-brand-light rounded-full flex items-center justify-center mx-auto">
          <i class="fas fa-exclamation-triangle text-4xl text-brand"></i>
        </div>
      </div>

      <!-- Error Code -->
      <div class="error-code" id="errorCode">500</div>

      <!-- Error Title -->
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3" id="errorTitle">
        Something went wrong
      </h1>

      <!-- Error Description -->
      <p class="text-gray-500 text-base md:text-lg max-w-2xl mx-auto leading-relaxed" id="errorMessage">
        We're sorry, but an unexpected error occurred while processing your request.
        Our team has been notified and is working on a fix.
      </p>

      <!-- Error Details (for developers/debugging) -->
      <div class="error-details mt-4 text-left">
        <div class="flex items-start gap-3">
          <i class="fas fa-code text-brand mt-0.5"></i>
          <div>
            <p class="text-xs font-semibold text-gray-700">Error Details</p>
            <code id="errorDetail" class="text-xs text-gray-600">Error: Something went wrong. Please try again later.</code>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-4 mt-8">
        <a href="/" class="btn-primary px-6 py-3 rounded-xl text-white font-semibold flex items-center gap-2">
          <i class="fas fa-home"></i>
          Return Home
        </a>
        <button onclick="window.location.reload()" class="btn-outline px-6 py-3 rounded-xl text-gray-700 font-semibold flex items-center gap-2 bg-white">
          <i class="fas fa-sync-alt"></i>
          Try Again
        </button>
        <a href="/support" class="btn-outline px-6 py-3 rounded-xl text-gray-700 font-semibold flex items-center gap-2 bg-white">
          <i class="fas fa-headset"></i>
          Contact Support
        </a>
      </div>

      <!-- Quick Links -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 max-w-2xl mx-auto mt-8">
        <a href="/dashboard" class="action-card flex flex-col items-center gap-1 p-3 rounded-xl shadow-sm">
          <span class="text-xl">📊</span>
          <span class="text-xs font-medium text-gray-700">Dashboard</span>
        </a>
        <a href="/products" class="action-card flex flex-col items-center gap-1 p-3 rounded-xl shadow-sm">
          <span class="text-xl">📦</span>
          <span class="text-xs font-medium text-gray-700">Products</span>
        </a>
        <a href="/orders" class="action-card flex flex-col items-center gap-1 p-3 rounded-xl shadow-sm">
          <span class="text-xl">🛒</span>
          <span class="text-xs font-medium text-gray-700">Orders</span>
        </a>
        <a href="/support" class="action-card flex flex-col items-center gap-1 p-3 rounded-xl shadow-sm">
          <span class="text-xl">💬</span>
          <span class="text-xs font-medium text-gray-700">Support</span>
        </a>
      </div>

      <!-- Support Note -->
      <p class="text-xs text-gray-400 mt-8">
        <i class="fas fa-shield-alt mr-1"></i>
        Error reference: <span id="errorRef" class="font-mono">ERR-2026-001</span>
        · If this issue persists, please contact our support team.
      </p>
    </div>
  </main>

  <!-- Footer -->
  <footer class="py-4 px-6 bg-white border-t border-gray-100">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-3">
      <span class="text-xs text-gray-400">© 2026 COCOCE — Error Page</span>
      <div class="flex gap-6 text-xs text-gray-400">
        <a href="#" class="hover:text-brand transition">Privacy</a>
        <a href="#" class="hover:text-brand transition">Terms</a>
        <a href="#" class="hover:text-brand transition">Support</a>
        <a href="#" class="hover:text-brand transition">Status</a>
      </div>
    </div>
  </footer>

  <script>
    // ============================================================
    // ERROR PAGE CONFIGURATION
    // ============================================================

    // Configuration object - customize these values
    const errorConfig = {
      // Default values (used if URL params not provided)
      defaultCode: '500',
      defaultTitle: 'Something went wrong',
      defaultMessage: "We're sorry, but an unexpected error occurred while processing your request. Our team has been notified and is working on a fix.",
      defaultDetail: 'Error: Something went wrong. Please try again later.',

      // Error code mapping for human-friendly messages
      errorMap: {
        '400': {
          title: 'Bad Request',
          message: 'The request could not be understood by the server. Please check your input and try again.'
        },
        '401': {
          title: 'Unauthorized',
          message: 'You need to be authenticated to access this resource. Please log in and try again.'
        },
        '403': {
          title: 'Forbidden',
          message: 'You do not have permission to access this resource. Please contact your administrator.'
        },
        '404': {
          title: 'Not Found',
          message: 'The resource you are looking for could not be found on our servers.'
        },
        '405': {
          title: 'Method Not Allowed',
          message: 'The HTTP method used is not allowed for this endpoint.'
        },
        '408': {
          title: 'Request Timeout',
          message: 'The request took too long to process. Please try again.'
        },
        '429': {
          title: 'Too Many Requests',
          message: 'You have made too many requests. Please slow down and try again later.'
        },
        '500': {
          title: 'Internal Server Error',
          message: 'Something went wrong on our end. Our team has been notified and is working on a fix.'
        },
        '502': {
          title: 'Bad Gateway',
          message: 'The server received an invalid response from an upstream server. Please try again later.'
        },
        '503': {
          title: 'Service Unavailable',
          message: 'The service is temporarily unavailable. Please try again later.'
        },
        '504': {
          title: 'Gateway Timeout',
          message: 'The upstream server took too long to respond. Please try again later.'
        }
      },

      // Custom error messages for specific scenarios
      customMessages: {
        'database': 'A database error occurred. Please try again later.',
        'validation': 'The data you provided is invalid. Please check your input.',
        'payment': 'There was an issue processing your payment. Please try again or use a different payment method.',
        'permission': 'You do not have the necessary permissions to perform this action.',
        'network': 'A network error occurred. Please check your connection and try again.'
      }
    };

    // ============================================================
    // ERROR PAGE LOGIC
    // ============================================================

    function getQueryParam(param) {
      const urlParams = new URLSearchParams(window.location.search);
      return urlParams.get(param);
    }

    function generateErrorRef() {
      const timestamp = Date.now().toString(36).toUpperCase();
      const random = Math.random().toString(36).substring(2, 6).toUpperCase();
      return `ERR-${timestamp.slice(0,4)}-${random}`;
    }

    function initErrorPage() {
      // Get error parameters from URL
      const code = getQueryParam('code') || errorConfig.defaultCode;
      const type = getQueryParam('type') || '';
      const detail = getQueryParam('detail') || errorConfig.defaultDetail;
      const ref = getQueryParam('ref') || generateErrorRef();

      // Get the error configuration for this code
      const errorInfo = errorConfig.errorMap[code] || {
        title: errorConfig.defaultTitle,
        message: errorConfig.defaultMessage
      };

      // Check if there's a custom message for the error type
      let message = errorInfo.message;
      if (type && errorConfig.customMessages[type]) {
        message = errorConfig.customMessages[type];
      }

      // Update the DOM
      document.getElementById('errorCode').textContent = code;
      document.getElementById('errorTitle').textContent = errorInfo.title;
      document.getElementById('errorMessage').textContent = message;
      document.getElementById('errorDetail').textContent = detail;
      document.getElementById('errorRef').textContent = ref;

      // Update page title
      document.title = `COCOCE — ${errorInfo.title}`;

      // Add color based on error code
      const isServerError = code.startsWith('5');
      const isClientError = code.startsWith('4');

      if (isServerError) {
        document.querySelector('.error-icon-wrapper .fa-exclamation-triangle').className = 'fas fa-server text-4xl text-brand';
      } else if (isClientError) {
        document.querySelector('.error-icon-wrapper .fa-exclamation-triangle').className = 'fas fa-user-slash text-4xl text-brand';
      }

      console.log('📋 Error Page Initialized:');
      console.log(`  Code: ${code}`);
      console.log(`  Title: ${errorInfo.title}`);
      console.log(`  Type: ${type || 'generic'}`);
      console.log(`  Reference: ${ref}`);
    }

    // ============================================================
    // INTERACTIONS
    // ============================================================

    document.addEventListener('DOMContentLoaded', initErrorPage);

    // Action card clicks
    document.querySelectorAll('.action-card').forEach(card => {
      card.addEventListener('click', function(e) {
        e.preventDefault();
        const text = this.querySelector('span:last-child')?.textContent || 'Action';
        // In production, this would navigate to the actual page
        console.log(`🔗 Navigating to: ${text}`);
        // window.location.href = this.getAttribute('href');
      });
    });

    // Footer links
    document.querySelectorAll('footer a').forEach(link => {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        const text = this.textContent.trim();
        console.log(`📄 Navigating to: ${text}`);
        // window.location.href = this.getAttribute('href');
      });
    });

    // ============================================================
    // DEMO: TEST DIFFERENT ERRORS (Remove in production)
    // ============================================================

    console.log('💡 To test different errors, add query params:');
    console.log('  ?code=404');
    console.log('  ?code=403&type=permission');
    console.log('  ?code=500&detail=Database connection failed');
    console.log('  ?code=401&type=authentication');

    // Uncomment to test different error codes by clicking (dev only)
    // document.addEventListener('keydown', function(e) {
    //     if (e.key === '1') window.location.search = '?code=404';
    //     if (e.key === '2') window.location.search = '?code=403&type=permission';
    //     if (e.key === '3') window.location.search = '?code=500';
    //     if (e.key === '4') window.location.search = '?code=401';
    // });
    // console.log('⌨️ Press 1-4 to test different error codes (dev only)');
  </script>

</body>

</html>