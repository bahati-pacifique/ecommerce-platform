<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>COCOCE — Frequently Asked Questions</title>
  <meta name="description" content="COCOCE FAQ — Find answers to common questions about orders, business, admin, and more. Search, browse, and ask your own questions.">
  <link rel="icon" href="/favicon.ico" type="image/x-icon">

  <meta property="og:image" content="https://cdn.cococe.rw/branding/brand/logos/cococe.png">
  <meta property="og:url" content="https://www.cococe.rw">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Laptops, Printers, Accessories, Game consoles, Electronics, and much more, cococe, your wish our priority">
  <meta property="og:description" content="COCOCE Kigali Rwanda, Laptops, Desktops, Computer accessories, Smart tv, projectors, discover what you want about digital assets near you at Kigali">
  <meta property="og:logo" content="https://cdn.cococe.rw/branding/brand/logos/cococe.png" />
  <meta name="twitter:card" content="https://cdn.cococe.rw/branding/brand/logos/cococe.png">
  <meta property="twitter:domain" content="https://cococe.rw">
  <meta property="twitter:url" content="https://cococe.rw">
  <meta name="twitter:title" content="Laptops, Printers, Accessories, Game consoles, Electronics, and much more, cococe, your wish our priority">
  <meta name="twitter:description" content="COCOCE Kigali Rwanda, Laptops, Desktops, Computer accessories, Smart tv, projectors, discover what you want about digital assets near you at Kigali">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>
  <link rel="stylesheet" href="/styles/main.css">
  <link rel="stylesheet" href="/styles/faqs.css">
</head>

<body>

  <header class="sticky top-0 z-40 border-b border-ink-200/70 bg-white/85 backdrop-blur no-print">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between gap-3">
      <a href="<%= locals.protocal %><%= locals.domainName %>" class="flex items-center gap-2 flex-shrink-0">
        <img src="/images/logos/cococe.png" alt="COCOCE" class="h-12">
      </a>
      <nav class="flex items-center gap-2">
        <%if (!locals.user) {%>
        <a href="<%= locals.protocal %>auth.<%= locals.domainName %>" class="flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-medium text-ink-700 hover:bg-ink-100 transition">
          Sign in <i data-lucide="log-in" class="w-4 h-4"></i>
        </a>
        <%} else {%>
        <span class="text-sm text-brand font-bold border-r pr-3 border-slate-300">Hi <%-locals.user?.username || 'There!'%></span>
        <form action="<%=locals.protocal%>auth.<%=locals.domainName%>/signout" method="POST" class="flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-medium text-ink-700 hover:bg-ink-100 transition">
          <input type="hidden" name="userAccount" value="<=locals.user.userAccount%>">
          <input type="hidden" value="<%=locals.protocal%><%=locals.domainName%>" name="host">
          <button type="submit" class="flex items-center gap-2">
            <span>
              Sign out
            </span>
            <span class="icon">
              <i data-lucide="LogOut" class="w-4 h-4"></i>
            </span>
          </button>
        </form>
        <%}%>
      </nav>
    </div>
  </header>

  <section class="max-w-5xl mx-auto px-4 sm:px-6 pt-8 sm:pt-12">
    <div class="max-w-3xl">
      <p class="text-xs font-semibold uppercase tracking-wider text-brand">Frequently Asked Questions</p>
      <h1 class="mt-1 text-3xl sm:text-4xl font-bold tracking-tight text-ink-900">
        How can we help you today?
      </h1>
      <p class="mt-3 text-base text-ink-500 leading-relaxed">
        Browse answers to common questions about orders, business, administration, and more.
        Can't find what you're looking for? Ask us directly below.
      </p>
    </div>
  </section>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 sm:py-12 grid lg:grid-cols-[220px_1fr] gap-8">

    <aside class="hidden lg:block no-print">
      <nav class="sticky top-20 text-sm" aria-label="On this page">
        <p class="text-[11px] uppercase tracking-wider font-semibold text-ink-400 mb-3">Browse by category</p>
        <ul class="space-y-0.5" id="categoryNav">
          <li><a href="#" data-category="all" class="category-link block border-l-2 border-brand pl-3 py-1.5 text-brand font-semibold transition">All questions</a></li>
          <li><a href="#" data-category="order" class="category-link block border-l-2 border-transparent pl-3 py-1.5 text-ink-500 hover:text-ink-900 transition">Orders</a></li>
          <li><a href="#" data-category="business" class="category-link block border-l-2 border-transparent pl-3 py-1.5 text-ink-500 hover:text-ink-900 transition">Business</a></li>
          <li><a href="#" data-category="admin" class="category-link block border-l-2 border-transparent pl-3 py-1.5 text-ink-500 hover:text-ink-900 transition">Administration</a></li>
          <li><a href="#" data-category="account" class="category-link block border-l-2 border-transparent pl-3 py-1.5 text-ink-500 hover:text-ink-900 transition">Account</a></li>
          <li><a href="#" data-category="payment" class="category-link block border-l-2 border-transparent pl-3 py-1.5 text-ink-500 hover:text-ink-900 transition">Payments</a></li>
        </ul>
      </nav>
    </aside>

    <article class="min-w-0">

      <div class="relative mb-6">
        <i data-lucide="search" class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4.5 h-4.5 text-ink-400 pointer-events-none" style="width:18px;height:18px;"></i>
        <input type="text" id="faqSearch" class="search-input" placeholder="Search questions by title, category, or keyword..." autocomplete="off" />
      </div>

      <div id="faqList" class="space-y-3">
      </div>

      <div id="faqEmpty" class="hidden text-center py-16">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-ink-100 mb-4">
          <i data-lucide="search-x" class="w-7 h-7 text-ink-400"></i>
        </div>
        <p class="text-ink-500 font-medium">No questions found</p>
        <p class="text-sm text-ink-400 mt-1">Try a different search term or browse another category.</p>
      </div>

      <div id="pagination" class="mt-8 flex flex-wrap items-center justify-between gap-4 no-print">
        <p class="text-xs text-ink-400" id="pageInfo"></p>
        <div class="flex items-center gap-2" id="pageControls"></div>
      </div>

      <section class="mt-12 pt-8 border-t border-ink-200">
        <div class="max-w-2xl">
          <h2 class="text-xl font-bold text-ink-900 mb-1">Still have a question?</h2>
          <p class="text-sm text-ink-500 mb-5">
            Send your question directly to our team. We'll review it and get back to you as soon as possible.
          </p>

          <form id="askForm" class="flex flex-col sm:flex-row gap-3">
            <input type="text" id="askInput" class="ask-input flex-1" placeholder="Type your question here..." required autocomplete="off" />
            <button type="submit" class="btn-brand" id="askBtn">
              <i data-lucide="send" class="w-4 h-4"></i>
              Send question
            </button>
          </form>

          <p id="askStatus" class="mt-3 text-xs text-ink-400 hidden"></p>
        </div>
      </section>

    </article>
  </div>

  <footer class="border-t border-ink-200 bg-white/60 no-print">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-ink-400">
      <span>© 2026 <span class="text-brand font-extrabold">COCOCE</span> — Frequently Asked Questions</span>
      <div class="flex flex-wrap gap-x-6 gap-y-2 justify-center">
        <a href="/docs/cookie-terms" class="hover:text-brand transition">Cookies</a>
        <a href="mailto:support@cococe.rw" class="hover:text-brand transition">Support</a>
      </div>
    </div>
  </footer>

  <script>
    lucide.createIcons();
  </script>

  <script src="/scripts/faqs.js"></script>

</body>

</html>