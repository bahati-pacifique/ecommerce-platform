<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Register Product — COCOCE</title>
  <link rel="icon" href="/favicon.ico" type="image/x-icon">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>

  <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>

  <link rel="stylesheet" href="/styles/main.css">
  <link rel="stylesheet" href="/styles/p-cataloging.css">

  <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.11.0/axios.min.js" integrity="sha512-h9644v03pHqrIHThkvXhB2PJ8zf5E9IyVnrSfZg8Yj8k4RsO4zldcQc4Bi9iVLUCCsqNY0b4WXVV4UB+wbWENA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

  <script>
    window.__APP__ = {
      protocal: "<%= locals.protocal || 'https://' %>",
      domainName: "<%= locals.domainName || 'cococe.rw' %>",
      vendorId: "<%= (locals.user && locals.user.vendor && locals.user.vendor.id) || '' %>",
      draftId: "<%= (locals.draft && locals.draft.id) || '' %>",
      user: <%- JSON.stringify(locals.user || null) %>
    };
  </script>
  <script>
    const CFG = window.__APP__ || {};
    const API_BASE = `${CFG.protocal || location.protocol + '//'}api.${CFG.domainName || location.hostname}`;
    const username = "<%-locals.user.username%>";
  </script>

</head>

<body>


  <header class="bg-white border-b border-ink-200 sticky top-0 z-40">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
      <a href="/dashboard" class="flex items-center gap-2">
        <img src="/images/logos/business.png" alt="COCOCE" class="h-7">
      </a>
      <div class="flex items-center gap-3">
        <span class="text-xs text-ink-400 hidden sm:inline" id="draftIndicator"></span>
        <a href="/dashboard" class="text-xs font-medium text-ink-500 hover:text-ink-900 transition flex items-center gap-1.5">
          <i data-lucide="x" class="w-4 h-4"></i>
          Exit
        </a>
      </div>
    </div>
  </header>

  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-10">

    <div class="mb-6 sm:mb-8">
      <p class="text-xs font-semibold uppercase tracking-wider text-brand mb-1">Product Catalog</p>
      <h1 class="text-2xl sm:text-3xl font-bold text-ink-900">Registering <span class="text-black/50">Product Catalog</span></h1>
      <p class="text-sm text-ink-500 mt-1.5 max-w-2xl">
        Adding canonical product catalog to the <span class="text-brand font-bold">COCOCE Marketplace</span> catalog.
      </p>
    </div>

    <div class="mb-6 sm:mb-10 bg-white rounded-2xl border border-ink-200 p-4 sm:p-5 shadow-soft">
      <div class="step-indicator" id="stepIndicator"></div>
    </div>

    <div class="bg-white rounded-2xl border border-ink-200 shadow-soft overflow-hidden">
      <div id="wizardBody" class="p-5 sm:p-8"></div>

      <div id="wizardFooter" class="hidden px-5 sm:px-8 py-4 bg-ink-50 border-t border-ink-200 flex flex-col-reverse sm:flex-row sm:items-center sm:justify-between gap-3">
        <button type="button" id="btnBack" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl border border-ink-200 bg-white text-sm font-medium text-ink-700 hover:bg-ink-100 transition">
          <i data-lucide="arrow-left" class="w-4 h-4"></i>
          Back
        </button>
        <div class="flex flex-col-reverse sm:flex-row items-stretch sm:items-center gap-3 sm:justify-end w-full sm:w-auto">
          <span id="footerHint" class="text-xs text-ink-400 text-center sm:text-right sm:mr-2"></span>
          <button type="button" id="btnNext" class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-brand text-white text-sm font-semibold hover:bg-brand-dark transition disabled:opacity-50 disabled:cursor-not-allowed">
            <span class="btn-label">Continue</span>
            <i data-lucide="arrow-right" class="w-4 h-4 btn-icon"></i>
          </button>
        </div>
      </div>
    </div>

  </main>

  <div id="toastContainer" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 items-end"></div>

  <script src="/scripts/p-cataloging.js"></script>

</body>

</html>