                        <label class="block text-sm font-medium text-gray-700 mb-1">
                          Business Address
                        </label>
                        <input id="vendorBusinessAddress" type="text" value="<%=locals.user?.vendor?.business_address || ''%>" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-gray-900 focus:outline-none focus:border-brand focus:ring-2 focus:ring-brand/10">
                      </div>
                    </div>

                    <div class="grid md:grid-cols-2 gap-4 mt-3">
                      <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                          TIN Number
                        </label>
                        <input id="vendorTin" type="text" value="<%=locals.user?.vendor?.tin_number || ''%>" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-gray-900 focus:outline-none focus:border-brand focus:ring-2 focus:ring-brand/10">
