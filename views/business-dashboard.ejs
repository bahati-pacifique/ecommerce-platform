    body {
      background: #F8FAFC;
      font-family: 'Inter', sans-serif;
    }

    .sidebar {
      background: white;
      border-right: 1px solid #e5e7eb;
      height: 100vh;
      position: sticky;
      top: 0;
      overflow-y: auto;
      width: 264px;
      flex-shrink: 0;
      transition: width 0.3s ease;
    }

    .sidebar.collapsed {
      width: 72px;
    }

    .sidebar.collapsed .sidebar-link .link-text,
    .sidebar.collapsed .sidebar-brand .brand-text,
    .sidebar.collapsed .sidebar-footer .user-info {
      display: none;
    }

    .sidebar.collapsed .sidebar-link {
      justify-content: center;
      padding: 10px 14px;
    }

    .sidebar.collapsed .sidebar-footer {
      padding: 12px 14px;
    }

    .sidebar-link {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 16px;
      border-radius: 12px;
      color: #6B7280;
      font-weight: 500;
      font-size: 14px;
      transition: all 0.2s ease;
      cursor: pointer;
      text-decoration: none;
      white-space: nowrap;
      overflow: hidden;
    }

    .sidebar-link:hover {
      background: #F9FAFB;
      color: #1F2937;
    }

    .sidebar-link.active {
      background: #FEE2E3;
      color: #ED1B24;
      font-weight: 600;
    }

    .sidebar-link .icon {
      font-size: 18px;
      width: 24px;
      text-align: center;
      flex-shrink: 0;
    }

    .sidebar-link .badge {
      margin-left: auto;
      background: #ED1B24;
      color: white;
      font-size: 10px;
      font-weight: 600;
      padding: 2px 8px;
      border-radius: 20px;
      flex-shrink: 0;
    }

    .sidebar-link .badge.amber {
      background: #F59E0B;
    }

    .sidebar-link .badge.green {
      background: #22C55E;
    }

    /* Mobile sidebar overlay */
    .sidebar-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.4);
      z-index: 49;
    }

    .sidebar-overlay.active {
      display: block;
    }

    @media (max-width: 1023px) {
      .sidebar {
        position: fixed;
        left: 0;
        top: 0;
        bottom: 0;
        z-index: 50;
        transform: translateX(-100%);
        transition: transform 0.3s ease;
        box-shadow: 4px 0 20px rgba(0, 0, 0, 0.05);
      }

      .sidebar.mobile-open {
        transform: translateX(0);
      }

      .sidebar-overlay.active {
        display: block;
      }

      .sidebar.collapsed {
        width: 280px !important;
      }

      .sidebar.collapsed .sidebar-link .link-text,
      .sidebar.collapsed .sidebar-brand .brand-text,
      .sidebar.collapsed .sidebar-footer .user-info {
        display: inline !important;
      }

      .sidebar.collapsed .sidebar-link {
        justify-content: flex-start !important;
        padding: 10px 16px !important;
      }
    }

    /* Stat cards */
    .stat-card {
      transition: all 0.3s ease;
    }

    .stat-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.06);
    }

    /* Tab content */
    .tab-content {
      display: none;
    }

    .tab-content.active {
      display: block;
    }

    .tab-btn {
      transition: all 0.2s ease;
      position: relative;
    }

    .tab-btn.active {
      color: #ED1B24;
      font-weight: 600;
      border-bottom: 2px solid #ED1B24;
    }

    .tab-btn:hover:not(.active) {
      color: #1F2937;
    }

    /* Inventory items */
    .inventory-item {
      transition: all 0.2s ease;
    }

    .inventory-item:hover {
      background: #f9fafb;
      transform: translateX(4px);
    }

    /* Status badges */
    .status-badge {
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .status-badge.active {
      background: #DCFCE7;
      color: #16A34A;
    }

    .status-badge.inactive {
      background: #FEE2E3;
      color: #ED1B24;
    }

    .status-badge.draft {
      background: #FEF3C7;
      color: #D97706;
    }

    .status-badge.pending {
      background: #FEF3C7;
      color: #D97706;
    }

    .status-badge.verified {
      background: #DCFCE7;
      color: #16A34A;
    }

    /* Chart container */
    .chart-container {
      position: relative;
      height: 280px;
    }

    @media (max-width: 640px) {
      .chart-container {
        height: 220px;
      }
    }

    /* Top bar */
    .top-bar-btn {
      transition: all 0.2s ease;
      background: white;
      border: 1px solid #e5e7eb;
      padding: 8px 16px;
      border-radius: 12px;
      font-size: 13px;
      font-weight: 500;
      color: #4B5563;
      cursor: pointer;
    }

    .top-bar-btn:hover {
      background: #F9FAFB;
      border-color: #D1D5DB;
    }

    /* Avatar upload */
    .avatar-upload {
      position: relative;
      cursor: pointer;
    }

    .avatar-upload .overlay {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .avatar-upload:hover .overlay {
      opacity: 1;
    }

    /* Scrollbar */
    ::-webkit-scrollbar {
      width: 5px;
    }

    ::-webkit-scrollbar-track {
      background: #f1f1f1;
    }

    ::-webkit-scrollbar-thumb {
      background: #ED1B24;
      border-radius: 10px;
    }

    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }

    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    .store-container div {
      cursor: pointer;
    }

    /* ========== PROFILE POPUP MENU ========== */
    .profile-popup {
      position: absolute;
      bottom: 70px;
      left: 16px;
      background: white;
      border-radius: 12px;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.12);
      border: 1px solid #e5e7eb;
      min-width: 200px;
      padding: 8px 0;
      z-index: 100;
      opacity: 0;
      transform: translateY(10px) scale(0.95);
      pointer-events: none;
      transition: all 0.2s ease;
    }

    .profile-popup.show {
      opacity: 1;
      transform: translateY(0) scale(1);
      pointer-events: auto;
    }

    .profile-popup .popup-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 16px;
      color: #4B5563;
      font-size: 14px;
      font-weight: 500;
      transition: all 0.15s ease;
      cursor: pointer;
      text-decoration: none;
      border: none;
      background: transparent;
      width: 100%;
      text-align: left;
    }

    .profile-popup .popup-item:hover {
      background: #F9FAFB;
      color: #1F2937;
    }

    .profile-popup .popup-item.danger {
      color: #ED1B24;
    }

    .profile-popup .popup-item.danger:hover {
      background: #FEE2E3;
    }

    .profile-popup .popup-divider {
      height: 1px;
      background: #e5e7eb;
      margin: 4px 0;
    }

    .profile-popup .popup-item .icon {
      width: 20px;
      text-align: center;
      font-size: 16px;
    }
  </style>
</head>

