                        </label>
                        <input id="vendorVatNumber" type="text" value="<%=locals.user?.vendor?.vat_number || ''%>" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-gray-900 focus:outline-none focus:border-brand focus:ring-2 focus:ring-brand/10">
                      </div>
                    </div>

                    <div class="grid md:grid-cols-2 gap-4 mt-3">
                      <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                          Tax Country
                        </label>
                        <input id="vendorTaxCountry" type="text" value="<%=locals.user?.vendor?.tax_country || 'Rwanda'%>" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-gray-900 focus:outline-none focus:border-brand focus:ring-2 focus:ring-brand/10">
                      </div>
                      <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                          Business Type
                        </label>
                        <select id="vendorType" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-gray-900 focus:outline-none focus:border-brand focus:ring-2 focus:ring-brand/10">
                          <option value="retailer" <%=locals.user?.vendor?.type === 'retailer' ? 'selected' : ''%>>Retailer</option>
                          <option value="distributor" <%=locals.user?.vendor?.type === 'distributor' ? 'selected' : ''%>>Distributor</option>
                          <option value="manufacturer" <%=locals.user?.vendor?.type === 'manufacturer' ? 'selected' : ''%>>Manufacturer</option>
                          <option value="supplier" <%=locals.user?.vendor?.type === 'supplier' ? 'selected' : ''%>>Supplier</option>
                          <option value="dealer" <%=locals.user?.vendor?.type === 'dealer' ? 'selected' : ''%>>Dealer</option>
                        </select>
                      </div>
                    </div>

                    <div class="grid md:grid-cols-2 gap-4 mt-3">
                      <div class="col-span-full">
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                          Tax Registered
                        </label>
                        <select id="vendorTaxRegistered" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-gray-900 focus:outline-none focus:border-brand focus:ring-2 focus:ring-brand/10">
                          <option value="registered" <%=locals.user?.vendor?.tax_registered === 'registered' ? 'selected' : ''%>>Registered</option>
                          <option value="not_registered" <%=locals.user?.vendor?.tax_registered === 'not_registered' ? 'selected' : ''%>>Not Registered</option>
                        </select>
                      </div>

                    </div>
                  </div>

                  <div class="flex items-center gap-3 pt-4 mt-4 border-t border-gray-100">
                    <button type="submit" id="saveProfileBtn" class="px-6 py-2.5 bg-brand text-white rounded-xl font-medium hover:bg-brand-dark transition disabled:opacity-50 disabled:cursor-not-allowed">
                      <span id="saveProfileText">Save Changes</span>
                      <span id="saveProfileLoader" class="hidden">
                        <i class="fas fa-spinner fa-spin"></i> Saving...
                      </span>
                    </button>
                    <button type="button" id="resetProfileBtn" class="px-6 py-2.5 bg-gray-100 text-gray-700 rounded-xl font-medium hover:bg-gray-200 transition">
                      Reset
                    </button>
                    <span id="saveProfileMessage" class="text-sm hidden"></span>
                  </div>
                </div>
              </div>
            </form>
          </div>
        </div>

