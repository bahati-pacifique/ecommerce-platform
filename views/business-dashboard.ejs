    /* Enhanced search bar styling */
    .search-toolbar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px;
      margin-bottom: 16px;
    }

    .search-wrapper {
      position: relative;
      flex: 1 1 260px;
      max-width: 340px;
    }

    .search-wrapper .search-icon {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      color: #94a3b8;
      pointer-events: none;
    }

    .search-wrapper .search-clear {
      position: absolute;
      right: 10px;
      top: 50%;
      transform: translateY(-50%);
      color: #94a3b8;
      cursor: pointer;
      display: none;
      padding: 4px;
      border-radius: 50%;
      line-height: 1;
    }

    .search-wrapper .search-clear:hover {
      background: #f1f5f9;
      color: #475569;
    }

    .search-wrapper .search-clear.visible {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .search-input {
      width: 100%;
      padding: 9px 32px 9px 38px;
      border-radius: 12px;
      border: 1px solid #e5e7eb;
      background: #f9fafb;
      font-size: 0.875rem;
      color: #111827;
      transition: all 0.15s ease;
      outline: none;
    }

    .search-input:focus {
      border-color: #ED1B24;
      background: #ffffff;
      box-shadow: 0 0 0 3px rgba(237, 27, 36, 0.08);
    }

    .search-input::placeholder {
      color: #9ca3af;
    }

    .search-select {
      padding: 9px 14px;
      border-radius: 12px;
      border: 1px solid #e5e7eb;
      background: #f9fafb;
      font-size: 0.8125rem;
      color: #374151;
      outline: none;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .search-select:focus {
      border-color: #ED1B24;
      background: #ffffff;
      box-shadow: 0 0 0 3px rgba(237, 27, 36, 0.08);
    }

    .search-btn {
      padding: 9px 18px;
      border-radius: 12px;
      background: #ED1B24;
      color: #ffffff;
      font-size: 0.8125rem;
      font-weight: 500;
      border: none;
      cursor: pointer;
      transition: background 0.15s ease;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .search-btn:hover {
      background: #c4161e;
    }

    .search-results-info {
      font-size: 0.75rem;
      color: #6b7280;
      margin-left: auto;
    }

    /* Mobile filter toggle */
    @media (max-width: 640px) {
      .search-wrapper {
        max-width: 100%;
        flex: 1 1 100%;
      }

      .search-toolbar .search-select {
        flex: 1 1 calc(50% - 5px);
      }

      .search-toolbar .search-btn {
        flex: 1 1 100%;
        justify-content: center;
      }

      .search-results-info {
        flex: 1 1 100%;
        text-align: right;
        margin-left: 0;
      }
    }
  </style>

