  // ─────────────────────────────────────────────────────────────
  // State
  // ─────────────────────────────────────────────────────────────
  const state = {
    page: 1,
    limit: 10,
    search: '',
    notify: '',
    sort: 'followed_desc',
    pagination: {
      page: 1,
      hasNextPage: false,
      hasPreviousPage: false,
      totalPages: 1,
      totalListings: 0,
      limit: 10,
    },
  };

  // ─────────────────────────────────────────────────────────────
  // DOM references
  // ─────────────────────────────────────────────────────────────
  const els = {
    grid:          document.getElementById('followersGrid'),
    skeleton:      document.getElementById('followersSkeleton'),
    empty:         document.getElementById('followersEmpty'),
    error:         document.getElementById('followersError'),
    stats:         document.getElementById('followersStats'),
    search:        document.getElementById('followersSearch'),
    notify:        document.getElementById('followersNotify'),
    sort:          document.getElementById('followersSort'),
    limit:         document.getElementById('followersLimit'),
    count:         document.getElementById('followersCount'),
    activeFilters: document.getElementById('followersActiveFilters'),
    pageInfo:      document.getElementById('followersPageInfo'),
    pageControls:  document.getElementById('followersPageControls'),
    currentPage:   document.getElementById('followersCurrentPage'),
    totalPages:    document.getElementById('followersTotalPages'),
    prevBtn:       document.querySelector('[data-page-action="prev"]'),
    nextBtn:       document.querySelector('[data-page-action="next"]'),
    exportBtn:     document.getElementById('exportFollowersButton'),
    broadcastBtn:  document.getElementById('broadcastButton'),
  };

  // ─────────────────────────────────────────────────────────────
  // Utils
  // ─────────────────────────────────────────────────────────────
  function getStoreId() {
    const match = window.location.pathname.match(/\/stores\/([^/]+)/);
    return match ? match[1] : null;
  }

  function debounce(fn, ms) {
    let t;
    return (...args) => { clearTimeout(t); t = setTimeout(() => fn(...args), ms); };
  }

  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str ?? '';
    return div.innerHTML;
  }

  function relTime(date) {
    if (!date) return '';
    const diff = Date.now() - new Date(date).getTime();
    const day = 86400000;
    if (diff < day) return 'today';
    if (diff < day * 2) return 'yesterday';
    if (diff < day * 7) return `${Math.floor(diff / day)} days ago`;
    if (diff < day * 30) return `${Math.floor(diff / (day * 7))} weeks ago`;
    if (diff < day * 365) return `${Math.floor(diff / (day * 30))} months ago`;
    return `${Math.floor(diff / (day * 365))} years ago`;
  }

  // ─────────────────────────────────────────────────────────────
  // State visibility
  // Toggles between: 'cards' | 'skeleton' | 'empty' | 'error'
  // ─────────────────────────────────────────────────────────────
  function showState(name) {
    // Hide discrete state elements
    els.skeleton.classList.add('hidden');
    els.empty.classList.add('hidden');
    els.error.classList.add('hidden');

    // Toggle grid mode (used by CSS to hide server-rendered cards)
    els.grid.classList.toggle('state-cards',    name === 'cards');
    els.grid.classList.toggle('state-skeleton', name === 'skeleton');
    els.grid.classList.toggle('state-empty',    name === 'empty');
    els.grid.classList.toggle('state-error',    name === 'error');

    if (name === 'skeleton') els.skeleton.classList.remove('hidden');
    if (name === 'empty')    els.empty.classList.remove('hidden');
    if (name === 'error')    els.error.classList.remove('hidden');

    window.lucide?.createIcons();
  }

  // ─────────────────────────────────────────────────────────────
  // Stats — update by reference (no innerHTML)
  // ─────────────────────────────────────────────────────────────
  function updateStats(stats) {
    const pct = (part, whole) => (whole ? Math.round((part / whole) * 100) : 0);

    const setValue = (key, value) => {
      const card = els.stats?.querySelector(`[data-stat="${key}"]`);
      card?.querySelector('[data-stat-value]')?.replaceChildren(
        document.createTextNode(Number(value || 0).toLocaleString())
      );
    };
    const setPct = (key, value) => {
      const card = els.stats?.querySelector(`[data-stat="${key}"]`);
      card?.querySelector('[data-stat-pct]')?.replaceChildren(
        document.createTextNode(String(value))
      );
    };

    setValue('total',            stats.total);
    setValue('notify_products',  stats.notify_products);
    setValue('notify_promotions', stats.notify_promotions);
    setValue('notify_discounts', stats.notify_discounts);

    setPct('notify_products',   pct(stats.notify_products,   stats.total));
    setPct('notify_promotions', pct(stats.notify_promotions, stats.total));
    setPct('notify_discounts',  pct(stats.notify_discounts,  stats.total));
  }

  // ─────────────────────────────────────────────────────────────
  // Count line — textContent
  // ─────────────────────────────────────────────────────────────
  function updateCount({ page, limit, totalListings }) {
    const from = totalListings ? (page - 1) * limit + 1 : 0;
    const to   = Math.min(page * limit, totalListings);
    els.count.textContent = totalListings
      ? `Showing ${from}–${to} of ${totalListings} followers`
      : 'No followers';
  }

  // ─────────────────────────────────────────────────────────────
  // Pagination — update by reference
  // ─────────────────────────────────────────────────────────────
  function updatePagination({ page, hasNextPage, hasPreviousPage, totalPages }) {
    if (els.currentPage) els.currentPage.textContent = page;
    if (els.totalPages)  els.totalPages.textContent  = totalPages;
    if (els.prevBtn) els.prevBtn.disabled = !hasPreviousPage;
    if (els.nextBtn) els.nextBtn.disabled = !hasNextPage;
    if (els.pageInfo) els.pageInfo.textContent = `Page ${page} of ${totalPages}`;
  }

  // ─────────────────────────────────────────────────────────────
  // Card markup — one place, used by both server render (EJS)
  // and client render (below). Keep them in sync.
  // ─────────────────────────────────────────────────────────────
  function renderFollowerHTML(f) {
    const username = f.username || 'Unknown user';
    const email    = f.email    || '—';
    const phone    = f.phone    || null;

    const followedAt = f.followed_at ? new Date(f.followed_at) : null;
    const followedLabel = followedAt
      ? followedAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
      : '—';
    const rel = relTime(followedAt);

    const avatar   = f.avatar_url;
    const initial  = username.charAt(0).toUpperCase();
    const isActive = f.last_order_at
      && (Date.now() - new Date(f.last_order_at).getTime()) < 86400000 * 30;

    const avatarHTML = avatar
      ? `<img src="${escapeHtml(avatar)}" alt="${escapeHtml(username)}"
              class="h-12 w-12 rounded-full object-cover ring-2 ring-slate-100"
              data-fallback-hide="true" />
         <div class="hidden h-12 w-12 items-center justify-center rounded-full bg-[var(--color-brand-ultralight)] text-[var(--color-brand)] font-bold ring-2 ring-slate-100">${initial}</div>`
      : `<div class="flex h-12 w-12 items-center justify-center rounded-full bg-[var(--color-brand-ultralight)] text-[var(--color-brand)] font-bold ring-2 ring-slate-100">${initial}</div>`;

    const pill = (on, label, icon) => on
      ? `<span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold text-emerald-700"><i data-lucide="${icon}" class="h-3 w-3"></i>${label}</span>`
      : `<span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-semibold text-slate-400 line-through"><i data-lucide="${icon}" class="h-3 w-3"></i>${label}</span>`;

    const spentLabel = f.total_spent != null
      ? new Intl.NumberFormat('en-US', { style: 'currency', currency: f.currency || 'USD' }).format(f.total_spent / 100)
      : null;

    return `
      <article class="follower-card group flex flex-col rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-slate-300 hover:shadow-md"
               data-follower-id="${escapeHtml(f.id)}"
               data-customer-id="${escapeHtml(f.customer_id || '')}">
        <div class="flex items-start gap-3">
          <div class="relative shrink-0">
            ${avatarHTML}
            ${isActive ? '<span class="absolute -bottom-0.5 -right-0.5 h-3 w-3 rounded-full border-2 border-white bg-emerald-500"></span>' : ''}
          </div>
          <div class="min-w-0 flex-1">
            <h3 class="truncate text-sm font-semibold text-slate-900">${escapeHtml(username)}</h3>
            <div class="mt-0.5 flex flex-col gap-0.5 text-xs text-slate-500">
              <span class="flex items-center gap-1.5 truncate"><i data-lucide="mail" class="h-3 w-3 shrink-0 text-slate-400"></i><span class="truncate">${escapeHtml(email)}</span></span>
              ${phone ? `<span class="flex items-center gap-1.5 truncate"><i data-lucide="phone" class="h-3 w-3 shrink-0 text-slate-400"></i><span class="truncate">${escapeHtml(phone)}</span></span>` : ''}
            </div>
          </div>
        </div>

        <div class="mt-3 flex items-center gap-1.5 text-[11px] text-slate-400">
          <i data-lucide="user-plus" class="h-3 w-3"></i>
          <span>Followed ${followedLabel}</span>
          ${rel ? `<span class="text-slate-300">·</span><span>${rel}</span>` : ''}
        </div>

        <div class="mt-3 flex flex-wrap gap-1.5">
          ${pill(f.notify_products,   'Products',  'package')}
          ${pill(f.notify_promotions, 'Promos',    'megaphone')}
          ${pill(f.notify_discounts,  'Discounts', 'percent')}
        </div>

        ${(f.orders_count != null || spentLabel != null) ? `
          <dl class="mt-3 grid grid-cols-2 gap-x-3 gap-y-1.5 border-t border-slate-100 pt-3 text-xs">
            ${f.orders_count != null ? `<div><dt class="text-slate-400">Orders</dt><dd class="font-semibold text-slate-700">${f.orders_count}</dd></div>` : ''}
            ${spentLabel != null ? `<div><dt class="text-slate-400">Total spent</dt><dd class="font-semibold text-slate-700">${spentLabel}</dd></div>` : ''}
          </dl>` : ''}

        <div class="mt-4 flex items-center justify-between gap-2 border-t border-slate-100 pt-3">
          <span class="truncate font-mono text-[10px] text-slate-400">#${escapeHtml(String(f.customer_id || f.id).slice(0, 8))}</span>
          <div class="flex gap-1.5">
            <a href="/stores/${escapeHtml(f.store_id || getStoreId() || '')}/customers/${escapeHtml(f.customer_id || '')}"
               class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50">
              <i data-lucide="eye" class="h-3.5 w-3.5"></i>View
            </a>
            <button type="button"
                    class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-rose-600 hover:bg-rose-50"
                    data-action="remove-follower"
                    data-follower-id="${escapeHtml(f.id)}"
                    data-follower-name="${escapeHtml(username)}">
              <i data-lucide="user-minus" class="h-3.5 w-3.5"></i>Remove
            </button>
          </div>
        </div>
      </article>`;
  }

  // ─────────────────────────────────────────────────────────────
  // Replace cards — only touches .follower-card elements
  // ─────────────────────────────────────────────────────────────
  function replaceCards(items) {
    // Remove existing cards
    els.grid.querySelectorAll('.follower-card').forEach(el => el.remove());

    if (!items || !items.length) {
      showState('empty');
      return;
    }

    // Build fragment of new cards
    const frag = document.createDocumentFragment();
    for (const f of items) {
      const wrapper = document.createElement('div');
      wrapper.innerHTML = renderFollowerHTML(f).trim();
      const node = wrapper.firstElementChild;
      if (node) frag.appendChild(node);
    }

    // Insert before the first state element (skeleton / empty / error)
    els.grid.insertBefore(frag, els.skeleton || null);

    showState('cards');
  }

  // ─────────────────────────────────────────────────────────────
  // Mock fetcher — returns the same shape the real API will
  // ─────────────────────────────────────────────────────────────
  async function mockFetchFollowers(params) {
    await new Promise(r => setTimeout(r, 250));

    const search = (params.get('search') || '').toLowerCase();
    const notify = params.get('notify') || '';
    const sort   = params.get('sort')   || 'followed_desc';
    const page   = parseInt(params.get('page')  || '1', 10);
    const limit  = parseInt(params.get('limit') || '10', 10);

    let filtered = MOCK_FOLLOWERS.slice();

    if (search) {
      filtered = filtered.filter(f =>
        (f.username || '').toLowerCase().includes(search) ||
        (f.email    || '').toLowerCase().includes(search) ||
        (f.phone    || '').toLowerCase().includes(search)
      );
    }

    if (notify) {
      filtered = filtered.filter(f => {
        if (notify === 'products')   return f.notify_products;
        if (notify === 'promotions') return f.notify_promotions;
        if (notify === 'discounts')  return f.notify_discounts;
        if (notify === 'all-notify') return f.notify_products && f.notify_promotions && f.notify_discounts;
        if (notify === 'none')       return !f.notify_products && !f.notify_promotions && !f.notify_discounts;
        return true;
      });
    }

    const SORTERS = {
      followed_desc: (a, b) => new Date(b.followed_at) - new Date(a.followed_at),
      followed_asc:  (a, b) => new Date(a.followed_at) - new Date(b.followed_at),
      name_asc:      (a, b) => (a.username || '').localeCompare(b.username || ''),
      name_desc:     (a, b) => (b.username || '').localeCompare(a.username || ''),
    };
    filtered.sort(SORTERS[sort] || SORTERS.followed_desc);

    const stats = {
      total:             MOCK_FOLLOWERS.length,
      notify_products:   MOCK_FOLLOWERS.filter(f => f.notify_products).length,
      notify_promotions: MOCK_FOLLOWERS.filter(f => f.notify_promotions).length,
      notify_discounts:  MOCK_FOLLOWERS.filter(f => f.notify_discounts).length,
      new_this_week:     MOCK_FOLLOWERS.filter(f => (Date.now() - new Date(f.followed_at)) < 86400000 * 7).length,
    };

    const totalListings = filtered.length;
    const totalPages    = Math.max(1, Math.ceil(totalListings / limit));
    const safePage      = Math.min(Math.max(page, 1), totalPages);
    const start         = (safePage - 1) * limit;
    const items         = filtered.slice(start, start + limit);

    return {
      items,
      stats,
      page:            safePage,
      hasNextPage:     safePage < totalPages,
      hasPreviousPage: safePage > 1,
      totalPages,
      totalListings,
      limit,
    };
  }

  // ─────────────────────────────────────────────────────────────
  // Real API fetcher — used when USE_MOCK = false
  // Expected response:
  //   {
  //     items: [ { ...follower, username, email, phone } ],
  //     stats: { total, notify_products, notify_promotions, notify_discounts, new_this_week },
  //     page, hasNextPage, hasPreviousPage, totalPages, totalListings, limit
  //   }
  // ─────────────────────────────────────────────────────────────
  async function apiFetchFollowers(params) {
    const storeId = getStoreId();
    const res = await fetch(`/api/stores/${storeId}/followers?${params}`);
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    return res.json();
  }

  // ─────────────────────────────────────────────────────────────
  // Load
  // ─────────────────────────────────────────────────────────────
  async function load() {
    showState('skeleton');
    updateCount({ page: state.page, limit: state.limit, totalListings: 0 });

    try {
      const params = new URLSearchParams({
        page:   state.page,
        limit:  state.limit,
        search: state.search,
        notify: state.notify,
        sort:   state.sort,
      });

      const payload = USE_MOCK
        ? await mockFetchFollowers(params)
        : await apiFetchFollowers(params);

      // ── Defensive guard ──
      if (!payload || typeof payload !== 'object') {
        console.error('[followers] Fetcher returned invalid payload:', payload);
        throw new Error('Invalid payload');
      }

      const stats = payload.stats || {
        total: 0, notify_products: 0, notify_promotions: 0,
        notify_discounts: 0, new_this_week: 0,
      };
      const items = Array.isArray(payload.items) ? payload.items : [];
      const page            = payload.page            ?? 1;
      const limit           = payload.limit           ?? state.limit;
      const totalPages      = payload.totalPages      ?? 1;
      const totalListings   = payload.totalListings   ?? items.length;
      const hasNextPage     = !!payload.hasNextPage;
      const hasPreviousPage = !!payload.hasPreviousPage;

      updateStats(stats);
      replaceCards(items);
      updatePagination({ page, hasNextPage, hasPreviousPage, totalPages });
      updateCount({ page, limit, totalListings });

      state.pagination = {
        page, hasNextPage, hasPreviousPage, totalPages, totalListings, limit,
      };

      window.lucide?.createIcons();
    } catch (err) {
      console.error('[followers] load failed:', err);
      showState('error');
    }
  }

  // ─────────────────────────────────────────────────────────────
  // Active filter chips
  // ─────────────────────────────────────────────────────────────
  function renderActiveFilters() {
    const chips = [];

    if (state.search) {
      chips.push(`
        <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700">
          Search: "${escapeHtml(state.search)}"
          <button type="button" data-clear="search" class="text-slate-400 hover:text-rose-600">×</button>
        </span>`);
    }
    if (state.notify) {
      chips.push(`
        <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700">
          Notify: ${escapeHtml(state.notify)}
          <button type="button" data-clear="notify" class="text-slate-400 hover:text-rose-600">×</button>
        </span>`);
    }

    els.activeFilters.innerHTML = chips.join('');

    els.activeFilters.querySelectorAll('[data-clear]').forEach(btn => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.clear;
        if (key === 'search') { state.search = ''; if (els.search) els.search.value = ''; }
        if (key === 'notify') { state.notify = ''; if (els.notify) els.notify.value = ''; }
        state.page = 1;
        renderActiveFilters();
        load();
      });
    });
  }

  // ─────────────────────────────────────────────────────────────
  // Events — page-specific (shell handles generic [data-action])
  // ─────────────────────────────────────────────────────────────
  els.search?.addEventListener('input', debounce((e) => {
    state.search = e.target.value.trim();
    state.page = 1;
    renderActiveFilters();
    load();
  }, 300));

  els.notify?.addEventListener('change', (e) => {
    state.notify = e.target.value;
    state.page = 1;
    renderActiveFilters();
    load();
  });

  els.sort?.addEventListener('change', (e) => {
    state.sort = e.target.value;
    state.page = 1;
    load();
  });

  els.limit?.addEventListener('change', (e) => {
    state.limit = parseInt(e.target.value, 10);
    state.page = 1;
    load();
  });

  els.exportBtn?.addEventListener('click', () => {
    toast?.('Preparing CSV export...', 'info');
    // window.location.href = `/api/stores/${getStoreId()}/followers/export`;
  });

  els.broadcastBtn?.addEventListener('click', () => {
    toast?.('Broadcast composer opened');
  });

  els.prevBtn?.addEventListener('click', () => {
    if (state.pagination.hasPreviousPage) {
      state.page = state.pagination.page - 1;
      load();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  });

  els.nextBtn?.addEventListener('click', () => {
    if (state.pagination.hasNextPage) {
      state.page = state.pagination.page + 1;
      load();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  });

  // ── Delegated: remove-follower (only this page listens for it) ──
  els.grid?.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-action="remove-follower"]');
    if (!btn) return;

    const name = btn.dataset.followerName || 'this follower';
    const id   = btn.dataset.followerId;

    if (!confirm(`Remove ${name} from this store's followers?`)) return;

    // Optimistic UI: hide the card immediately
    const card = btn.closest('.follower-card');
    card?.classList.add('opacity-40', 'pointer-events-none');

    toast?.(`Removed ${name}`, 'success');

    // TODO: replace with real request when backend is ready:
    // await fetch(`/api/stores/${getStoreId()}/followers/${id}`, { method: 'DELETE' });
    // then: card?.remove(); load();

    // Mock: just remove from DOM
    card?.remove();
  });

  // ─────────────────────────────────────────────────────────────
  // Init
  // ─────────────────────────────────────────────────────────────
  renderActiveFilters();
  load();
});
</script>