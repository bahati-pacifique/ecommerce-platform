<div class="mb-6 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
  <div>
    <div class="mb-1 flex items-center gap-2 text-brand">
      <i data-lucide="warehouse" class="h-4 w-4"></i>
      <span class="text-sm font-semibold"><%= store.name %></span>
    </div>

    <h1 class="text-2xl font-bold tracking-tight">Inventory Overview</h1>
    <p class="mt-1 text-sm text-slate-500">
      Monitor stock levels, reserved quantities, and inventory availability.
    </p>
  </div>

  <div class="flex gap-2">
    <button type="button" id="inventoryDataRefreshBtn" title="Refresh inventory" aria-label="Refresh inventory" class="inline-flex items-center gap-2 rounded-lg border border-slate-200
             bg-white px-3 py-2 text-sm font-medium hover:bg-slate-50">
      <i data-lucide="refresh-cw" class="h-4 w-4"></i>
      <span>Refresh</span>
    </button>
  </div>
</div>

<div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-center justify-between">
      <p class="text-sm font-medium text-slate-500">Inventories</p>
      <i data-lucide="warehouse" class="h-5 w-5 text-slate-400"></i>
    </div>
    <p id="inventoryTotal" class="mt-3 text-2xl font-bold text-slate-900">—</p>
    <p class="mt-1 text-xs text-slate-500">Matching inventories</p>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-center justify-between">
      <p class="text-sm font-medium text-slate-500">Low-stock records</p>
      <i data-lucide="alert-triangle" class="h-5 w-5 text-amber-500"></i>
    </div>
    <p id="inventoryLowStock" class="mt-3 text-2xl font-bold text-amber-600">—</p>
    <p class="mt-1 text-xs text-slate-500">Records needing attention</p>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-center justify-between">
      <p class="text-sm font-medium text-slate-500">Out-of-stock records</p>
      <i data-lucide="package-x" class="h-5 w-5 text-rose-500"></i>
    </div>
    <p id="inventoryOutOfStock" class="mt-3 text-2xl font-bold text-rose-600">—</p>
    <p class="mt-1 text-xs text-slate-500">Records with no available units</p>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-center justify-between">
      <p class="text-sm font-medium text-slate-500">Reserved units</p>
      <i data-lucide="package-check" class="h-5 w-5 text-slate-400"></i>
    </div>
    <p id="inventoryReserved" class="mt-3 text-2xl font-bold text-slate-900">—</p>
    <p class="mt-1 text-xs text-slate-500">Units reserved across inventories</p>
  </div>
</div>

<div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
  <div class="flex flex-col gap-3 border-b border-slate-100 p-4 lg:flex-row lg:items-center lg:justify-between">
    <div class="relative w-full lg:max-w-md">
      <i data-lucide="search" class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"></i>
      <input id="inventoryDataSearch" type="search" autocomplete="off" placeholder="Search inventory title..." class="w-full rounded-lg border border-slate-200 bg-slate-50 py-2 pl-9 pr-3
               text-sm outline-none focus:border-brand focus:bg-white" />
    </div>

    <div class="flex flex-col gap-2 sm:flex-row">
      <select id="inventoryDataStatus" class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm">
        <option value="">All statuses</option>
        <option value="active">Active</option>
        <option value="inactive">Inactive</option>
      </select>

      <select id="inventoryDataStock" class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm">
        <option value="">All stock levels</option>
        <option value="low">Low stock</option>
        <option value="out_of_stock">Out of stock</option>
        <option value="available">Available</option>
      </select>
    </div>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
        <tr>
          <th class="whitespace-nowrap px-5 py-3 font-semibold">Inventory</th>
          <th class="whitespace-nowrap px-5 py-3 font-semibold">Status</th>
          <th class="whitespace-nowrap px-5 py-3 font-semibold">Low stock</th>
          <th class="whitespace-nowrap px-5 py-3 font-semibold">Out of stock</th>
          <th class="whitespace-nowrap px-5 py-3 font-semibold">Reserved</th>
          <th class="whitespace-nowrap px-5 py-3 font-semibold">Items</th>
          <th class="whitespace-nowrap px-5 py-3 font-semibold">Quantity</th>
          <th class="whitespace-nowrap px-5 py-3 text-right font-semibold">Actions</th>
        </tr>
      </thead>

      <tbody id="inventoryTbody" class="divide-y divide-slate-100">
        <tr>
          <td colspan="8" class="px-5 py-10 text-center text-slate-400">
            Loading inventories...
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <div id="inventoryPagination" class="border-t border-slate-100 p-4"></div>
</div>

<!-- ============================= -->
<!-- Listings modal                -->
<!-- ============================= -->
<div id="listingsModal" class="fixed inset-0 z-50 hidden" role="dialog" aria-modal="true" aria-labelledby="listingsModalTitle">
  <!-- Backdrop -->
  <div class="absolute inset-0 bg-slate-900/50" data-modal-close></div>

  <!-- Panel -->
  <div class="absolute inset-0 flex items-center justify-center p-4">
    <div class="relative flex max-h-[90vh] w-full max-w-5xl flex-col overflow-hidden rounded-2xl bg-white shadow-xl">
      <!-- Header -->
      <div class="flex items-start justify-between gap-3 border-b border-slate-100 px-5 py-4">
        <div>
          <h2 id="listingsModalTitle" class="text-lg font-bold tracking-tight text-slate-900">
            Inventory listings
          </h2>
          <p id="listingsModalSubtitle" class="mt-0.5 text-xs text-slate-500">
            Loading…
          </p>
        </div>
        <button type="button" data-modal-close class="rounded-lg p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-600" aria-label="Close">
          <i data-lucide="x" class="h-5 w-5"></i>
        </button>
      </div>

      <!-- Search/filter row for listings -->
      <div class="flex flex-col gap-2 border-b border-slate-100 px-5 py-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="relative w-full sm:max-w-sm">
          <i data-lucide="search" class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"></i>
          <input id="listingsSearch" type="search" autocomplete="off"
                 placeholder="Search listing or product..."
                 class="w-full rounded-lg border border-slate-200 bg-slate-50 py-2 pl-9 pr-3 text-sm outline-none focus:border-brand focus:bg-white" />
        </div>
        <div id="listingsCount" class="text-xs text-slate-500"></div>
      </div>

      <!-- Body -->
      <div class="flex-1 overflow-y-auto">
        <div id="listingsBody" class="p-5">
          <div class="flex items-center justify-center py-16 text-slate-400">
            <i data-lucide="loader-2" class="mr-2 h-5 w-5 animate-spin"></i>
            <span class="text-sm">Loading listings…</span>
          </div>
        </div>
      </div>

      <!-- Footer / pagination -->
      <div id="listingsPagination" class="border-t border-slate-100 px-5 py-3"></div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const state = {
      page: 1,
      limit: 20,
      search: '',
      status: '',
      stock: '',
      inventories: [],
      pagination: {
        page: 1,
        limit: 20,
        total: 0,
        totalPages: 0
      }
    };

    // Listings modal state
    const listingsState = {
      open: false,
      inventory: null,
      page: 1,
      limit: 7,
      search: '',
      items: [],
      pagination: { page: 1, limit: 25, total: 0, totalPages: 0 },
      loading: false
    };

    const tbody = document.getElementById('inventoryTbody');
    const paginationEl = document.getElementById('inventoryPagination');
    const searchInput = document.getElementById('inventoryDataSearch');
    const statusSelect = document.getElementById('inventoryDataStatus');
    const stockSelect = document.getElementById('inventoryDataStock');
    const refreshBtn = document.getElementById('inventoryDataRefreshBtn');

    const totalEl = document.getElementById('inventoryTotal');
    const lowStockEl = document.getElementById('inventoryLowStock');
    const outOfStockEl = document.getElementById('inventoryOutOfStock');
    const reservedEl = document.getElementById('inventoryReserved');

    const listingsModal = document.getElementById('listingsModal');
    const listingsBody = document.getElementById('listingsBody');
    const listingsPagination = document.getElementById('listingsPagination');
    const listingsTitle = document.getElementById('listingsModalTitle');
    const listingsSubtitle = document.getElementById('listingsModalSubtitle');
    const listingsCount = document.getElementById('listingsCount');
    const listingsSearch = document.getElementById('listingsSearch');

    const formatNumber = value =>
      Number(value ?? 0).toLocaleString();

    function escapeHtml(value) {
      return String(value ?? '').replace(/[&<>"']/g, char => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;'
      })[char]);
    }

    function renderStatus(status) {
      const normalized = String(status ?? '').toLowerCase();

      const styles = {
        active: 'bg-emerald-50 text-emerald-700',
        inactive: 'bg-slate-100 text-slate-600',
        pending: 'bg-amber-50 text-amber-700',
        disabled: 'bg-rose-50 text-rose-700',
        deleted: 'bg-rose-50 text-rose-700'
      };

      return `
      <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold
        ${styles[normalized] || 'bg-slate-100 text-slate-600'}">
        ${escapeHtml(status || 'unknown')}
      </span>
    `;
    }

    function updateSummary() {
      totalEl.textContent = formatNumber(state.pagination.total);

      lowStockEl.textContent = formatNumber(
        state.inventories.reduce((sum, item) => sum + Number(item.low_stock || 0), 0)
      );

      outOfStockEl.textContent = formatNumber(
        state.inventories.reduce((sum, item) => sum + Number(item.out_of_stock || 0), 0)
      );

      reservedEl.textContent = formatNumber(
        state.inventories.reduce((sum, item) => sum + Number(item.reserved || 0), 0)
      );
    }

    function renderRows() {
      const inventories = state.inventories;

      if (!inventories.length) {
        tbody.innerHTML = `
        <tr>
          <td colspan="8" class="px-5 py-16 text-center">
            <div class="inline-flex flex-col items-center gap-2">
              <i data-lucide="package-open" class="h-8 w-8 text-slate-300"></i>
              <p class="text-sm font-medium text-slate-700">
                No inventories found
              </p>
              <p class="text-xs text-slate-500">
                Try adjusting your filters or create an inventory.
              </p>
            </div>
          </td>
        </tr>
      `;

        window.lucide?.createIcons();
        return;
      }

      tbody.innerHTML = inventories.map(inventory => {
        const id = String(inventory.id);

        return `
        <tr class="hover:bg-slate-50">
          <td class="px-5 py-4">
            <div class="font-semibold text-slate-800">
              ${escapeHtml(inventory.title)}
            </div>
            <div class="mt-1 text-xs text-slate-500">
              ${inventory.is_default ? 'Default inventory' : 'Store inventory'}
            </div>
          </td>

          <td class="px-5 py-4 capitalize">${renderStatus(inventory.status?.replace('_', ' ') || '')}</td>

          <td class="px-5 py-4 ${
            Number(inventory.low_stock) > 0
              ? 'font-semibold text-amber-600'
              : 'text-slate-500'
          }">${formatNumber(inventory.low_stock)}</td>

          <td class="px-5 py-4 ${
            Number(inventory.out_of_stock) > 0
              ? 'font-semibold text-rose-600'
              : 'text-slate-500'
          }">${formatNumber(inventory.out_of_stock)}</td>

          <td class="px-5 py-4">${formatNumber(inventory.reserved)}</td>
          <td class="px-5 py-4">${formatNumber(inventory.items)}</td>
          <td class="px-5 py-4 font-medium">${formatNumber(inventory.quantity)}</td>

          <td class="px-5 py-4 text-right">
            <div class="inline-flex items-center gap-2">
              <button
                type="button"
                data-open-listings="${escapeHtml(id)}"
                class="inline-flex items-center gap-1 rounded-lg border
                  border-slate-200 px-3 py-2 text-xs font-semibold hover:bg-slate-50">
                <i data-lucide="list" class="h-3.5 w-3.5"></i>
                <span class="hidden lg:block">View listings</span>
              </button>

              <a href="/inventories/${id}/<%-store.id%>" target="_blank"
                 class="inline-flex items-center gap-1 rounded-lg border border-slate-200 px-2.5 py-2 text-xs font-semibold hover:bg-slate-50"
                 title="Open inventory">
                <i data-lucide="arrow-up-right" class="h-3.5 w-3.5"></i>
              </a>
            </div>
          </td>
        </tr>
      `;
      }).join('');

      window.lucide?.createIcons();
    }

    function renderPagination(payload) {
      const total = Number(payload.total || 0);
      const page = Number(payload.page || 1);
      const limit = Number(payload.limit || state.limit);
      const totalPages = Number(payload.totalPages || 0);

      if (total === 0) {
        paginationEl.innerHTML = '';
        return;
      }

      const from = (page - 1) * limit + 1;
      const to = Math.min(page * limit, total);
      const startPage = Math.max(1, Math.min(page - 2, totalPages - 4));
      const endPage = Math.min(totalPages, startPage + 4);

      let pageButtons = '';

      for (let p = startPage; p <= endPage; p++) {
        pageButtons += `
          <button type="button" data-page="${p}"
            class="rounded-lg border px-3 py-1.5 text-sm ${
              p === page
                ? 'border-brand bg-brand text-white'
                : 'hover:bg-slate-50'
            }">
            ${p}
          </button>
        `;
      }

      paginationEl.innerHTML = `
        <div class="flex flex-col items-center justify-between gap-3
          text-sm text-slate-500 sm:flex-row">
          <span>Showing ${from}–${to} of ${total} inventories</span>
          <div class="flex flex-wrap justify-center gap-1">
            <button type="button" data-page="${page - 1}"
              ${page <= 1 ? 'disabled' : ''}
              class="rounded-lg border px-3 py-1.5 ${
                page <= 1 ? 'cursor-not-allowed opacity-40' : 'hover:bg-slate-50'
              }">Prev</button>
            ${pageButtons}
            <button type="button" data-page="${page + 1}"
              ${page >= totalPages ? 'disabled' : ''}
              class="rounded-lg border px-3 py-1.5 ${
                page >= totalPages ? 'cursor-not-allowed opacity-40' : 'hover:bg-slate-50'
              }">Next</button>
          </div>
        </div>
      `;
    }

    async function load() {
      tbody.innerHTML = `
        <tr>
          <td colspan="8" class="px-5 py-10 text-center text-slate-400">
            Loading inventories...
          </td>
        </tr>
      `;

      const params = new URLSearchParams({
        page: String(state.page),
        limit: String(state.limit)
      });

      if (state.search) params.set('search', state.search);
      if (state.status) params.set('status', state.status);
      if (state.stock) params.set('stock', state.stock);

      try {
        const response = await axios.get(
          `${protocal}business.${domainName}/stores/<%-store.id %>/data/product-listing/inventories`, {
            params,
            withCredentials: true
          }
        );

        state.inventories = response.data.data || [];
        state.pagination = response.data.pagination || {
          page: state.page,
          limit: state.limit,
          total: state.inventories.length,
          totalPages: 1
        };

        renderRows();
        renderPagination(state.pagination);
        updateSummary();
      } catch (error) {
        console.error('Failed to load inventory data:', error);

        state.inventories = [];
        state.pagination = {
          page: state.page,
          limit: state.limit,
          total: 0,
          totalPages: 0
        };

        renderRows();
        renderPagination(state.pagination);
        updateSummary();

        Notification.showNotification({
          type: 'warning',
          message: error.response?.data?.message ||
            'Unable to load inventory data.'
        });
      }
    }

    /* ------------------------------------------------------------------ */
    /* Listings modal                                                      */
    /* ------------------------------------------------------------------ */

    function openListingsModal(inventory) {
      listingsState.open = true;
      listingsState.inventory = inventory;
      listingsState.page = 1;
      listingsState.search = '';
      listingsState.items = [];
      listingsState.pagination = { page: 1, limit: listingsState.limit, total: 0, totalPages: 0 };

      listingsTitle.textContent = inventory.title || 'Inventory listings';
      listingsSubtitle.textContent = inventory.is_default
        ? 'Default inventory'
        : 'Store inventory';
      listingsCount.textContent = '';
      listingsSearch.value = '';

      listingsModal.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
      window.lucide?.createIcons();

      loadListings();
    }

    function closeListingsModal() {
      listingsState.open = false;
      listingsState.inventory = null;
      listingsModal.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
    }

    function renderListings() {
      const items = listingsState.items;

      if (listingsState.loading) {
        listingsBody.innerHTML = `
          <div class="flex items-center justify-center py-16 text-slate-400">
            <i data-lucide="loader-2" class="mr-2 h-5 w-5 animate-spin"></i>
            <span class="text-sm">Loading listings…</span>
          </div>
        `;
        window.lucide?.createIcons();
        return;
      }

      if (!items.length) {
        listingsBody.innerHTML = `
          <div class="py-16 text-center">
            <div class="inline-flex flex-col items-center gap-2">
              <i data-lucide="package-open" class="h-8 w-8 text-slate-300"></i>
              <p class="text-sm font-medium text-slate-700">
                No listings found
              </p>
              <p class="text-xs text-slate-500">
                ${listingsState.search
                  ? 'No listings match your search.'
                  : 'No listings have stock records in this inventory.'}
              </p>
            </div>
          </div>
        `;
        window.lucide?.createIcons();
        return;
      }

      listingsBody.innerHTML = `
        <div class="overflow-x-auto rounded-lg border border-slate-200">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 text-xs uppercase text-slate-500">
              <tr>
                <th class="px-4 py-3">Listing / Product</th>
                <th class="px-4 py-3">Status</th>
                <th class="px-4 py-3 text-right">Records</th>
                <th class="px-4 py-3 text-right">Quantity</th>
                <th class="px-4 py-3 text-right">Reserved</th>
                <th class="px-4 py-3 text-right">Available</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              ${items.map(listing => `
                <tr class="hover:bg-slate-50">
                  <td class="px-4 py-3">
                    <div class="font-medium text-slate-800">
                      ${escapeHtml(listing.listing_title)}
                    </div>
                    <div class="mt-1 text-xs text-slate-500">
                      ${escapeHtml(listing.product_title)}
                    </div>
                  </td>
                  <td class="px-4 py-3 capitalize">
                    ${renderStatus(String(listing.listing_status || '').replace('_', ' '))}
                  </td>
                  <td class="px-4 py-3 text-right">${formatNumber(listing.inventory_records)}</td>
                  <td class="px-4 py-3 text-right">${formatNumber(listing.quantity)}</td>
                  <td class="px-4 py-3 text-right">${formatNumber(listing.reserved)}</td>
                  <td class="px-4 py-3 text-right font-semibold text-emerald-700">
                    ${formatNumber(listing.available_quantity)}
                  </td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        </div>
      `;

      const p = listingsState.pagination;
      listingsCount.textContent = p.total
        ? `${p.total} listing${p.total === 1 ? '' : 's'}`
        : '';

      window.lucide?.createIcons();
    }

    function renderListingsPagination() {
      const p = listingsState.pagination;
      const total = Number(p.total || 0);
      const page = Number(p.page || 1);
      const limit = Number(p.limit || listingsState.limit);
      const totalPages = Number(p.totalPages || 0);

      if (total === 0 || totalPages <= 1) {
        listingsPagination.innerHTML = '';
        return;
      }

      const from = (page - 1) * limit + 1;
      const to = Math.min(page * limit, total);

      const startPage = Math.max(1, Math.min(page - 2, totalPages - 4));
      const endPage = Math.min(totalPages, startPage + 4);

      let pageButtons = '';
      for (let i = startPage; i <= endPage; i++) {
        pageButtons += `
          <button type="button" data-listing-page="${i}"
            class="rounded-lg border px-3 py-1.5 text-sm ${
              i === page
                ? 'border-brand bg-brand text-white'
                : 'hover:bg-slate-50'
            }">
            ${i}
          </button>
        `;
      }

      listingsPagination.innerHTML = `
        <div class="flex flex-col items-center justify-between gap-3
          text-sm text-slate-500 sm:flex-row">
          <span>Showing ${from}–${to} of ${total} listings</span>
          <div class="flex flex-wrap justify-center gap-1">
            <button type="button" data-listing-page="${page - 1}"
              ${page <= 1 ? 'disabled' : ''}
              class="rounded-lg border px-3 py-1.5 ${
                page <= 1 ? 'cursor-not-allowed opacity-40' : 'hover:bg-slate-50'
              }">Prev</button>
            ${pageButtons}
            <button type="button" data-listing-page="${page + 1}"
              ${page >= totalPages ? 'disabled' : ''}
              class="rounded-lg border px-3 py-1.5 ${
                page >= totalPages ? 'cursor-not-allowed opacity-40' : 'hover:bg-slate-50'
              }">Next</button>
          </div>
        </div>
      `;
    }

    async function loadListings() {
      if (!listingsState.inventory) return;

      listingsState.loading = true;
      renderListings();
      renderListingsPagination();

      const params = new URLSearchParams({
        page: String(listingsState.page),
        limit: String(listingsState.limit)
      });

      if (listingsState.search) params.set('search', listingsState.search);

      try {
        const response = await axios.get(
          `/stores/<%-store.id%>/data/product-listing/inventories/${listingsState.inventory.id}`,
          {
            params,
            withCredentials: true
          }
        );

        const payload = response.data || {};
        listingsState.items = payload.data || [];
        listingsState.pagination = payload.pagination || {
          page: listingsState.page,
          limit: listingsState.limit,
          total: listingsState.items.length,
          totalPages: 1
        };
      } catch (error) {
        console.error('Failed to load listings:', error);
        listingsState.items = [];
        listingsState.pagination = {
          page: listingsState.page,
          limit: listingsState.limit,
          total: 0,
          totalPages: 0
        };

        Notification.showNotification?.({
          type: 'warning',
          message: error.response?.data?.message ||
            'Unable to load listings.'
        });
      } finally {
        listingsState.loading = false;
        renderListings();
        renderListingsPagination();
      }
    }

    /* ------------------------------------------------------------------ */
    /* Events                                                              */
    /* ------------------------------------------------------------------ */

    tbody.addEventListener('click', event => {
      const button = event.target.closest('[data-open-listings]');
      if (!button) return;

      const id = button.dataset.openListings;
      const inventory = state.inventories.find(item => String(item.id) === id);
      if (!inventory) return;

      openListingsModal(inventory);
    });

    paginationEl.addEventListener('click', event => {
      const button = event.target.closest('[data-page]');
      if (!button || button.disabled) return;

      const page = Number(button.dataset.page);

      if (
        page >= 1 &&
        page <= state.pagination.totalPages &&
        page !== state.page
      ) {
        state.page = page;
        load();
      }
    });

    listingsPagination.addEventListener('click', event => {
      const button = event.target.closest('[data-listing-page]');
      if (!button || button.disabled) return;

      const page = Number(button.dataset.listingPage);
      if (
        page >= 1 &&
        page <= listingsState.pagination.totalPages &&
        page !== listingsState.page
      ) {
        listingsState.page = page;
        loadListings();
      }
    });

    let listingsSearchDebounce;
    listingsSearch.addEventListener('input', event => {
      clearTimeout(listingsSearchDebounce);
      listingsSearchDebounce = setTimeout(() => {
        listingsState.search = event.target.value.trim();
        listingsState.page = 1;
        loadListings();
      }, 400);
    });

    // Close handlers
    listingsModal.addEventListener('click', event => {
      if (event.target.closest('[data-modal-close]')) {
        closeListingsModal();
      }
    });

    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && listingsState.open) {
        closeListingsModal();
      }
    });

    refreshBtn.addEventListener('click', () => {
      state.page = 1;
      state.search = '';
      state.status = '';
      state.stock = '';

      searchInput.value = '';
      statusSelect.value = '';
      stockSelect.value = '';

      load();
    });

    let searchDebounce;
    searchInput.addEventListener('input', event => {
      clearTimeout(searchDebounce);
      searchDebounce = setTimeout(() => {
        state.search = event.target.value.trim();
        state.page = 1;
        load();
      }, 400);
    });

    statusSelect.addEventListener('change', event => {
      state.status = event.target.value;
      state.page = 1;
      load();
    });

    stockSelect.addEventListener('change', event => {
      state.stock = event.target.value;
      state.page = 1;
      load();
    });

    load();
  });
</script>