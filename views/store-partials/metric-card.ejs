<%
  /**
   * Metric Card
   *
   * Props:
   *   label   string
   *   value   string | number
   *   change  string | null    ("+12.5%" | "-3.2%" | null)
   *   hint    string | null    (optional subtitle)
   *   icon    string           (lucide icon name)
   *   tone    string           ('brand' | 'violet' | 'emerald' | 'amber' | 'orange' | 'rose')
   */

  const tones = {
    brand:   'bg-[var(--color-brand-ultralight)] text-[var(--color-brand)]',
    violet:  'bg-violet-50 text-violet-600',
    emerald: 'bg-emerald-50 text-emerald-600',
    amber:   'bg-amber-50 text-amber-600',
    orange:  'bg-orange-50 text-orange-600',
    rose:    'bg-rose-50 text-rose-600',
  };
  const toneClass = tones[tone] || tones.brand;

  // Null-safe change handling
  const hasChange = typeof change !== 'undefined' && change !== null && change !== '';
  const changeIsNegative = hasChange && String(change).startsWith('-');
  const changeClass = changeIsNegative ? 'text-rose-600' : 'text-emerald-600';

  const hasHint = typeof hint !== 'undefined' && hint;
%>

<div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
  <div class="flex items-center justify-between">
    <span class="text-sm text-slate-500"><%= label %></span>
    <span class="rounded-lg p-2 <%= toneClass %>">
      <i data-lucide="<%= icon %>" class="h-4 w-4"></i>
    </span>
  </div>

  <div class="mt-4 text-2xl font-bold"><%= value %></div>

  <% if (hasChange) { %>
    <div class="mt-1 text-xs">
      <span class="font-semibold <%= changeClass %>"><%= change %></span>
      <span class="ml-1 text-slate-400">vs previous period</span>
    </div>
  <% } else if (hasHint) { %>
    <div class="mt-1 text-xs text-slate-400"><%= hint %></div>
  <% } %>
</div>