<!-- Page header -->
<div class="mb-6 flex flex-col justify-between gap-4 md:flex-row md:items-end">
  <div>
    <div class="mb-1 flex items-center gap-2 text-[var(--color-brand)]">
      <i data-lucide="list-checks" class="h-4 w-4"></i>
      <span class="text-sm font-semibold"><%= store.name %></span>
    </div>
    <h1 class="text-2xl font-bold tracking-tight">Listings</h1>
    <p class="mt-1 text-sm text-slate-500">
      Manage how your products appear in this store.
    </p>
  </div>
  <div class="flex gap-2">
    <button class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium hover:bg-slate-50">
      <i data-lucide="download" class="h-4 w-4"></i>Export
    </button>
    <a href="/cataloging/listing/<%=locals.store.id%>/new" target="_blank" class="inline-flex items-center gap-2 rounded-lg bg-[var(--color-brand)] px-3 py-2 text-sm font-semibold text-white hover:bg-[var(--color-brand-dark)]">
      <i data-lucide="plus" class="h-4 w-4"></i>New Listing
    </a>
  </div>
</div>

<!-- Search + filters -->
<div class="mb-5 flex flex-col gap-3 md:flex-row md:items-center">

  <!-- Search -->
  <div class="relative flex-1">
    <i data-lucide="search" class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"></i>
    <input type="search" id="listingsSearch" placeholder="Search listings by title, SKU, or product..." class="w-full rounded-lg border border-slate-200 bg-white py-2.5 pl-10 pr-4 text-sm outline-none transition focus:border-[var(--color-brand)] focus:ring-2 focus:ring-[var(--color-brand-light)]" autocomplete="off" />
  </div>

  <!-- Status filter -->
  <select id="listingsStatus" class="rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm outline-none transition focus:border-[var(--color-brand)]">
    <option value="">All statuses</option>
    <option value="active">Active</option>
    <option value="draft">Draft</option>
    <option value="archived">Archived</option>
  </select>

  <!-- Sort -->
  <select id="listingsSort" class="rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm outline-none transition focus:border-[var(--color-brand)]">
    <option value="updated_desc">Recently updated</option>
    <option value="updated_asc">Oldest first</option>
    <option value="title_asc">Title A → Z</option>
    <option value="title_desc">Title Z → A</option>
    <option value="stock_asc">Stock (low first)</option>
    <option value="stock_desc">Stock (high first)</option>
  </select>

  <!-- Per page -->
  <select id="listingsLimit" class="rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm outline-none transition focus:border-[var(--color-brand)]">
    <option value="12">12 / page</option>
    <option value="24" selected>24 / page</option>
    <option value="48">48 / page</option>
    <option value="96">96 / page</option>
  </select>
</div>

<!-- Results count -->
<div class="mb-4 flex items-center justify-between text-sm">
  <span id="listingsCount" class="text-slate-500">Loading…</span>
  <div id="listingsActiveFilters" class="flex items-center gap-2"></div>
</div>

<!-- Grid host -->
<div id="listingsGrid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
  <!-- Server-rendered cards OR skeletons on first paint -->
  <%
    const mockListings = [
      { id: 'a1b2c3d4-1111-4aaa-8bbb-000000000001', store_id: store.id, product_id: 'p-001', product_variant_id: 'v-001', title: 'iPhone 15 Pro Case — Black', product_name: 'iPhone 15 Pro Case', product_image: 'https://images.unsplash.com/photo-1601784551446-20c9e07cdbdb?w=600', variant_name: 'Black', sku: 'IP15P-BLK', price: 3500, currency: 'USD', stock: 42, status: 'active', updated_at: new Date().toISOString() },
      { id: 'a1b2c3d4-2222-4aaa-8bbb-000000000002', store_id: store.id, product_id: 'p-002', product_variant_id: 'v-002', title: 'USB-C Fast Charger 45W', product_name: 'USB-C Fast Charger', product_image: 'https://images.unsplash.com/photo-1583863788434-e58a36330cf0?w=600', variant_name: '45W', sku: 'USBC-45W', price: 2500, currency: 'USD', stock: 18, status: 'active', updated_at: new Date(Date.now() - 86400000).toISOString() },
      { id: 'a1b2c3d4-3333-4aaa-8bbb-000000000003', store_id: store.id, product_id: 'p-003', product_variant_id: null, title: 'Wireless Mouse', product_name: 'Wireless Mouse', product_image: null, variant_name: null, sku: 'WM-204', price: 2900, currency: 'USD', stock: 0, status: 'draft', updated_at: new Date(Date.now() - 86400000 * 3).toISOString() },
