        store_id: 'store-001',
        product_id: 'p-005',
        product_variant_id: 'v-005',
        title: 'Aluminium Laptop Stand',
        product_name: 'Aluminium Laptop Stand',
        product_image: 'https://images.unsplash.com/photo-1618384887929-16ec33fab9ef?w=600',
        variant_name: 'Silver',
        sku: 'LS-AL-SV',
        price: 4500,
        currency: 'USD',
        stock: 8,
