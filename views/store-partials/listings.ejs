      { id: 'a1b2c3d4-5555-4aaa-8bbb-000000000005', store_id: store.id, product_id: 'p-005', product_variant_id: 'v-005', title: 'Aluminium Laptop Stand', product_name: 'Aluminium Laptop Stand', product_image: 'https://images.unsplash.com/photo-1618384887929-16ec33fab9ef?w=600', variant_name: 'Silver', sku: 'LS-AL-SV', price: 4500, currency: 'USD', stock: 8, status: 'active', updated_at: new Date(Date.now() - 86400000 * 2).toISOString() },
      { id: 'a1b2c3d4-6666-4aaa-8bbb-000000000006', store_id: store.id, product_id: 'p-006', product_variant_id: null, title: 'Webcam 1080p HD', product_name: 'Webcam 1080p', product_image: 'https://images.unsplash.com/photo-1587829741301-dc798b83add3?w=600', variant_name: null, sku: 'WC-1080', price: 6500, currency: 'USD', stock: 0, status: 'archived', updated_at: new Date(Date.now() - 86400000 * 14).toISOString() },
    ];
  %>

  <div id="listingsGrid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"></div>
</div>

<!-- Pagination -->
<nav id="listingsPagination" class="mt-8 flex flex-col items-center justify-between gap-4 sm:flex-row" aria-label="Listings pagination">
  <p class="text-xs text-slate-500" id="listingsPageInfo">—</p>
  <div class="flex items-center gap-2" id="listingsPageControls"></div>
</nav>

