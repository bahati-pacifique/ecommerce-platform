<%
  /**
   * Store Review Component — 2-column top/bottom, 4-column middle
   */

  const r = review || {};

  const rating      = r.rating   || { average: 0, total: 0, breakdown: {} };
  const visits      = r.visits   || { total: 0, change_pct: 0, weekly: [] };
  const search      = r.search_appearances || { total: 0, change_pct: 0 };
  const topListing  = r.most_visited_listing || null;
  const followers   = r.followers || { total: 0, change_pct: 0, new_this_week: 0 };
  const response    = r.response || { rate: 0, avg_minutes: 0 };
  const conversion  = r.conversion || { rate: 0, change_pct: 0 };
  const topListings = Array.isArray(r.top_listings) ? r.top_listings : [];

  // ─── Helpers ─────────────────────────────────────────────
  const fmtNum = (n) => Number(n || 0).toLocaleString();
  const fmtPct = (n) => `${n >= 0 ? '+' : ''}${Number(n || 0).toFixed(1)}%`;
  const pctTone = (n) => n >= 0 ? 'text-emerald-600' : 'text-rose-600';

  const DAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  const weeklyRaw = Array.isArray(visits.weekly) ? visits.weekly : [];
  const weekly = DAYS.map((day, i) => {
    const entry = weeklyRaw[i] || weeklyRaw.find(w => w.day === day) || { day, visits: 0 };
    return { day, visits: Number(entry.visits || 0) };
  });

  const maxVisits = Math.max(...weekly.map(w => w.visits), 1);

  const W = 700, H = 220, PAD = { top: 16, right: 16, bottom: 32, left: 44 };
  const innerW = W - PAD.left - PAD.right;
  const innerH = H - PAD.top - PAD.bottom;

  const xAt = (i) => PAD.left + (innerW / (weekly.length - 1)) * i;
  const yAt = (v) => PAD.top + innerH - (v / maxVisits) * innerH;

  const points = weekly.map((w, i) => `${xAt(i).toFixed(1)},${yAt(w.visits).toFixed(1)}`).join(' ');
  const areaPoints = `${PAD.left},${PAD.top + innerH} ${points} ${PAD.left + innerW},${PAD.top + innerH}`;

  const ticks = Array.from({ length: 5 }, (_, i) => {
    const v = Math.round((maxVisits / 4) * i);
    return { v, y: yAt(v) };
  });

  const ratingStars = (avg) => {
    const full = Math.floor(avg);
    const half = avg - full >= 0.5;
    let html = '';
    for (let i = 0; i < 5; i++) {
      if (i < full) html += '<span class="text-yellow-500">★</span>';
      else if (i === full && half) html += '<span class="text-yellow-500">★</span>';
      else html += '<span class="text-slate-300">★</span>';
    }
    return html;
  };
%>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- Section header                                              -->
<!-- ═══════════════════════════════════════════════════════════ -->
<div class="mb-5 flex items-end justify-between">
  <div>
    <h2 class="text-lg font-bold tracking-tight text-slate-900">Store Review</h2>
    <p class="text-sm text-slate-500">Performance overview and visitor insights</p>
  </div>
  <select class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-medium text-slate-600 outline-none focus:border-[var(--color-brand)]">
    <option>Last 7 days</option>
    <option>Last 30 days</option>
    <option>Last 90 days</option>
  </select>
</div>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- ROW 1 — Store visits (chart) + Store rating (2 columns)     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<div class="grid gap-4 lg:grid-cols-2">

  <!-- ── Store visits card ── -->
  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">

    <div class="mb-4 flex flex-wrap items-start justify-between gap-3">
      <div>
        <div class="flex items-center gap-2 text-sm text-slate-500">
          <i data-lucide="eye" class="h-4 w-4"></i>
          <span>Store visits — this week</span>
        </div>
        <div class="mt-2 flex items-baseline gap-2">
          <span class="text-3xl font-bold text-slate-900"><%= fmtNum(visits.total) %></span>
          <span class="text-sm font-semibold <%= pctTone(visits.change_pct) %>">
            <%= fmtPct(visits.change_pct) %>
          </span>
          <span class="text-xs text-slate-400">vs last week</span>
        </div>
      </div>

      <div class="flex items-center gap-3 text-xs text-slate-500">
        <span class="inline-flex items-center gap-1.5">
          <span class="h-2.5 w-2.5 rounded-full bg-[var(--color-brand)]"></span>
          Visits
        </span>
        <span class="inline-flex items-center gap-1.5">
          <span class="h-2.5 w-2.5 rounded-full bg-slate-300"></span>
          Previous
        </span>
      </div>
    </div>

    <div class="relative">
      <svg viewBox="0 0 <%= W %> <%= H %>" preserveAspectRatio="none" class="h-52 w-full">
        <% ticks.forEach(t => { %>
          <line
            x1="<%= PAD.left %>" y1="<%= t.y %>"
            x2="<%= W - PAD.right %>" y2="<%= t.y %>"
            stroke="#E2E8F0" stroke-width="1"
          />
          <text
            x="<%= PAD.left - 8 %>" y="<%= t.y + 3 %>"
            text-anchor="end" font-size="10" fill="#94A3B8"
          ><%= fmtNum(t.v) %></text>
        <% }) %>

        <polygon points="<%= areaPoints %>" fill="url(#visitAreaGradient)" opacity="0.35" />

        <polyline
          points="<%= points %>"
          fill="none"
          stroke="var(--color-brand)"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
        />

        <% weekly.forEach((w, i) => { %>
          <circle
            cx="<%= xAt(i) %>" cy="<%= yAt(w.visits) %>" r="4"
            fill="#fff" stroke="var(--color-brand)" stroke-width="2.5"
          />
        <% }) %>

        <% weekly.forEach((w, i) => { %>
          <text
            x="<%= xAt(i) %>" y="<%= H - 10 %>"
            text-anchor="middle" font-size="11" fill="#64748B"
          ><%= w.day %></text>
        <% }) %>

        <defs>
          <linearGradient id="visitAreaGradient" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="var(--color-brand)" stop-opacity="0.5" />
            <stop offset="100%" stop-color="var(--color-brand)" stop-opacity="0" />
          </linearGradient>
        </defs>
      </svg>
    </div>

    <div class="mt-4 grid grid-cols-3 gap-3 border-t border-slate-100 pt-4">
      <div>
        <div class="text-xs text-slate-500">Peak day</div>
        <div class="mt-0.5 text-sm font-semibold text-slate-900">
          <%= weekly.reduce((m, w) => (w.visits > m.visits ? w : m), weekly[0]).day %>
        </div>
      </div>
      <div>
        <div class="text-xs text-slate-500">Daily avg.</div>
        <div class="mt-0.5 text-sm font-semibold text-slate-900">
          <%= fmtNum(Math.round(visits.total / 7)) %>
        </div>
      </div>
      <div>
        <div class="text-xs text-slate-500">Best hour</div>
        <div class="mt-0.5 text-sm font-semibold text-slate-900">14:00 – 16:00</div>
      </div>
    </div>
  </div>

  <!-- ── Store rating card ── -->
  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-center justify-between">
      <span class="text-sm text-slate-500">Store rating</span>
      <span class="rounded-lg bg-yellow-50 p-2 text-yellow-600">
        <i data-lucide="star" class="h-4 w-4"></i>
      </span>
    </div>

    <div class="mt-4 flex items-baseline gap-2">
      <span class="text-3xl font-bold text-slate-900"><%= rating.average.toFixed(1) %></span>
      <span class="text-sm text-slate-400">/ 5</span>
    </div>

    <div class="mt-1 text-sm tracking-wide">
      <%- ratingStars(rating.average) %>
      <span class="ml-1 text-xs text-slate-400">(<%= fmtNum(rating.total) %> reviews)</span>
    </div>

    <div class="mt-4 space-y-1.5">
      <% [5, 4, 3, 2, 1].forEach(star => {
           const count = rating.breakdown?.[star] || 0;
           const pct = rating.total ? Math.round((count / rating.total) * 100) : 0;
      %>
        <div class="flex items-center gap-2 text-xs">
          <span class="w-6 text-right text-slate-500"><%= star %>★</span>
          <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-slate-100">
            <div class="h-full rounded-full bg-yellow-400" style="width: <%= pct %>%"></div>
          </div>
          <span class="w-8 text-right font-medium text-slate-600"><%= pct %>%</span>
        </div>
      <% }) %>
    </div>

    <div class="mt-4 border-t border-slate-100 pt-3">
      <div class="grid grid-cols-2 gap-3 text-xs">
        <div>
          <div class="text-slate-500">This month</div>
          <div class="mt-0.5 text-sm font-semibold text-emerald-600">+42 reviews</div>
        </div>
        <div>
          <div class="text-slate-500">Response rate</div>
          <div class="mt-0.5 text-sm font-semibold text-slate-900">96%</div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="mt-4 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-center justify-between">
      <span class="text-sm text-slate-500">Search appearances</span>
      <span class="rounded-lg bg-violet-50 p-2 text-violet-600">
        <i data-lucide="search" class="h-4 w-4"></i>
      </span>
    </div>
    <div class="mt-4 text-2xl font-bold text-slate-900"><%= fmtNum(search.total) %></div>
    <div class="mt-1 text-xs">
      <span class="font-semibold <%= pctTone(search.change_pct) %>"><%= fmtPct(search.change_pct) %></span>
      <span class="ml-1 text-slate-400">vs previous</span>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-center justify-between">
      <span class="text-sm text-slate-500">Followers</span>
      <span class="rounded-lg bg-[var(--color-brand-ultralight)] p-2 text-[var(--color-brand)]">
        <i data-lucide="users" class="h-4 w-4"></i>
      </span>
    </div>
    <div class="mt-4 text-2xl font-bold text-slate-900"><%= fmtNum(followers.total) %></div>
    <div class="mt-1 text-xs">
      <span class="font-semibold <%= pctTone(followers.change_pct) %>"><%= fmtPct(followers.change_pct) %></span>
      <span class="ml-1 text-slate-400">· +<%= followers.new_this_week %> this week</span>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-center justify-between">
      <span class="text-sm text-slate-500">Response rate</span>
      <span class="rounded-lg bg-emerald-50 p-2 text-emerald-600">
        <i data-lucide="message-circle" class="h-4 w-4"></i>
      </span>
    </div>
    <div class="mt-4 text-2xl font-bold text-slate-900"><%= response.rate %>%</div>
    <div class="mt-1 text-xs text-slate-400">Avg. reply in <%= response.avg_minutes %> min</div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-center justify-between">
      <span class="text-sm text-slate-500">Conversion rate</span>
      <span class="rounded-lg bg-amber-50 p-2 text-amber-600">
        <i data-lucide="percent" class="h-4 w-4"></i>
      </span>
    </div>
    <div class="mt-4 text-2xl font-bold text-slate-900"><%= conversion.rate %>%</div>
    <div class="mt-1 text-xs">
      <span class="font-semibold <%= pctTone(conversion.change_pct) %>"><%= fmtPct(conversion.change_pct) %></span>
      <span class="ml-1 text-slate-400">vs previous</span>
    </div>
  </div>
</div>


<div class="mt-4 grid gap-4 lg:grid-cols-2">

  <% if (topListing) { %>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-center justify-between">
        <span class="text-sm text-slate-500">Most visited listing</span>
        <span class="rounded-lg bg-[var(--color-brand-ultralight)] p-2 text-[var(--color-brand)]">
          <i data-lucide="trending-up" class="h-4 w-4"></i>
        </span>
      </div>

      <div class="mt-4 flex items-start gap-3">
        <% if (topListing.image) { %>
          <img
            src="<%= topListing.image %>"
            alt="<%= topListing.title %>"
            class="h-16 w-16 shrink-0 rounded-lg object-cover ring-1 ring-slate-200"
            data-fallback-hide="true"
          />
          <div class="hidden h-16 w-16 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-400 ring-1 ring-slate-200">
            <i data-lucide="package" class="h-6 w-6"></i>
          </div>
        <% } else { %>
          <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-400 ring-1 ring-slate-200">
            <i data-lucide="package" class="h-6 w-6"></i>
          </div>
        <% } %>

        <div class="min-w-0 flex-1">
          <h3 class="line-clamp-2 text-sm font-semibold text-slate-900" title="<%= topListing.title %>">
            <%= topListing.title %>
          </h3>
          <div class="mt-1 flex items-center gap-2 text-xs text-slate-500">
            <span class="font-mono text-[10px]">#<%= String(topListing.id).slice(0, 8) %></span>
            <span class="text-slate-300">·</span>
            <span class="font-semibold text-emerald-600"><%= fmtPct(topListing.change_pct) %></span>
          </div>
        </div>
      </div>

      <dl class="mt-4 grid grid-cols-3 gap-3 border-t border-slate-100 pt-3 text-xs">
        <div>
          <dt class="text-slate-400">Visits</dt>
          <dd class="mt-0.5 text-base font-bold text-slate-900"><%= fmtNum(topListing.visits) %></dd>
        </div>
        <div>
          <dt class="text-slate-400">CTR</dt>
          <dd class="mt-0.5 text-base font-bold text-slate-900"><%= topListing.ctr %>%</dd>
        </div>
        <div>
          <dt class="text-slate-400">Trend</dt>
          <dd class="mt-0.5 text-base font-bold <%= pctTone(topListing.change_pct) %>">
            <%= fmtPct(topListing.change_pct) %>
          </dd>
        </div>
      </dl>

      <a
        href="/stores/<%= store.id %>/listings/<%= topListing.id %>"
        class="mt-4 inline-flex w-full items-center justify-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"
      >
        <i data-lucide="external-link" class="h-3.5 w-3.5"></i>
        View listing
      </a>
    </div>
  <% } %>

  <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
    <div class="flex items-center justify-between border-b border-slate-100 p-5">
      <div>
        <h2 class="font-semibold text-slate-900">Top listings this week</h2>
        <p class="text-xs text-slate-500">By total visits</p>
      </div>
      <a
        href="/stores/<%= store.id %>/listings"
        class="text-sm font-semibold text-[var(--color-brand)] hover:text-[var(--color-brand-dark)]"
      >
        View all
      </a>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
          <tr>
            <th class="px-5 py-3">Listing</th>
            <th class="px-5 py-3 text-right">Visits</th>
            <th class="px-5 py-3 text-right">CTR</th>
            <th class="px-5 py-3 text-right">Orders</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (!topListings.length) { %>
            <tr>
              <td colspan="4" class="px-5 py-10 text-center text-sm text-slate-400">
                No listings data yet.
              </td>
            </tr>
          <% } else { %>
            <% topListings.forEach(l => { %>
              <tr class="hover:bg-slate-50">
                <td class="px-5 py-3">
                  <div class="flex items-center gap-2.5">
                    <% if (l.image) { %>
                      <img
                        src="<%= l.image %>"
                        alt=""
                        class="h-8 w-8 shrink-0 rounded object-cover ring-1 ring-slate-200"
                        data-fallback-hide="true"
                      />
                      <div class="hidden h-8 w-8 shrink-0 items-center justify-center rounded bg-slate-100 text-slate-400 ring-1 ring-slate-200">
                        <i data-lucide="package" class="h-3.5 w-3.5"></i>
                      </div>
                    <% } %>
                    <span class="truncate font-medium text-slate-800" title="<%= l.title %>">
                      <%= l.title %>
                    </span>
                  </div>
                </td>
                <td class="px-5 py-3 text-right font-medium text-slate-700"><%= fmtNum(l.visits) %></td>
                <td class="px-5 py-3 text-right text-slate-600"><%= l.ctr %>%</td>
                <td class="px-5 py-3 text-right text-slate-600"><%= fmtNum(l.orders) %></td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>