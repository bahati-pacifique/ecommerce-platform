<script>
  window.__PRICES__ = {
    storeId: "<%= store.id %>",
    listingId: "<%= listingId %>",
    variantId: "<%= variantId %>",
    baseUrl: "<%= locals.baseUrl %>",
  };
</script>
<%- include('./header', {sidebarToggerVisibility: 'hidden', mobileMenuButtonVisibility: 'hidden', subTitle: store.name }) %>
<div class="mx-auto w-full max-w-7xl px-4 py-4 sm:px-6 sm:py-6 lg:px-8">

  <nav aria-label="Breadcrumb" class="mb-3 flex flex-wrap items-center gap-1.5 text-xs text-slate-500">
    <a href="/stores/<%= store.id %>/listings" class="hover:text-brand">Listings</a>
    <span class="text-slate-300">/</span>
    <a href="/stores/<%= store.id %>/listings/<%= listingId %>" class="hover:text-brand">Listing</a>
    <span class="text-slate-300">/</span>
    <span class="truncate font-medium text-slate-900">Pricing</span>
  </nav>

  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div class="flex items-start gap-3">
      <img id="variantImage" src="" alt="" class="hidden h-20 w-20 shrink-0 rounded-lg object-contain ring-1 ring-slate-200">
      <div class="min-w-0">
        <h1 class="text-xl font-bold tracking-tight text-slate-950 sm:text-2xl">Pricing</h1>
        <p class="mt-1 truncate text-sm text-slate-500">
          <span id="variantSku" class="font-mono">—</span>
          · <span id="variantTitle">Loading…</span>
        </p>
      </div>
    </div>

    <button type="button" id="openAddPrice" disabled class="inline-flex shrink-0 items-center justify-center gap-2 rounded-lg bg-brand px-4 py-2.5 text-sm font-bold text-white transition hover:bg-brand-dark disabled:cursor-not-allowed disabled:opacity-50">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14M5 12h14" />
      </svg>
      Add new price
    </button>
  </div>

  <!-- ═══════════════════════════════════════════════════
       LOADING STATE
  ════════════════════════════════════════════════════ -->
  <div id="pricesLoading" class="animate-pulse">
    <!-- Summary cards -->
    <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <div class="h-2.5 w-24 rounded bg-slate-200"></div>
        <div class="mt-3 h-7 w-32 rounded bg-slate-200"></div>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <div class="h-2.5 w-16 rounded bg-slate-200"></div>
        <div class="mt-3 h-5 w-12 rounded bg-slate-200"></div>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <div class="h-2.5 w-20 rounded bg-slate-200"></div>
        <div class="mt-3 h-4 w-32 rounded bg-slate-200"></div>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <div class="h-2.5 w-16 rounded bg-slate-200"></div>
        <div class="mt-3 h-4 w-24 rounded bg-slate-200"></div>
      </div>
    </div>

    <div class="mt-5 rounded-xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-100 px-4 py-3 sm:px-5">
        <div class="h-4 w-32 rounded bg-slate-200"></div>
        <div class="mt-1 h-3 w-24 rounded bg-slate-200"></div>
      </div>

      <div class="divide-y divide-slate-100">
        <% for (let i = 0; i < 3; i++) { %>
        <div class="flex items-center gap-4 px-5 py-4">
          <div class="h-2 w-2 rounded-full bg-slate-200"></div>
          <div class="h-4 w-10 rounded bg-slate-200"></div>
          <div class="h-4 w-24 rounded bg-slate-200"></div>
          <div class="h-4 w-20 rounded bg-slate-200"></div>
          <div class="h-4 w-40 rounded bg-slate-200"></div>
          <div class="ml-auto h-8 w-20 rounded bg-slate-200"></div>
        </div>
        <% } %>
      </div>
    </div>
  </div>

  <div id="pricesError" class="mt-5 hidden rounded-2xl border border-rose-200 bg-white p-6 text-center shadow-sm sm:p-8">
    <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-rose-50">
      <svg class="h-7 w-7 text-rose-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" />
      </svg>
    </div>
    <h2 class="mt-4 text-lg font-bold text-slate-900">Couldn't load prices</h2>
    <p id="pricesErrorMsg" class="mt-2 text-sm text-slate-500">Something went wrong.</p>
    <div class="mt-6 flex flex-col justify-center gap-2 sm:flex-row">
      <button type="button" id="pricesRetry" class="rounded-lg bg-brand px-5 py-2.5 text-sm font-bold text-white transition hover:bg-brand-dark">
        Try again
      </button>
      <a href="/stores/<%= store.id %>/listings/<%= listingId %>" class="rounded-lg border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">
        Back to listing
      </a>
    </div>
  </div>

  <div id="pricesContent" class="hidden opacity-0">

    <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-xl border border-green-800 bg-green-50 text-green-800 p-4 shadow-sm ">
        <p class="text-[10px] font-bold uppercase tracking-wider">Current price</p>
        <p id="currentPriceValue" class="mt-1.5 text-2xl font-extrabold">—</p>
        <p id="currentSaleBadge" class="mt-1 hidden items-center gap-1.5 text-xs"></p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Currency</p>
        <p id="currentCurrency" class="mt-1.5 text-lg font-bold text-slate-950">—</p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Effective from</p>
        <p id="currentStartsAt" class="mt-1.5 text-sm font-semibold text-slate-950">—</p>
      </div>
      <div class="rounded-xl border border-red-800 bg-red-50 p-4 shadow-sm">
        <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Ends</p>
        <p id="currentEndsAt" class="mt-1.5 text-sm font-semibold text-slate-950">—</p>
      </div>
    </div>

    <div class="mt-5 rounded-xl border border-slate-200 bg-white shadow-sm">

      <div class="flex items-center justify-between border-b border-slate-100 px-4 py-3 sm:px-5">
        <div>
          <h2 class="text-sm font-bold text-slate-900">Price history</h2>
          <p id="pricesCount" class="mt-0.5 text-xs text-slate-500">—</p>
        </div>
      </div>

      <div id="pricesEmpty" class="hidden px-4 py-16 text-center sm:px-5">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-slate-100">
          <svg class="h-6 w-6 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <p class="mt-3 text-sm font-semibold text-slate-900">No prices yet</p>
        <p class="mt-1 text-xs text-slate-500">Add a price to make this variant purchasable.</p>
        <button type="button" data-open-add-price class="mt-4 inline-flex items-center gap-2 rounded-lg bg-brand px-4 py-2 text-sm font-bold text-white hover:bg-brand-dark">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14M5 12h14" />
          </svg>
          Add the first price
        </button>
      </div>

      <div id="pricesTableWrap" class="hidden overflow-x-auto lg:block">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-50 text-[10px] uppercase tracking-wider text-slate-500">
            <tr>
              <th class="px-5 py-3 font-semibold"></th>
              <th class="px-5 py-3 font-semibold">Price</th>
              <th class="px-5 py-3 font-semibold">Sale price</th>
              <th class="px-5 py-3 font-semibold">Period</th>
              <th class="px-5 py-3 font-semibold">Status</th>
              <th class="px-5 py-3 text-right font-semibold">Actions</th>
            </tr>
          </thead>
          <tbody id="pricesTableBody" class="divide-y divide-slate-100"></tbody>
        </table>
      </div>

      <div id="pricesMobileList" class="divide-y divide-slate-100 lg:hidden"></div>
    </div>
  </div>
</div>

<div id="addPriceModal" class="fixed inset-0 z-[60] hidden items-end justify-center bg-slate-950/50 p-0 backdrop-blur-sm sm:items-center sm:p-4" role="dialog" aria-modal="true" aria-labelledby="addPriceTitle">

  <div id="addPriceBackdrop" class="absolute inset-0" aria-hidden="true"></div>

  <div class="relative w-full max-w-lg overflow-hidden rounded-t-2xl bg-white shadow-2xl sm:rounded-2xl">
    <div class="h-1 w-full bg-gradient-to-r from-brand via-brand-dark to-brand"></div>

    <div class="max-h-[90vh] overflow-y-auto p-5 sm:p-6">

      <div class="flex items-start justify-between gap-3">
        <div>
          <h2 id="addPriceTitle" class="text-lg font-bold text-slate-950">Add a new price</h2>
          <p class="mt-0.5 text-xs text-slate-500">
            For <span id="modalVariantSku" class="font-mono">variant</span>
          </p>
        </div>
        <button type="button" id="closeAddPrice" aria-label="Close" class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-slate-500 hover:bg-slate-100">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div id="addPriceError" class="mt-4 hidden rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-700" role="alert"></div>

      <form id="addPriceForm" class="mt-5 space-y-4" novalidate>

        <div>
          <label for="currency_id" class="mb-1 block text-xs font-bold uppercase tracking-wider text-slate-500">
            Currency
          </label>
          <select id="currency_id" name="currency_id" required class="h-10 w-full rounded-lg border border-slate-200 bg-white px-3 text-sm outline-none focus:border-brand focus:ring-2 focus:ring-brand/20">
          </select>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="price" class="mb-1 block text-xs font-bold uppercase tracking-wider text-slate-500">
              Regular price
            </label>
            <input id="price" name="price" type="number" step="0.01" min="0" required class="h-10 w-full rounded-lg border border-slate-200 bg-white px-3 text-sm outline-none focus:border-brand focus:ring-2 focus:ring-brand/20" placeholder="0.00">
            <p class="mt-1 hidden text-xs text-brand" data-error-for="price"></p>
          </div>
          <div>
            <label for="sale_price" class="mb-1 block text-xs font-bold uppercase tracking-wider text-slate-500">
              Sale price <span class="font-normal normal-case text-slate-400" id="salePriceModalTag"></span>
            </label>
            <input id="sale_price" name="sale_price" type="number" step="0.01" min="0" class="h-10 w-full rounded-lg border border-slate-200 bg-white px-3 text-sm outline-none focus:border-brand focus:ring-2 focus:ring-brand/20" placeholder="Leave empty if none">
            <p class="mt-1 hidden text-xs text-brand" data-error-for="sale_price"></p>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <div>
            <label for="starts_at" class="mb-1 block text-xs font-bold uppercase tracking-wider text-slate-500">
              Starts at
            </label>
            <input id="starts_at" name="starts_at" type="datetime-local" class="h-10 w-full rounded-lg border border-slate-200 bg-white px-3 text-sm outline-none focus:border-brand focus:ring-2 focus:ring-brand/20">
            <p class="mt-1 text-[10px] text-slate-400">Leave empty to start now</p>
            <p class="mt-1 hidden text-xs text-brand" data-error-for="starts_at"></p>
          </div>
          <div>
            <label for="ends_at" class="mb-1 block text-xs font-bold uppercase tracking-wider text-slate-500">
              Ends at <span class="font-normal normal-case text-slate-400">(optional)</span>
            </label>
            <input id="ends_at" name="ends_at" type="datetime-local" class="h-10 w-full rounded-lg border border-slate-200 bg-white px-3 text-sm outline-none focus:border-brand focus:ring-2 focus:ring-brand/20">
            <p class="mt-1 text-[10px] text-slate-400">Leave empty for no end date</p>
            <p class="mt-1 hidden text-xs text-brand" data-error-for="ends_at"></p>
          </div>
        </div>

        <div>
          <label for="status" class="mb-1 block text-xs font-bold uppercase tracking-wider text-slate-500">
            Status
          </label>
          <select id="status" name="status" class="h-10 w-full rounded-lg border border-slate-200 bg-white px-3 text-sm outline-none focus:border-brand focus:ring-2 focus:ring-brand/20">
            <option value="active" selected>Active (visible to buyers)</option>
            <option value="inactive">Inactive (draft)</option>
          </select>
        </div>

        <div class="flex flex-col-reverse gap-2 pt-2 sm:flex-row sm:justify-end">
          <button type="button" id="cancelAddPrice" class="rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">
            Cancel
          </button>
          <button type="submit" id="submitAddPrice" class="rounded-lg bg-brand px-5 py-2.5 text-sm font-bold text-white transition hover:bg-brand-dark disabled:cursor-not-allowed disabled:opacity-60">
            <span id="submitAddPriceText">Add price</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer', 
{
  baseUrl: `/stores/${locals.store?.id}/dashboard`, 
  navs: [
  {link: `/stores/${locals.store?.id}/dashboard/listings`, title: 'Listings'}, 
  {link: `/stores/${locals.store?.id}/dashboard/inventory`, title: 'Inventory'},
  {link: `/dashboard`, title: 'Store'},
  {link: `/dashboard`, title: 'Vendor'},
  ]
}) %>

<script>
  // Legacy globals if any page template uses them
  const _LISTING_ID = "<%= listingId %>";
  const _STORE_ID = "<%= store.id %>";
  const _VARIANT_ID = "<%= variantId %>";
</script>

<script src="/scripts/pages/listing-prices.js" type="module"></script>