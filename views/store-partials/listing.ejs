<!-- JSON-LD -->
<script type="application/ld+json" id="listingJsonLd">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Loading…"
  }
</script>

<script>
  const _LISTING_ID = "<%= locals.listingId %>";
  const _STORE_ID   = "<%= locals.store?.id %>";
</script>
<script src="/scripts/shell.js" type="module"></script>
<script src="/scripts/pages/listing.js" type="module"></script>