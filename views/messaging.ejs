<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>COCOCE — Messages</title>

  <meta name="description" content="COCOCE — Messaging Store Center.">
  <link rel="icon" href="/favicon.ico" type="image/x-icon">

  <meta property="og:image" content="https://cdn.cococe.rw/branding/brand/logos/cococe.png">
  <meta property="og:url" content="https://www.cococe.rw">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Laptops, Printers, Accessories, Game consoles, Electronics, and much more, cococe, your wish our priority">
  <meta property="og:description" content="COCOCE Kigali Rwanda, Laptops, Desktops, Computer accessories, Smart tv, projectors, discover what you want about digital assets near you at Kigali">
  <meta property="og:logo" content="https://cdn.cococe.rw/branding/brand/logos/cococe.png" />
  <meta name="twitter:card" content="https://cdn.cococe.rw/branding/brand/logos/cococe.png">
  <meta property="twitter:domain" content="https://cococe.rw">
  <meta property="twitter:url" content="https://cococe.rw">
  <meta name="twitter:title" content="Laptops, Printers, Accessories, Game consoles, Electronics, and much more, cococe, your wish our priority">
  <meta name="twitter:description" content="COCOCE Kigali Rwanda, Laptops, Desktops, Computer accessories, Smart tv, projectors, discover what you want about digital assets near you at Kigali">

  <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.11.0/axios.min.js" integrity="sha512-h9644v03pHqrIHThkvXhB2PJ8zf5E9IyVnrSfZg8Yj8k4RsO4zldcQc4Bi9iVLUCCsqNY0b4WXVV4UB+wbWENA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

  <script src="https://code.jquery.com/jquery-3.7.1.js" integrity="sha256-eKhayi8LEQwp4NKxN+CfCh+3qOVUtJn3QNZ0TciWLP4=" crossorigin="anonymous"></script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>

  <link rel="stylesheet" href="/styles/components/notification.css">
  <link rel="stylesheet" href="/styles/components/main-snackbar.css">
  <link rel="stylesheet" href="/styles/components/loaders.css">
  <link rel="stylesheet" href="/styles/components/animations.css">
  <link rel="stylesheet" href="/styles/main.css">

  <style>
    .scroll-thin::-webkit-scrollbar {
      width: 6px;
    }

    .scroll-thin::-webkit-scrollbar-thumb {
      background: #d1d5db;
      border-radius: 3px;
    }

    .scroll-thin::-webkit-scrollbar-track {
      background: transparent;
    }
  </style>
</head>

<body class="h-screen overflow-hidden bg-gray-50 text-gray-900 font-sans">
  <div id="app" class="grid grid-cols-1 md:grid-cols-[340px_1fr] h-screen bg-white">

    <!-- ================= LEFT: SIDEBAR ================= -->
    <aside id="sidebar" class="flex flex-col border-r border-gray-200 min-h-0 bg-white">
      <header class="p-4 border-b border-gray-200">
        <div class="flex items-center justify-between mb-3">
          <h1 class="text-xl font-bold flex items-center gap-2">
            <img src="/images/logos/fav.png" alt="COCOCE" class="w-8 h-8">
            <%=locals.user.username%>
          </h1>
          <button id="newChatBtn" class="w-9 h-9 rounded-full flex items-center justify-center text-gray-500 hover:bg-gray-100 hover:text-gray-900 transition" aria-label="New message">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 5v14M5 12h14" />
            </svg>
          </button>
        </div>

        <div class="flex items-center gap-2 px-3 py-2 bg-gray-50 rounded-[10px] text-gray-500 focus-within:ring-2 focus-within:ring-brand/30">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.35-4.35" />
          </svg>
          <input id="searchInput" type="text" placeholder="Search conversations..." class="flex-1 bg-transparent outline-none text-sm text-gray-900 placeholder:text-gray-400" />
          <button id="clearSearch" class="hidden text-gray-400 hover:text-gray-700" aria-label="Clear">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 6 6 18M6 6l12 12" />
            </svg>
          </button>
        </div>
      </header>

      <!-- Filters -->
      <nav id="filterNav" class="flex gap-1.5 px-4 py-3 border-b border-gray-200">
        <button class="filter-btn px-3.5 py-1.5 rounded-full text-[13px] font-medium transition bg-brand text-white" data-filter="all">
          All <span class="opacity-80" data-count="all"></span>
        </button>
        <button class="filter-btn px-3.5 py-1.5 rounded-full text-[13px] font-medium transition text-gray-500 hover:bg-gray-100" data-filter="unread">
          Unread <span class="opacity-80" data-count="unread"></span>
        </button>
        <button class="filter-btn px-3.5 py-1.5 rounded-full text-[13px] font-medium transition text-gray-500 hover:bg-gray-100" data-filter="archived">
          Archived <span class="opacity-80" data-count="archived"></span>
        </button>
      </nav>

      <!-- Chat list -->
      <div id="chatList" class="flex-1 overflow-y-auto min-h-0 scroll-thin"></div>

      <!-- Empty filtered state -->
      <div id="listEmpty" class="hidden flex-1 flex-col items-center justify-center gap-2 text-center p-6 text-gray-500">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-gray-300">
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.35-4.35" />
        </svg>
        <p class="text-sm">No conversations match</p>
      </div>
    </aside>

    <!-- ================= RIGHT: CONVERSATION ================= -->
    <main id="conversationPanel" class="hidden md:flex flex-col min-h-0 bg-gray-50">

      <!-- Empty state -->
      <div id="emptyState" class="flex-1 flex flex-col items-center justify-center gap-3 text-gray-500 text-center p-6">
        <div class="text-gray-300 mb-2">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
          </svg>
        </div>
        <h2 class="text-lg font-semibold text-gray-900">Select a conversation</h2>
        <p class="text-sm">Choose a chat from the list to start messaging</p>
      </div>

      <!-- Active conversation -->
      <div id="conversation" class="hidden flex-col h-full min-h-0">

        <header class="flex items-center gap-3 px-5 h-16 bg-white border-b border-gray-200 shrink-0">
          <button id="backBtn" class="hidden w-9 h-9 rounded-full items-center justify-center text-gray-500 hover:bg-gray-100 transition" aria-label="Back">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 12H5M12 19l-7-7 7-7" />
            </svg>
          </button>

          <div id="convAvatar" class="w-[42px] h-[42px] rounded-full flex items-center justify-center font-semibold text-white text-[15px]"></div>

          <div class="flex-1 min-w-0">
            <h2 id="convName" class="text-[15px] font-semibold truncate"></h2>
            <span id="convStatus" class="text-xs text-gray-500"></span>
          </div>

          <div class="flex gap-1">
            <button class="w-9 h-9 rounded-full flex items-center justify-center text-gray-500 hover:bg-gray-100 hover:text-gray-900 transition" aria-label="Call">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
              </svg>
            </button>

            <!-- Chat action menu trigger -->
            <div class="relative">
              <button id="menuBtn" class="w-9 h-9 rounded-full flex items-center justify-center text-gray-500 hover:bg-gray-100 hover:text-gray-900 transition" aria-label="More" aria-haspopup="true" aria-expanded="false">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="1" />
                  <circle cx="19" cy="12" r="1" />
                  <circle cx="5" cy="12" r="1" />
                </svg>
              </button>

              <!-- Popup menu -->
              <div id="chatMenu" class="hidden absolute right-0 top-11 z-20 w-48 bg-white rounded-xl shadow-lg border border-gray-200 py-1 animate-popIn origin-top-right">
                <button data-action="mark-unread" class="w-full flex items-center gap-3 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10" />
                    <path d="M12 8v4l3 2" />
                  </svg>
                  Mark as unread
                </button>
                <button data-action="mute" class="w-full flex items-center gap-3 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
                    <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
                  </svg>
                  Mute notifications
                </button>
                <button data-action="archive" class="w-full flex items-center gap-3 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="18" height="4" rx="1" />
                    <path d="M5 8v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8M10 12h4" />
                  </svg>
                  Archive
                </button>
                <div class="h-px bg-gray-200 my-1"></div>
                <button data-action="delete" class="w-full flex items-center gap-3 px-4 py-2 text-sm text-red-600 hover:bg-red-50">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                  </svg>
                  Delete chat
                </button>
              </div>
            </div>
          </div>
        </header>

        <!-- Messages -->
        <div id="messagesArea" class="flex-1 overflow-y-auto px-6 py-5 flex flex-col gap-2 min-h-0 scroll-thin"></div>

        <!-- Typing indicator -->
        <div id="typingIndicator" class="hidden px-6 pb-2 text-xs text-gray-500 italic"></div>

        <!-- Input bar -->
        <form id="messageForm" class="relative flex items-center gap-2 px-5 py-3 bg-white border-t border-gray-200 shrink-0">
          <button type="button" class="w-9 h-9 rounded-full flex items-center justify-center text-gray-500 hover:bg-gray-100 hover:text-gray-900 transition" aria-label="Attach">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48" />
            </svg>
          </button>

          <input id="messageInput" type="text" placeholder="Type a message..." autocomplete="off" class="flex-1 px-4 py-3 border border-gray-200 rounded-3xl outline-none text-sm bg-gray-50 transition focus:border-brand focus:bg-white" />

          <button type="button" id="emojiBtn" class="w-9 h-9 rounded-full flex items-center justify-center text-gray-500 hover:bg-gray-100 hover:text-gray-900 transition" aria-label="Emoji">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10" />
              <path d="M8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01" />
            </svg>
          </button>

          <button type="submit" class="w-[42px] h-[42px] rounded-full bg-brand text-white flex items-center justify-center shrink-0 transition hover:bg-brand-hover active:scale-95" aria-label="Send">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m22 2-7 20-4-9-9-4Z" />
              <path d="M22 2 11 13" />
            </svg>
          </button>

          <!-- Emoji picker -->
          <div id="emojiPicker" class="hidden absolute bottom-16 right-4 w-72 bg-white border border-gray-200 rounded-xl shadow-lg p-3 z-30 animate-popIn">
            <div class="flex items-center justify-between mb-2 px-1">
              <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Emoji</span>
              <button type="button" id="closeEmoji" class="text-gray-400 hover:text-gray-700" aria-label="Close">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M18 6 6 18M6 6l12 12" />
                </svg>
              </button>
            </div>
            <div id="emojiGrid" class="grid grid-cols-8 gap-1 max-h-56 overflow-y-auto scroll-thin"></div>
          </div>
        </form>
      </div>
    </main>
  </div>

  <div id="toast" class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 bg-gray-900 text-white text-sm px-4 py-2 rounded-lg shadow-lg z-50"></div>

  <!-- ==================== NEW MESSAGE MODAL ==================== -->
  <div id="newChatModal" class="hidden fixed inset-0 z-50 items-center justify-center p-4">
    <!-- Backdrop -->
    <div id="newChatBackdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>

    <!-- Modal panel -->
    <div class="relative w-full max-w-md bg-white rounded-2xl shadow-xl overflow-hidden animate-popIn">
      <!-- Header -->
      <header class="flex items-center justify-between px-5 py-4 border-b border-gray-200">
        <div>
          <h2 class="text-base font-semibold text-gray-900">New message</h2>
          <p class="text-xs text-gray-500 mt-0.5">Select a user to start chatting</p>
        </div>
        <button id="closeNewChat" class="w-8 h-8 rounded-full flex items-center justify-center text-gray-500 hover:bg-gray-100 transition" aria-label="Close">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6 6 18M6 6l12 12" />
          </svg>
        </button>
      </header>

      <!-- Search -->
      <div class="px-5 pt-4">
        <div class="flex items-center gap-2 px-3 py-2 bg-gray-50 rounded-[10px] text-gray-500 focus-within:ring-2 focus-within:ring-brand/30">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.35-4.35" />
          </svg>
          <input id="userSearch" type="text" placeholder="Search people..." class="flex-1 bg-transparent outline-none text-sm text-gray-900 placeholder:text-gray-400" />
        </div>
      </div>

      <!-- User list -->
      <div id="userList" class="max-h-[360px] overflow-y-auto scroll-thin py-2 mt-2"></div>

      <!-- Empty -->
      <div id="userListEmpty" class="hidden px-5 py-10 text-center text-gray-500 text-sm">
        No users found
      </div>
    </div>
  </div>

  <script src="/scripts/messages.js"></script>
</body>

</html>