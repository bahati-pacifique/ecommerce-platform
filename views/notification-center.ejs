<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>COCOCE — Notifications Center</title>
  <meta name="description" content="COCOCE — Notification Center. COCOCE Kigali, Rwanda For Laptop, desktop, electronic digital gadgets.">
  <link rel="icon" href="/favicon.ico" type="image/x-icon">

  <meta property="og:image" content="https://cdn.cococe.rw/branding/brand/logos/cococe.png">
  <meta property="og:url" content="https://www.cococe.rw">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Laptops, Printers, Accessories, Game consoles, Electronics, and much more, cococe, your wish our priority">
  <meta property="og:description" content="COCOCE Kigali Rwanda, Laptops, Desktops, Computer accessories, Smart tv, projectors, discover what you want about digital assets near you at Kigali">
  <meta property="og:logo" content="https://cdn.cococe.rw/branding/brand/logos/cococe.png" />
  <meta name="twitter:card" content="https://cdn.cococe.rw/branding/brand/logos/cococe.png">
  <meta property="twitter:domain" content="https://cococe.rw">
  <meta property="twitter:url" content="https://cococe.rw">
  <meta name="twitter:title" content="Laptops, Printers, Accessories, Game consoles, Electronics, and much more, cococe, your wish our priority">
  <meta name="twitter:description" content="COCOCE Kigali Rwanda, Laptops, Desktops, Computer accessories, Smart tv, projectors, discover what you want about digital assets near you at Kigali">

  <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.11.0/axios.min.js" integrity="sha512-h9644v03pHqrIHThkvXhB2PJ8zf5E9IyVnrSfZg8Yj8k4RsO4zldcQc4Bi9iVLUCCsqNY0b4WXVV4UB+wbWENA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

  <script src="https://code.jquery.com/jquery-3.7.1.js" integrity="sha256-eKhayi8LEQwp4NKxN+CfCh+3qOVUtJn3QNZ0TciWLP4=" crossorigin="anonymous"></script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>

  <link rel="stylesheet" href="/styles/components/notification.css">
  <link rel="stylesheet" href="/styles/components/main-snackbar.css">
  <link rel="stylesheet" href="/styles/components/loaders.css">
  <link rel="stylesheet" href="/styles/components/animations.css">
  <link rel="stylesheet" href="/styles/main.css">

  <style>
    .scroll-thin::-webkit-scrollbar {
      width: 6px;
    }

    .scroll-thin::-webkit-scrollbar-thumb {
      background: #d1d5db;
      border-radius: 3px;
    }

    .scroll-thin::-webkit-scrollbar-track {
      background: transparent;
    }
  </style>
</head>

<body class="h-screen overflow-hidden bg-gray-50 text-gray-900 font-sans">
  <div id="app" class="grid grid-cols-1 md:grid-cols-[380px_1fr] h-screen bg-white">

    <!-- ================= LEFT: NOTIFICATION LIST ================= -->
    <aside id="listPanel" class="flex flex-col border-r border-gray-200 min-h-0 bg-white">

      <!-- Header -->
      <header class="p-4 border-b border-gray-200">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <h1 class="text-xl font-bold flex items-center gap-2">
              <img src="/images/logos/fav.png" alt="COCOCE" class="w-8 h-8">
              <%=locals.user.username%>
            </h1>
            <!-- <span id="totalBadge" class="bg-brand text-white text-[11px] font-semibold px-2 py-0.5 rounded-full">0</span> -->
          </div>
          <button id="markAllReadBtn" class="text-xs text-brand hover:text-brand-hover font-medium transition">
            Mark all read
          </button>
        </div>

        <!-- Search -->
        <div class="flex items-center gap-2 px-3 py-2 bg-gray-50 rounded-[10px] text-gray-500 focus-within:ring-2 focus-within:ring-brand/30">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.35-4.35" />
          </svg>
          <input id="searchInput" type="text" placeholder="Search notifications..." class="flex-1 bg-transparent outline-none text-sm text-gray-900 placeholder:text-gray-400" />
          <button id="clearSearch" class="hidden text-gray-400 hover:text-gray-700" aria-label="Clear">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 6 6 18M6 6l12 12" />
            </svg>
          </button>
        </div>
      </header>

      <!-- Status filter -->
      <div id="statusFilters" class="flex gap-1.5 px-4 pt-3 flex-wrap">
        <button class="status-btn px-3 py-1.5 rounded-full text-[12px] font-medium transition bg-brand text-white" data-status="all">All</button>
        <button class="status-btn px-3 py-1.5 rounded-full text-[12px] font-medium transition text-gray-500 hover:bg-gray-100" data-status="new">New</button>
        <button class="status-btn px-3 py-1.5 rounded-full text-[12px] font-medium transition text-gray-500 hover:bg-gray-100" data-status="opened">Opened</button>
        <button class="status-btn px-3 py-1.5 rounded-full text-[12px] font-medium transition text-gray-500 hover:bg-gray-100" data-status="archived">Archived</button>
      </div>

      <!-- Category filter -->
      <div class="px-4 pt-3 pb-3 border-b border-gray-200">
        <div class="relative">
          <select id="categoryFilter" class="w-full appearance-none px-3 py-2 pr-9 text-[13px] bg-gray-50 border border-gray-200 rounded-lg outline-none cursor-pointer focus:border-brand transition text-gray-700">
            <option value="all">All categories</option>
            <option value="order">Order</option>
            <option value="payment">Payment</option>
            <option value="inventory">Inventory</option>
            <option value="customer">Customer</option>
            <option value="system">System</option>
            <option value="promotion">Promotion</option>
          </select>
          <svg class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-gray-400" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </div>

        <!-- Date sort -->
        <div class="flex items-center justify-between mt-3">
          <span class="text-xs text-gray-500">Sort by date</span>
          <div class="flex rounded-lg overflow-hidden border border-gray-200">
            <button class="date-sort-btn px-2.5 py-1 text-[11px] font-medium transition bg-brand text-white" data-sort="newest">
              New → Old
            </button>
            <button class="date-sort-btn px-2.5 py-1 text-[11px] font-medium transition text-gray-600 hover:bg-gray-100" data-sort="oldest">
              Old → New
            </button>
          </div>
        </div>
      </div>

      <!-- List -->
      <div id="notificationList" class="flex-1 overflow-y-auto min-h-0 scroll-thin"></div>

      <div id="listEmpty" class="hidden flex-1 flex-col items-center justify-center gap-2 text-center p-6 text-gray-500">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-gray-300">
          <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
          <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
        </svg>
        <p class="text-sm">No notifications match your filters</p>
      </div>
    </aside>

    <!-- ================= RIGHT: NOTIFICATION DETAIL ================= -->
    <main id="detailPanel" class="hidden md:flex flex-col min-h-0 bg-gray-50">

      <!-- Empty state -->
      <div id="emptyState" class="flex-1 flex flex-col items-center justify-center gap-3 text-gray-500 text-center p-6">
        <div class="text-gray-300 mb-2">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
            <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
          </svg>
        </div>
        <h2 class="text-lg font-semibold text-gray-900">Select a notification</h2>
        <p class="text-sm">Choose one from the list to see full details</p>
      </div>

      <!-- Active notification -->
      <div id="detail" class="hidden flex-col h-full min-h-0">

        <!-- Detail header -->
        <header class="flex items-center gap-3 px-5 h-16 bg-white border-b border-gray-200 shrink-0">
          <button id="backBtn" class="hidden w-9 h-9 rounded-full items-center justify-center text-gray-500 hover:bg-gray-100 transition" aria-label="Back">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 12H5M12 19l-7-7 7-7" />
            </svg>
          </button>

          <div id="detailIcon" class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0"></div>

          <div class="flex-1 min-w-0">
            <h2 id="detailTitle" class="text-[15px] font-semibold truncate"></h2>
            <span id="detailSubtitle" class="text-xs text-gray-500"></span>
          </div>

          <div class="flex gap-1">
            <button id="toggleArchiveBtn" class="w-9 h-9 rounded-full flex items-center justify-center text-gray-500 hover:bg-gray-100 hover:text-gray-900 transition" aria-label="Archive" title="Archive">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="4" rx="1" />
                <path d="M5 8v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8M10 12h4" />
              </svg>
            </button>
            <button id="deleteBtn" class="w-9 h-9 rounded-full flex items-center justify-center text-gray-500 hover:bg-red-50 hover:text-red-600 transition" aria-label="Delete" title="Delete">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
              </svg>
            </button>
          </div>
        </header>

        <!-- Detail body -->
        <div class="flex-1 overflow-y-auto scroll-thin">
          <div class="max-w-3xl mx-auto p-6 space-y-6">

            <!-- Status banner -->
            <div id="statusBanner" class="rounded-xl p-4 flex items-start gap-3"></div>

            <!-- Message -->
            <div class="bg-white rounded-xl border border-gray-200 p-5">
              <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">Message</h3>
              <p id="detailMessage" class="text-sm text-gray-800 leading-relaxed whitespace-pre-wrap"></p>
            </div>

            <!-- Meta grid -->
            <div class="bg-white rounded-xl border border-gray-200 p-5">
              <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-4">Details</h3>
              <dl id="metaGrid" class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4 text-sm"></dl>
            </div>

            <!-- Actions -->
            <div class="flex flex-wrap gap-2">
              <button id="markReadBtn" class="px-4 py-2 rounded-lg bg-brand text-white text-sm font-medium hover:bg-brand-hover transition disabled:opacity-50 disabled:cursor-not-allowed">
                Mark as opened
              </button>
              <button id="markNewBtn" class="px-4 py-2 rounded-lg bg-white border border-gray-200 text-gray-700 text-sm font-medium hover:bg-gray-50 transition disabled:opacity-50 disabled:cursor-not-allowed">
                Mark as new
              </button>
            </div>

          </div>
        </div>
      </div>
    </main>
  </div>

  <div id="toast" class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 bg-gray-900 text-white text-sm px-4 py-2 rounded-lg shadow-lg z-50"></div>

  <script src="/scripts/notifications.js"></script>
</body>

</html>