<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>COCOCE · Terms of Authentication</title>
  <meta name="description" content="COCOCE — Authentication terms. Data accuracy, internal sharing, account responsibility, and urgent support. COCOCE Kigali Rwanda.">
  <meta name="keywords" content="Laptops, Desktops, Memories, Storages, Servers, keyboards, Printers, Screens, Repair, Explore, Electronic, Digital, Kigali, Rwanda">
