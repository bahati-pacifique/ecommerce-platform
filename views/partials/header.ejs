<header class="sticky top-0 z-30 flex h-16 items-center gap-4 border-b border-slate-200 bg-white/95 px-4 sm:px-6 backdrop-blur">
  <button id="sidebarToggleButton" class="hidden rounded-lg p-2 text-slate-500 hover:bg-[var(--color-brand-ultralight)] lg:inline-flex" aria-label="Collapse sidebar" aria-expanded="true">
    <i data-lucide="panel-left-close" class="h-5 w-5"></i>
  </button>
  <button id="mobileMenuButton" class="rounded-lg p-2 text-slate-500 hover:bg-[var(--color-brand-ultralight)] lg:hidden">
    <i data-lucide="menu" class="h-5 w-5"></i>
  </button>

  <div class="relative min-w-0 flex-1">
    <i data-lucide="search" class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"></i>
    <input id="globalSearch" class="w-full rounded-lg border border-slate-200 bg-slate-50 py-2 pl-10 pr-4 text-sm outline-none transition focus:border-[var(--color-brand)] focus:bg-white focus:ring-2 focus:ring-[var(--color-brand-light)]" placeholder="Search products, orders, customers..." />
  </div>

  <div class="hidden items-center gap-2 text-xs font-semibold text-emerald-700 sm:flex">
    <span class="h-2 w-2 rounded-full bg-emerald-500"></span> Store Active
  </div>

  <button class="relative rounded-lg p-2 text-slate-500 hover:bg-[var(--color-brand-ultralight)]">
    <i data-lucide="bell" class="h-5 w-5"></i>
    <span class="absolute right-1.5 top-1.5 h-2 w-2 rounded-full bg-red-500"></span>
  </button>
  <button class="rounded-lg p-2 text-slate-500 hover:bg-[var(--color-brand-ultralight)]"><i data-lucide="message-square" class="h-5 w-5"></i></button>
  <button class="rounded-lg p-2 text-slate-500 hover:bg-[var(--color-brand-ultralight)]"><i data-lucide="circle-help" class="h-5 w-5"></i></button>

  <div class="relative shrink-0 hidden sm:block">
    <button id="headerProfileButton" class="relative z-50 flex items-center gap-2 rounded-lg px-2 py-1.5 text-left hover:bg-slate-50" aria-expanded="false">
      <img src="https://cdn.cococe.rw/images/profiles/<%= user.userId %>.jpg"
           onerror="this.src='https://ui-avatars.com/api/?name=<%= user.username %>'"
           alt="Profile" class="h-12 w-12 rounded-full border border-gray-200 object-cover">
      <div class="min-w-0">
        <div class="text-xs font-semibold"><%= user.username %></div>
        <div class="text-[10px] text-slate-500">Store Owner</div>
      </div>
      <i data-lucide="chevron-down" class="h-4 w-4 shrink-0 text-slate-400"></i>
    </button>
    <div id="headerProfileMenu" class="profile-menu closed absolute right-0 top-full z-[60] mt-2 w-52 rounded-xl border border-slate-200 bg-white p-1.5 shadow-xl">
      <a href="/dashboard" class="flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 hover:bg-[var(--color-brand-ultralight)]">
        <i data-lucide="layout-dashboard" class="h-4 w-4"></i> Business Dashboard
      </a>
      <div class="my-1 border-t border-slate-100"></div>
      <button data-profile-action="sign-out" class="flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-rose-600 hover:bg-rose-50">
        <i data-lucide="log-out" class="h-4 w-4"></i> Sign out
      </button>
    </div>
  </div>
</header>