<nav class="mb-3 text-xs text-slate-500">
  <a href="/stores/<%= store.id %>/inventory">Inventory</a>
  <span class="mx-1.5">/</span>
  <a href="/stores/<%= store.id %>/inventory/<%= inventory.id %>"><%= inventory.title %></a>
  <span class="mx-1.5">/</span>
  <span class="text-slate-900 font-medium"><%= item.listing.title %></span>
</nav>

<div class="mb-6 flex flex-col justify-between gap-4 md:flex-row md:items-end">
  <div class="flex items-start gap-4">
    <% if (item.listing.image) { %>
    <img src="<%= item.listing.image %>" alt="" class="h-16 w-16 rounded-lg object-cover ring-1 ring-slate-200" />
    <% } %>
    <div>
      <h1 class="text-2xl font-bold tracking-tight"><%= item.listing.title %></h1>
      <div class="mt-1 flex items-center gap-3 text-xs text-slate-500">
        <span class="font-mono">SKU: <%= item.listing.sku || '—' %></span>
        <% if (item.batch_number) { %>
        <span>· Batch: <%= item.batch_number %></span>
        <% } %>
      </div>
    </div>
  </div>
  <div class="flex gap-2">
    <button data-action="reserve-item" data-item-id="<%= item.id %>" class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium hover:bg-slate-50">
      <i data-lucide="lock" class="h-4 w-4"></i>Reserve
    </button>
    <button data-action="adjust-item" data-item-id="<%= item.id %>" class="inline-flex items-center gap-2 rounded-lg bg-[var(--color-brand)] px-3 py-2 text-sm font-semibold text-white hover:bg-[var(--color-brand-dark)]">
      <i data-lucide="sliders-horizontal" class="h-4 w-4"></i>Adjust quantity
    </button>
  </div>
</div>

<div class="grid gap-4 sm:grid-cols-4">
  <div class="rounded-xl border border-slate-200 bg-white p-4">
    <div class="text-xs text-slate-500">Quantity</div>
    <div class="mt-1 text-2xl font-bold"><%= fmtNum(item.quantity) %></div>
  </div>
  <div class="rounded-xl border border-slate-200 bg-white p-4">
    <div class="text-xs text-slate-500">Reserved</div>
    <div class="mt-1 text-2xl font-bold text-amber-600"><%= fmtNum(item.reserved) %></div>
  </div>
  <div class="rounded-xl border border-slate-200 bg-white p-4">
    <div class="text-xs text-slate-500">Available</div>
    <div class="mt-1 text-2xl font-bold text-emerald-600"><%= fmtNum(item.available) %></div>
  </div>
  <div class="rounded-xl border border-slate-200 bg-white p-4">
    <div class="text-xs text-slate-500">Status</div>
    <div class="mt-1 text-lg font-bold capitalize"><%= item.status.replace('_', ' ') %></div>
  </div>
</div>

<div class="mt-6 rounded-xl border border-slate-200 bg-white shadow-sm">
  <div class="flex gap-1 overflow-x-auto border-b border-slate-200 px-4" id="itemTabs">
    <button data-tab="units" class="border-b-2 border-[var(--color-brand)] px-4 py-3 text-sm font-semibold text-[var(--color-brand)]">
      Units (<%= units.length %>)
    </button>
    <button data-tab="transactions" class="border-b-2 border-transparent px-4 py-3 text-sm font-medium text-slate-500 hover:text-slate-900">
      Transactions (<%= transactions.length %>)
    </button>
    <button data-tab="metadata" class="border-b-2 border-transparent px-4 py-3 text-sm font-medium text-slate-500 hover:text-slate-900">
      Details
    </button>
  </div>

  <div data-tab-panel="units">
    <div class="p-4">
      <div class="relative max-w-sm">
        <i data-lucide="search" class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"></i>
        <input type="search" placeholder="Search by serial, IMEI, barcode..." class="w-full rounded-lg border border-slate-200 bg-slate-50 py-2 pl-9 pr-3 text-sm outline-none focus:border-[var(--color-brand)] focus:bg-white" />
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
          <tr>
            <th class="px-5 py-3">Serial</th>
            <th class="px-5 py-3">IMEI</th>
            <th class="px-5 py-3">Barcode</th>
            <th class="px-5 py-3">Condition</th>
            <th class="px-5 py-3">Status</th>
            <th class="px-5 py-3">Warranty</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% units.forEach(u => { %>
          <tr class="hover:bg-slate-50">
            <td class="px-5 py-3 font-mono text-xs"><%= u.serial_number || '—' %></td>
            <td class="px-5 py-3 font-mono text-xs"><%= u.imei || '—' %></td>
            <td class="px-5 py-3 font-mono text-xs"><%= u.barcode || '—' %></td>
            <td class="px-5 py-3 capitalize"><%= u.condition %></td>
            <td class="px-5 py-3">
              <span class="rounded-full px-2 py-0.5 text-xs font-semibold
                  <%= u.status === 'available' ? 'bg-emerald-50 text-emerald-700' : '' %>
                  <%= u.status === 'reserved' ? 'bg-amber-50 text-amber-700' : '' %>
                  <%= u.status === 'sold' ? 'bg-slate-100 text-slate-600' : '' %>
                  <%= u.status === 'damaged' ? 'bg-rose-50 text-rose-700' : '' %>">
                <%= u.status %>
              </span>
            </td>
            <td class="px-5 py-3 text-xs text-slate-500">
              <% if (u.warranty_end_date) { %>
              Until <%= new Date(u.warranty_end_date).toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) %>
              <% } else { %>
              —
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <div data-tab-panel="transactions" class="hidden">
    <div class="divide-y divide-slate-100">
      <% transactions.forEach(tx => { %>
      <div class="flex items-start gap-3 p-4">
        <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full
            <%= tx.quantity_change > 0 ? 'bg-emerald-50 text-emerald-600' : 'bg-rose-50 text-rose-600' %>">
          <i data-lucide="<%= tx.quantity_change > 0 ? 'plus' : 'minus' %>" class="h-4 w-4"></i>
        </div>
        <div class="flex-1">
          <div class="flex items-center justify-between">
            <div>
              <div class="text-sm font-medium">
                <%= tx.type %> —
                <span class="<%= tx.quantity_change > 0 ? 'text-emerald-600' : 'text-rose-600' %>">
                  <%= tx.quantity_change > 0 ? '+' : '' %><%= tx.quantity_change %>
                </span>
              </div>
              <% if (tx.notes) { %>
              <div class="mt-0.5 text-xs text-slate-500"><%= tx.notes %></div>
              <% } %>
              <% if (tx.created_by) { %>
              <div class="mt-1 text-xs text-slate-400">by <%= tx.created_by.name %></div>
              <% } %>
            </div>
            <div class="text-xs text-slate-400">
              <%= new Date(tx.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
            </div>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
  </div>

  <!-- Tab: Metadata -->
  <div data-tab-panel="metadata" class="hidden p-5">
    <dl class="grid grid-cols-2 gap-4 text-sm">
      <div>
        <dt class="text-xs text-slate-500">Batch number</dt>
        <dd class="mt-1 font-medium"><%= item.batch_number || '—' %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">Manufactured</dt>
        <dd class="mt-1 font-medium">
          <%= item.mfg_at ? new Date(item.mfg_at).toLocaleDateString() : '—' %>
        </dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">Expires</dt>
        <dd class="mt-1 font-medium">
          <%= item.expires_at ? new Date(item.expires_at).toLocaleDateString() : '—' %>
        </dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">Created</dt>
        <dd class="mt-1 font-medium"><%= new Date(item.created_at).toLocaleDateString() %></dd>
      </div>
    </dl>
  </div>
</div>
<script type="module">
  document.addEventListener('DOMContentLoaded', () => {

    const tabs = document.querySelectorAll('#itemTabs [data-tab]');
    const panels = document.querySelectorAll('[data-tab-panel]');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.tab;

        tabs.forEach(t => {
          t.classList.toggle('border-[var(--color-brand)]', t === tab);
          t.classList.toggle('text-[var(--color-brand)]', t === tab);
          t.classList.toggle('border-transparent', t !== tab);
          t.classList.toggle('text-slate-500', t !== tab);
        });

        panels.forEach(p => {
          p.classList.toggle('hidden', p.dataset.tabPanel !== target);
        });
      });
    });
  });
</script>