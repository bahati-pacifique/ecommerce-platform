<div class="mb-6">
  <h1 class="text-2xl font-bold tracking-tight">Inventory transactions</h1>
  <p class="mt-1 text-sm text-slate-500">
    Every inventory change, in reverse chronological order.
  </p>
</div>

<!-- Filters -->
<div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
  <div class="flex flex-col gap-3 md:flex-row">
    <div class="relative flex-1">
      <i data-lucide="search" class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"></i>
      <input type="search" id="txSearch" placeholder="Search by reference, SKU, or notes..."
             class="w-full rounded-lg border border-slate-200 bg-slate-50 py-2 pl-9 pr-3 text-sm focus:border-[var(--color-brand)] focus:bg-white" />
    </div>
    <select id="txType" class="rounded-lg border border-slate-200 px-3 py-2 text-sm">
      <option value="">All types</option>
      <option value="received">Received</option>
      <option value="sold">Sold</option>
      <option value="returned">Returned</option>
      <option value="damaged">Damaged</option>
      <option value="adjustment">Adjustment</option>
      <option value="reserved">Reserved</option>
      <option value="released">Released</option>
    </select>
    <input type="date" id="txFrom" class="rounded-lg border border-slate-200 px-3 py-2 text-sm" />
    <input type="date" id="txTo" class="rounded-lg border border-slate-200 px-3 py-2 text-sm" />
  </div>
</div>

<div class="mt-4 rounded-xl border border-slate-200 bg-white shadow-sm">
  <table class="w-full text-left text-sm">
    <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
      <tr>
        <th class="px-5 py-3">When</th>
        <th class="px-5 py-3">Type</th>
        <th class="px-5 py-3">Listing</th>
        <th class="px-5 py-3 text-right">Change</th>
        <th class="px-5 py-3">Reference</th>
        <th class="px-5 py-3">By</th>
      </tr>
    </thead>
    <tbody id="txTbody" class="divide-y divide-slate-100"></tbody>
  </table>
</div>