<%
  const unitStatuses   = [
    'available',
    'reserved',
    'sold',
    'returned',
    'damaged',
    'repair',
    'lost',
    'disposed',
    'checked_out'
  ];
  const unitConditions = [
    'new',
    'new',
    'open_box',
    'used',
    'used_like_new',
    'used_good',
    'used_fair',
    'refurbished',
    'for_parts',
    'not_working',
    'damaged'
    ];
%>

<div id="unitSheet" data-component="unit-bottom-sheet" class="fixed inset-0 z-[60] pointer-events-none opacity-0 invisible
            transition-[opacity,visibility] duration-300 ease-out
            motion-reduce:transition-none" role="dialog" aria-modal="true" aria-labelledby="unitSheetTitle">

  <div id="unitSheetBackdrop" class="absolute inset-0 bg-slate-950/50 backdrop-blur-sm opacity-0
              transition-opacity duration-300 ease-out
              motion-reduce:transition-none" aria-hidden="true"></div>

  <div id="unitSheetPanel" class="absolute bottom-0 left-0 right-0 max-h-[90vh] overflow-y-auto
              rounded-t-2xl bg-white shadow-2xl
              translate-y-full
              transition-transform duration-[420ms] ease-[cubic-bezier(0.16,1,0.3,1)]
              will-change-transform
              motion-reduce:transition-none motion-reduce:duration-0
              sm:mx-auto sm:max-w-2xl">

    <div class="sticky top-0 z-10 flex items-center justify-center bg-white pt-2 pb-1">
      <div id="unitSheetHandle" class="h-1.5 w-12 rounded-full bg-slate-300"></div>
    </div>

    <!-- Header — hydrates immediately from search-card data -->
    <div class="flex items-start justify-between gap-3 px-5 pb-3 pt-2">
      <div class="flex min-w-0 items-center gap-3">
        <div id="unitSheetImageWrap">
          <!-- image or placeholder injected by JS -->
        </div>
        <div class="min-w-0">
          <h2 id="unitSheetTitle" class="truncate text-base font-bold text-slate-900">
            Unit
          </h2>
          <p id="unitSheetSubtitle" class="mt-0.5 text-xs text-slate-500">
            —
          </p>
        </div>
      </div>
      <button type="button" id="unitSheetClose" aria-label="Close" class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-slate-500 transition hover:bg-slate-100">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Body -->
    <div class="px-5 pb-5">

      <div id="unitSheetSkeleton" class="animate-pulse">

        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
          <div class="mb-2 h-2.5 w-20 rounded bg-slate-200"></div>
          <div class="grid grid-cols-2 gap-3">
            <div class="space-y-1.5">
              <div class="h-2 w-12 rounded bg-slate-200"></div>
              <div class="h-3 w-24 rounded bg-slate-200"></div>
            </div>
            <div class="space-y-1.5">
              <div class="h-2 w-12 rounded bg-slate-200"></div>
              <div class="h-3 w-20 rounded bg-slate-200"></div>
            </div>
          </div>
        </div>

        <!-- Details grid -->
        <div class="mt-3 grid grid-cols-2 gap-3">
          <div class="space-y-1.5">
            <div class="h-2 w-16 rounded bg-slate-200"></div>
            <div class="h-3 w-24 rounded bg-slate-200"></div>
          </div>
          <div class="space-y-1.5">
            <div class="h-2 w-16 rounded bg-slate-200"></div>
            <div class="h-3 w-20 rounded bg-slate-200"></div>
          </div>
          <div class="space-y-1.5">
            <div class="h-2 w-16 rounded bg-slate-200"></div>
            <div class="h-3 w-16 rounded bg-slate-200"></div>
          </div>
          <div class="space-y-1.5">
            <div class="h-2 w-16 rounded bg-slate-200"></div>
            <div class="h-3 w-24 rounded bg-slate-200"></div>
          </div>
        </div>

        <!-- Action placeholders -->
        <div class="mt-5 space-y-2">
          <div class="h-16 rounded-xl border border-slate-200 bg-slate-50"></div>
          <div class="h-16 rounded-xl border border-slate-200 bg-slate-50"></div>
          <div class="h-16 rounded-xl border border-slate-200 bg-slate-50"></div>
        </div>
      </div>

      <!-- ── ERROR STATE ─────────────────────────────────── -->
      <div id="unitSheetLoadError" class="hidden py-10 text-center">
        <div class="inline-flex flex-col items-center gap-3">
          <div class="flex h-12 w-12 items-center justify-center rounded-full bg-rose-50">
            <svg class="h-6 w-6 text-rose-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" />
            </svg>
          </div>
          <div>
            <p class="text-sm font-semibold text-slate-900">Couldn't load this unit</p>
            <p id="unitSheetLoadErrorMsg" class="mt-1 text-xs text-slate-500">
              Something went wrong. Please try again.
            </p>
          </div>
          <div class="flex gap-2">
            <button type="button" id="unitSheetRetry" class="rounded-lg bg-brand px-4 py-2 text-sm font-bold text-white transition hover:bg-brand-dark">
              Retry
            </button>
            <button type="button" id="unitSheetErrorClose" class="rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">
              Close
            </button>
          </div>
        </div>
      </div>

      <!-- ─── REAL CONTENT (after fetch) ────────────────────── -->
      <div id="unitSheetContent" class="hidden">

        <!-- Identifiers -->
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
          <div class="mb-2 text-[10px] font-bold uppercase tracking-wider text-slate-500">
            Identifiers
          </div>
          <dl id="unitSheetIds" class="grid grid-cols-2 gap-x-3 gap-y-2 text-xs">
            <!-- filled by JS -->
          </dl>
        </div>

        <!-- Meta (JSONB) -->
        <div id="unitSheetMetaSection" class="mt-3 hidden">
          <div class="mb-1 text-[10px] font-bold uppercase tracking-wider text-slate-500">
            Metadata
          </div>
          <div id="unitSheetMeta" class="flex flex-wrap gap-1.5">
            <!-- filled by JS -->
          </div>
        </div>

        <!-- Facts -->
        <dl class="mt-3 grid grid-cols-2 gap-x-3 gap-y-2 text-xs text-slate-600 unit-description">
          <div>
            <dt class="text-[10px] font-medium uppercase tracking-wider text-slate-400">
              Status
            </dt>
            <dd id="unitSheetStatus" class="mt-0.5 font-bold capitalize">—</dd>
          </div>
          <div>
            <dt class="text-[10px] font-medium uppercase tracking-wider text-slate-400">
              Warranty
            </dt>
            <dd id="unitSheetWarranty" class="mt-0.5">
              —
            </dd>
          </div>
          <div>
            <dt class="text-[10px] font-medium uppercase tracking-wider text-slate-400">
              Received
            </dt>
            <dd id="unitSheetReceived" class="mt-0.5">—</dd>
          </div>
          <div>
            <dt class="text-[10px] font-medium uppercase tracking-wider text-slate-400">
              Condition
            </dt>
            <dd id="unitSheetCondition" class="mt-0.5 capitalize">—</dd>
          </div>
          <div>
            <dt class="text-[10px] font-medium uppercase tracking-wider text-slate-400">
              Inventory
            </dt>
            <dd id="unitSheetLocation" class="mt-0.5">—</dd>
          </div>

        </dl>

        <div class="mt-5 space-y-2">

          <!-- Status -->
          <div class="rounded-xl border border-slate-200 p-3">
            <label class="mb-1.5 block text-[10px] font-bold uppercase tracking-wider text-slate-500">
              Set status
            </label>
            <div id="unitSheetStatuses" class="flex flex-wrap gap-1.5">
              <% unitStatuses.forEach(s => { %>
              <% if (s !== "sold") {%>
              <button type="button" data-status-action="<%= s %>" class="rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-semibold capitalize text-slate-700 transition hover:border-slate-300 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50
                               data-[active=true]:border-brand data-[active=true]:bg-brand data-[active=true]:text-white capitalize unit-status-action-btn">
                <%= s.replaceAll('_', ' ') %>
              </button>
              <%}%>
              <% }) %>
            </div>
          </div>

          <div class="rounded-xl border border-slate-200 p-3">
            <label class="mb-1.5 block text-[10px] font-bold uppercase tracking-wider text-slate-500">
              Set condition
            </label>
            <div id="unitSheetConditions" class="flex flex-wrap gap-1.5">
              <% unitConditions.forEach(c => { %>
              <button type="button" data-condition-action="<%= c %>" class="rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-semibold capitalize text-slate-700 transition hover:border-slate-300 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50
                               data-[active=true]:border-brand data-[active=true]:bg-brand data-[active=true]:text-white capitalize">
                <%= c.replaceAll('_', ' ') %>
              </button>
              <% }) %>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div class="rounded-xl border border-slate-200 p-3">
              <label for="unitSheetLocationSelect" class="mb-1.5 block text-[10px] font-bold uppercase tracking-wider text-slate-500">
                Move to Inventory
              </label>
              <div class="flex gap-2">
                <select id="unitSheetLocationSelect" class="h-9 flex-1 rounded-lg border border-slate-200 bg-white px-3 text-sm text-slate-900 outline-none focus:border-brand focus:ring-2 focus:ring-brand/20">
                  <option value="">— Select inventory —</option>
                  <% locals.store_inventories?.forEach(inv=>{%>
                  <option value="<%=inv.id%>" class="<%- locals.inventory?.id === inv.id ? 'hidden' : '' %>" <%- locals.inventory?.id === inv.id ? 'selected' : '' %>><%=inv.title%></option>
                  <%})%>
                </select>
                <button type="button" id="unitSheetLocationSave" class="rounded-lg bg-slate-900 px-3 text-xs font-bold text-white transition hover:bg-slate-800 <%- locals.store_inventories?.length <= 1 ? 'hidden' : ''%>">
                  Move
                </button>
              </div>
            </div>

            <!-- <a id="unitSheetOpenPage" href="#" class="flex items-center justify-between rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-800 transition hover:border-slate-300 hover:bg-slate-50">
              <span class="flex items-center gap-2">
                Open full page
              </span>
              <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18 6-6-6-6" />
              </svg>
            </a> -->

            <a id="unitWarrantPage" target="_blank" href="#" class="flex items-center justify-between rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-800 transition hover:border-slate-300 hover:bg-slate-50">
              <span class="flex items-center gap-2">
                Adjust warranty
              </span>
              <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18 6-6-6-6" />
              </svg>
            </a>

            <button type="button" id="unitSheetSold" class="flex w-full items-center justify-center gap-2 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm font-semibold text-green-700 transition hover:bg-green-100">
              <svg xmlns="http://w3.org" viewBox="0 0 24 24" width="38" height="38" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="8" cy="21" r="1" />
                <circle cx="17" cy="21" r="1" />
                <path d="M2.5 2.5h3l2.5 10.5h10l2-6H7.5" />
                <circle cx="15.5" cy="7" r="4.5" fill="#ffffff" stroke="none" />
                <path d="m13 7 1.7 1.7 2.8-3.2" stroke="#10b981" />
              </svg>
              Mark Sold
            </button>

            <button type="button" id="unitSheetDelete" class="flex w-full items-center justify-center gap-2 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-semibold text-rose-700 transition hover:bg-rose-100">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0 1 16.138 21H7.862a2 2 0 0 1-1.995-1.858L5 7m5 4v6m4-6v6M1 7h22M9 7V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v3" />
              </svg>
              Remove unit
            </button>
          </div>

        </div>

        <!-- Inline feedback -->
        <div id="unitSheetError" class="mt-3 hidden rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-xs text-rose-700" role="alert"></div>
        <div id="unitSheetSuccess" class="mt-3 hidden rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs text-emerald-700" role="status"></div>
      </div>

      <!-- ─── LOAD ERROR (fetch failed) ──────────────────────── -->
      <div id="unitSheetLoadError" class="hidden py-10 text-center">
        <div class="inline-flex flex-col items-center gap-3">
          <div class="flex h-12 w-12 items-center justify-center rounded-full bg-rose-50">
            <svg class="h-6 w-6 text-rose-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" />
            </svg>
          </div>
          <div>
            <p class="text-sm font-semibold text-slate-900">Couldn't load this unit</p>
            <p id="unitSheetLoadErrorMsg" class="mt-1 text-xs text-slate-500">
              Something went wrong. Please try again.
            </p>
          </div>
          <div class="flex gap-2">
            <button type="button" id="unitSheetRetry" class="rounded-lg bg-brand px-4 py-2 text-sm font-bold text-white transition hover:bg-brand-dark">
              Retry
            </button>
            <button type="button" id="unitSheetErrorClose" class="rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">
              Close
            </button>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>