<div id="transferModal" class="fixed inset-0 z-50 hidden" role="dialog" aria-modal="true" aria-labelledby="transferModalTitle">
  <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-sm" data-transfer-close></div>

  <div class="absolute inset-0 flex items-center justify-center p-4">
    <div class="relative flex w-full w-lg min-h-[250px] flex-col overflow-hidden rounded-2xl bg-white shadow-xl">

      <div class="flex w-full flex-col hidden" id="bulkTransferBody">

        <div class="flex items-start justify-between gap-3 border-b border-slate-100 px-5 py-4">
          <div>
            <h2 id="transferModalTitle" class="text-lg font-bold tracking-tight text-slate-900">
              Transfer stock
            </h2>
            <p id="transferModalSubtitle" class="mt-0.5 text-xs text-slate-500">
              Move available quantity to another inventory.
            </p>
          </div>
          <button type="button" data-transfer-close class="rounded-lg p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-600" aria-label="Close">
            <i data-lucide="x" class="h-5 w-5"></i>
          </button>
        </div>

        
        <form id="transferForm" class="flex-1 overflow-y-auto px-5 py-4">
          
          <div class="mb-4 rounded-lg border border-slate-200 bg-slate-50 p-3">
            <div class="text-xs font-semibold uppercase tracking-wider text-slate-500">
              Item
            </div>
            <div id="transferSourceTitle" class="mt-1 text-sm font-semibold text-slate-800">
              —
            </div>
            <div class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-500">
              <span>Quantity: <span id="transferSourceQuantity" class="font-medium text-slate-700">—</span></span>
              <span>Reserved: <span id="transferSourceReserved" class="font-medium text-slate-700">—</span></span>
              <span>Available: <span id="transferSourceAvailable" class="font-medium text-emerald-700">—</span></span>
            </div>
          </div>

          <!-- Destination -->
          <label class="mb-1 block text-sm font-medium text-slate-700" for="transferDestination">
            Destination inventory
          </label>
          <select id="transferDestination" required class="mb-4 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-brand">
            <option value="">Select an inventory…</option>
          </select>

          <label class="mb-1 block text-sm font-medium text-slate-700" for="transferQuantity">
            Quantity to transfer
          </label>
          <input id="transferQuantity" type="number" min="1" step="1" required class="mb-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-brand" />
          <p id="transferQuantityHint" class="mb-4 text-xs text-slate-500">
            Must be a positive integer within the available quantity.
          </p>

          <label class="mb-1 block text-sm font-medium text-slate-700" for="transferNotes">
            Notes <span class="font-normal text-slate-400">(optional)</span>
          </label>
          <textarea id="transferNotes" rows="2" class="mb-2 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-brand" placeholder="Reason or reference for this transfer…"></textarea>

          <div id="transferError" class="mt-2 hidden rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-700"></div>
        </form>

        <div class="flex items-center justify-end gap-2 border-t border-slate-100 px-5 py-3">
          <button type="button" data-transfer-close class="rounded-lg border border-slate-200 px-3 py-2 text-sm font-medium hover:bg-slate-50">
            Cancel
          </button>
          <button type="submit" form="transferForm" id="transferSubmit" class="inline-flex items-center gap-2 rounded-lg bg-brand px-3 py-2 text-sm font-semibold text-white hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50">
            <i data-lucide="arrow-right-left" class="h-4 w-4"></i>
            <span>Transfer</span>
          </button>
        </div>
      </div>

      <div class="abs-centered hidden" id="bulkTransferLoader">
        <svg version="1.1" x="0" y="0" width="150px" height="150px" viewBox="-10 -10 120 120" enable-background="new 0 0 200 200" xml:space="preserve">
          <path class="c-loader" d="M0,50 A50,50,0 1 1 100,50 A50,50,0 1 1 0,50" />
        </svg>
      </div>

    </div>
  </div>
</div>

<script type="module" src="/scripts/pages/bulk-transfer.js"></script>