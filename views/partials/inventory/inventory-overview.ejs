<%
  const _fmtNum = (n) => {
    if (n == null || n === '') return '0';
    return Number(n).toLocaleString('en-US');
  };

  const safe = {
    locations:   Array.isArray(locations) ? locations : [],
    totals:      totals || {},
  };

  const t = {
    units: safe.totals.units ?? 0,
    available:    safe.totals.available    ?? 0,
    reserved:     safe.totals.reserved     ?? 0,
    low_stock:    safe.totals.low_stock    ?? 0,
    out_of_stock: safe.totals.out_of_stock ?? 0,
  };
%>
<div class="mb-6 flex flex-col justify-between gap-4 md:flex-row md:items-end">
  <div>
    <div class="mb-1 flex items-center gap-2 text-[var(--color-brand)]">
      <i data-lucide="boxes" class="h-4 w-4"></i>
      <span class="text-sm font-semibold"><%= store.name %></span>
    </div>
    <h1 class="text-2xl font-bold tracking-tight">Inventory</h1>
    <p class="mt-1 text-sm text-slate-500">Manage stock across all your locations.</p>
  </div>
  <div class="flex flex-wrap gap-2">
    <a href="/stores/<%= store.id %>/inventory/units"
       class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium hover:bg-slate-50">
      <i data-lucide="scan-line" class="h-4 w-4"></i>Search units
    </a>
    <a href="/stores/<%= store.id %>/inventory/transactions"
       class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium hover:bg-slate-50">
      <i data-lucide="history" class="h-4 w-4"></i>Transactions
    </a>
    <button type="button"
            data-action="create-inventory"
            class="inline-flex items-center gap-2 rounded-lg bg-[var(--color-brand)] px-3 py-2 text-sm font-semibold text-white hover:bg-[var(--color-brand-dark)]">
      <i data-lucide="plus" class="h-4 w-4"></i>New Location
    </button>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- Store-wide aggregate stats                                  -->
<!-- ═══════════════════════════════════════════════════════════ -->
<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-center justify-between">
      <span class="text-sm text-slate-500">Total units</span>
      <span class="rounded-lg bg-[var(--color-brand-ultralight)] p-2 text-[var(--color-brand)]">
        <i data-lucide="package" class="h-4 w-4"></i>
      </span>
    </div>
    <div class="mt-4 text-2xl font-bold"><%= _fmtNum(t.units) %></div>
    <div class="mt-1 text-xs text-slate-400">
      Across <%= _fmtNum(safe.locations.length) %> location<%= safe.locations.length === 1 ? '' : 's' %>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-center justify-between">
      <span class="text-sm text-slate-500">Available</span>
      <span class="rounded-lg bg-emerald-50 p-2 text-emerald-600">
        <i data-lucide="check-circle" class="h-4 w-4"></i>
      </span>
    </div>
    <div class="mt-4 text-2xl font-bold text-emerald-600"><%= _fmtNum(t.available) %></div>
    <div class="mt-1 text-xs text-slate-400">Ready to sell</div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-center justify-between">
      <span class="text-sm text-slate-500">Reserved</span>
      <span class="rounded-lg bg-amber-50 p-2 text-amber-600">
        <i data-lucide="lock" class="h-4 w-4"></i>
      </span>
    </div>
    <div class="mt-4 text-2xl font-bold text-amber-600"><%= _fmtNum(t.reserved) %></div>
    <div class="mt-1 text-xs text-slate-400">Tied to orders</div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-center justify-between">
      <span class="text-sm text-slate-500">Low stock</span>
      <span class="rounded-lg bg-orange-50 p-2 text-orange-600">
        <i data-lucide="alert-triangle" class="h-4 w-4"></i>
      </span>
    </div>
    <div class="mt-4 text-2xl font-bold text-orange-600"><%= _fmtNum(t.low_stock) %></div>
    <div class="mt-1 text-xs text-slate-400">
      <%= _fmtNum(t.out_of_stock) %> out of stock
    </div>
  </div>

</div>

<div class="mt-6">

  <div class="mb-3 flex items-center justify-between">
    <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500">
      Locations
    </h2>
    <span class="text-xs text-slate-400">
      <%= _fmtNum(safe.locations.length) %> total
    </span>
  </div>

  <% if (!safe.locations.length) { %>
    <div class="rounded-xl border-2 border-dashed border-slate-200 py-16 text-center">
      <div class="inline-flex flex-col items-center gap-2">
        <div class="flex h-12 w-12 items-center justify-center rounded-full bg-[var(--color-brand-ultralight)]">
          <i data-lucide="warehouse" class="h-6 w-6 text-[var(--color-brand)]"></i>
        </div>
        <p class="text-sm font-medium text-slate-700">No inventory locations yet</p>
        <p class="text-xs text-slate-500">Create your first location to start tracking stock.</p>
        <button type="button"
                data-action="create-inventory"
                class="mt-3 inline-flex items-center gap-1.5 rounded-lg bg-[var(--color-brand)] px-4 py-2 text-xs font-semibold text-white hover:bg-[var(--color-brand-dark)]">
          <i data-lucide="plus" class="h-3.5 w-3.5"></i>
          New Location
        </button>
      </div>
    </div>
  <% } else { %>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% safe.locations.forEach(loc => {
           const stats = loc.stats || {};
           const itemRecords   = stats.item_records       ?? 0;
           const totalUnits    = stats.total_units        ?? 0;
           const availableUnits = stats.available_units   ?? 0;
           const reservedUnits  = stats.reserved_units    ?? 0;
           const lowStockItems  = stats.low_stock_items   ?? 0;
           const outOfStockItems = stats.out_of_stock_items ?? 0;
      %>
        <a href="/stores/<%= store.id %>/inventory/<%= loc.id %>"
           class="group rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-slate-300 hover:shadow-md">

          <div class="flex items-start justify-between">
            <div class="flex min-w-0 items-center gap-3">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-[var(--color-brand-ultralight)] text-[var(--color-brand)]">
                <i data-lucide="warehouse" class="h-5 w-5"></i>
              </span>
              <div class="min-w-0">
                <h3 class="truncate font-semibold text-slate-900"><%= loc.title %></h3>
                <p class="truncate text-xs text-slate-500"><%= loc.address || '—' %></p>
              </div>
            </div>
            <% if (loc.is_default) { %>
              <span class="ml-2 shrink-0 rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold text-emerald-700">
                Default
              </span>
            <% } %>
          </div>

          <div class="mt-4 grid grid-cols-2 gap-3 text-xs">
            <div>
              <dt class="text-slate-400">Items</dt>
              <dd class="mt-0.5 font-bold text-slate-900"><%= _fmtNum(itemRecords) %></dd>
            </div>
            <div>
              <dt class="text-slate-400">Units</dt>
              <dd class="mt-0.5 font-bold text-slate-900"><%= _fmtNum(totalUnits) %></dd>
            </div>
            <div>
              <dt class="text-slate-400">Available</dt>
              <dd class="mt-0.5 font-bold text-emerald-600"><%= _fmtNum(availableUnits) %></dd>
            </div>
            <div>
              <dt class="text-slate-400">Reserved</dt>
              <dd class="mt-0.5 font-bold text-amber-600"><%= _fmtNum(reservedUnits) %></dd>
            </div>
          </div>

          <% if (lowStockItems > 0 || outOfStockItems > 0) { %>
            <div class="mt-4 flex flex-wrap gap-2 border-t border-slate-100 pt-3 text-[11px]">
              <% if (lowStockItems > 0) { %>
                <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-2 py-0.5 text-amber-700">
                  <i data-lucide="alert-triangle" class="h-3 w-3"></i>
                  <%= lowStockItems %> low
                </span>
              <% } %>
              <% if (outOfStockItems > 0) { %>
                <span class="inline-flex items-center gap-1 rounded-full bg-rose-50 px-2 py-0.5 text-rose-700">
                  <i data-lucide="x-circle" class="h-3 w-3"></i>
                  <%= outOfStockItems %> out
                </span>
              <% } %>
            </div>
          <% } else { %>
            <div class="mt-4 flex items-center gap-1.5 border-t border-slate-100 pt-3 text-[11px] text-emerald-600">
              <i data-lucide="check-circle-2" class="h-3 w-3"></i>
              <span>All in stock</span>
            </div>
          <% } %>

          <div class="mt-3 flex items-center justify-end text-xs text-slate-400">
            <span class="transition group-hover:text-[var(--color-brand)]">View details</span>
            <i data-lucide="arrow-right" class="ml-1 h-3.5 w-3.5 transition group-hover:translate-x-0.5 group-hover:text-[var(--color-brand)]"></i>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>

</div>