<div id="adjustQuantityModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">

  <div id="adjustQuantityBackdrop" class="absolute inset-0 bg-slate-950/40 backdrop-blur-sm"></div>

  <div class="relative w-full max-w-md max-h-[90vh] flex flex-col">
    <div class="rounded-2xl border border-slate-200 bg-white shadow-2xl overflow-hidden flex flex-col">

      <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4 shrink-0">
        <div class="flex items-center gap-3 min-w-0">
          <img id="adjustQtyItemImage" src="" alt="" class="h-9 w-9 rounded object-cover ring-1 ring-slate-200 hidden" />
          <div class="min-w-0">
            <div id="adjustQtyModalTitle" class="text-sm font-semibold text-slate-900">Adjust quantity</div>
            <div class="text-xs text-slate-500 truncate">
              <span id="adjustQtyItemTitle">Loading…</span>
            </div>
            <div class="text-xs text-slate-400 truncate">
              <span id="adjustQtyItemInventory">—</span>
              <span class="text-slate-300 mx-1">·</span>
              <span id="adjustQtyItemSku" class="font-mono">—</span>
            </div>
          </div>
        </div>
        <button type="button" id="adjustQtyClose" class="rounded-lg p-1.5 text-slate-400 hover:bg-slate-100 shrink-0">
          <i data-lucide="x" class="h-4 w-4"></i>
        </button>
      </div>

      <form id="adjustQtyForm" class="flex-1 overflow-y-auto">

        <div class="p-5 space-y-5">

          <div id="adjustQtyLoading" class="flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-slate-50 p-6 text-sm text-slate-500">
            <i data-lucide="loader-circle" class="h-4 w-4 animate-lucide-spin"></i>
            Loading item…
          </div>

          <div id="adjustQtyContent" class="space-y-5 hidden">

            <div class="flex items-center gap-2 flex-wrap">
              <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-600">
                <i data-lucide="boxes" class="h-3 w-3"></i>
                <span id="adjustQtyModeText">—</span>
              </span>
              <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-600">
                <i data-lucide="hash" class="h-3 w-3"></i>
                <span id="adjustQtyUnitCountText">—</span>
              </span>
            </div>

            <div class="rounded-lg border border-slate-200 bg-slate-50 p-3">
              <div class="flex items-center justify-between">
                <div class="text-xs font-medium text-slate-500">Current quantity</div>
                <div class="text-2xl font-semibold text-slate-900 tabular-nums" id="adjustQtyCurrent">0</div>
              </div>
            </div>

            <div>
              <!-- Dynamic Label -->
              <label id="adjustQtyInputLabel" class="mb-2 block text-xs font-semibold text-slate-600">
                Quantity change delta <span class="text-rose-500">*</span>
              </label>

              <div class="flex items-stretch gap-2">
                <button type="button" id="adjustQtyMinus" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-700 hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed" aria-label="Decrease quantity">
                  <i data-lucide="minus" class="h-4 w-4"></i>
                </button>

                <input type="number" name="delta" id="deltaAdjustInput" step="1" value="0" required class="flex-1 rounded-lg border border-slate-200 px-3 py-2 text-center text-lg font-semibold tabular-nums outline-none focus:border-[var(--color-brand)] disabled:bg-slate-50 disabled:text-slate-400" />

                <button type="button" id="adjustQtyPlus" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-700 hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed" aria-label="Increase quantity">
                  <i data-lucide="plus" class="h-4 w-4"></i>
                </button>
              </div>

              <div class="mt-3 flex flex-wrap gap-2" id="adjustQtyPresets">
                <button type="button" data-delta="1" class="adjust-qty-preset rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed">+1</button>
                <button type="button" data-delta="5" class="adjust-qty-preset rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed">+5</button>
                <button type="button" data-delta="10" class="adjust-qty-preset rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed">+10</button>
                <button type="button" data-delta="-1" class="adjust-qty-preset rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed">−1</button>
                <button type="button" data-delta="-5" class="adjust-qty-preset rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed">−5</button>
              </div>

              <div id="adjustQtyDelta" class="mt-2 text-xs text-slate-500"></div>
            </div>

          </div>

          <div id="adjustQtyError" class="hidden rounded-lg border border-rose-200 bg-rose-50 p-3 text-xs text-rose-700"></div>

        </div>

        <div class="flex items-center justify-end gap-2 border-t border-slate-100 bg-slate-50 px-5 py-3 shrink-0">
          <button type="button" id="adjustQtyCancel" class="rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
            Cancel
          </button>
          <button type="submit" id="adjustQtySubmit" disabled class="inline-flex items-center gap-2 rounded-lg bg-[var(--color-brand)] px-4 py-2 text-sm font-semibold text-white hover:bg-[var(--color-brand-dark)] disabled:opacity-50 disabled:cursor-not-allowed">
            <i data-lucide="check" class="h-4 w-4"></i>
            Submit
          </button>
        </div>

      </form>

    </div>
  </div>
</div>

<script type="module" src="/scripts/pages/quantity_adjustment.js"></script>