<header id="site-header" class="relative">

  <!-- ═══════════════════════════════════════════════════════════
       DECORATIVE BRAND BUBBLES (absolute, behind content)
  ════════════════════════════════════════════════════════════ -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
    <!-- Large soft bubble, top-left -->
    <div class="absolute -left-16 -top-20 h-64 w-64 rounded-full bg-brand/10 blur-3xl"></div>

    <!-- Medium bubble, top-right -->
    <div class="absolute -right-12 -top-16 h-56 w-56 rounded-full bg-brand/8 blur-2xl"></div>

    <!-- Small crisp bubble, mid-left -->
    <div class="absolute left-[18%] top-1/2 h-10 w-10 -translate-y-1/2 rounded-full bg-brand/15"></div>

    <!-- Tiny bubble, mid-right -->
    <div class="absolute right-[22%] top-1/3 h-6 w-6 rounded-full bg-brand/20"></div>

    <!-- Extra small bubble, near the logo -->
    <div class="absolute left-44 top-4 h-4 w-4 rounded-full bg-brand/25"></div>

    <!-- Faint ring bubble, far right -->
    <div class="absolute -bottom-10 right-8 h-24 w-24 rounded-full border-2 border-brand/15"></div>
  </div>


  <!-- ═══════════════════════════════════════════════════════════
       UTILITY BAR
  ════════════════════════════════════════════════════════════ -->
  <div class="relative hidden border-b border-gray-100 bg-white md:block">
    <div class="mx-auto flex h-9 w-full max-w-cococe items-center justify-between px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-semibold tracking-wide text-brand">
        Your one-stop marketplace
      </p>
      <div class="flex items-center gap-5 text-xs text-gray-600">
        <a href="#" class="transition hover:text-brand">Help</a>
        <a href="#" class="transition hover:text-brand">Contact</a>
        <a href="#" class="transition hover:text-brand">Track Order</a>
      </div>
    </div>
  </div>


  <!-- ═══════════════════════════════════════════════════════════
       MAIN HEADER
  ════════════════════════════════════════════════════════════ -->
  <div class="relative border-b border-gray-100 bg-white/90 backdrop-blur-sm">
    <div class="mx-auto w-full max-w-cococe px-4 sm:px-6 lg:px-8">
      <div class="flex min-h-[72px] items-center gap-3">

        <!-- Mobile menu button -->
        <button id="mobile-menu-button" type="button" aria-label="Open navigation menu" aria-expanded="false"
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg text-gray-700 transition hover:bg-brand-light hover:text-brand md:hidden">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

        <!-- Logo -->
        <a href="/" class="shrink-0">
          <img src="/images/logos/cococe.png" alt="Logo-brand" class="max-w-[120px]">
        </a>

        <!-- Desktop search -->
        <div class="relative ml-auto hidden min-w-0 flex-1 md:block md:max-w-3xl lg:mx-6">
          <label for="desktop-search" class="sr-only">Search products</label>
          <div class="relative">
            <input id="desktop-search" type="search"
                   placeholder="Search products, brands & categories..."
                   class="h-11 w-full rounded-lg border border-gray-200 bg-white px-4 pr-12 text-sm text-gray-900 outline-none placeholder:text-gray-400 transition focus:border-brand focus:ring-2 focus:ring-brand/20">
            <button type="button" aria-label="Search"
                    class="absolute right-0 top-0 flex h-11 w-12 items-center justify-center rounded-r-lg bg-brand text-white transition hover:bg-brand-dark">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" />
              </svg>
            </button>
          </div>
        </div>

        <!-- Account -->
        <a href="#" class="hidden shrink-0 items-center gap-2 rounded-lg px-3 py-2 text-gray-800 transition hover:bg-brand-light hover:text-brand lg:flex">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                  d="M15.75 6.75a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.5 20.25a7.5 7.5 0 0 1 15 0" />
          </svg>
          <span class="text-sm">Account</span>
        </a>

        <!-- Cart -->
        <a href="#" class="relative flex h-10 shrink-0 items-center gap-2 rounded-lg px-2 text-gray-800 transition hover:bg-brand-light hover:text-brand sm:px-3">
          <div class="relative">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                    d="M3 3h2l2.4 11.2a2 2 0 0 0 2 1.6h7.9a2 2 0 0 0 2-1.6L21 7H6" />
              <circle cx="10" cy="20" r="1.2" />
              <circle cx="18" cy="20" r="1.2" />
            </svg>
            <span id="cart-count"
                  class="absolute -right-2 -top-2 flex h-5 min-w-5 items-center justify-center rounded-full bg-brand px-1 text-[10px] font-bold text-white ring-2 ring-white">
              <%= cartCount %>
            </span>
          </div>
          <span class="hidden text-sm hover:inline transition">Cart</span>
        </a>

      </div>

      <!-- Mobile search -->
      <div class="pb-3 md:hidden">
        <label for="mobile-search" class="sr-only">Search products</label>
        <div class="relative">
          <input id="mobile-search" type="search" placeholder="Search products..."
                 class="h-11 w-full rounded-lg border border-gray-200 bg-white px-4 pr-12 text-sm text-gray-900 outline-none placeholder:text-gray-400 focus:border-brand focus:ring-2 focus:ring-brand/20">
          <button type="button" aria-label="Search"
                  class="absolute right-0 top-0 flex h-11 w-12 items-center justify-center rounded-r-lg bg-brand text-white transition hover:bg-brand-dark">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</header>