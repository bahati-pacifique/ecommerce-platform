<%
  // TEMP: hardcoded so we can verify the modal renders.
  // Remove this block once systemNotice is wired in server.js.
  const notice = typeof systemNotice !== 'undefined' && systemNotice
    ? systemNotice
    : {
        title: "We're having trouble reaching our services",
        message: "Some parts of the site may not load correctly right now. Please try again in a moment, or contact our support team if this continues.",
        supportEmail: 'sales@cococe.rw',
        supportPhone: '+250 787 195 425',
        supportHref: '/support',
        ctaLabel: 'Contact support',
        dismissLabel: 'Got it'
      };
%>

<% if (notice) { %>
<div id="notice-modal" class="fixed inset-0 z-[100] hidden items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="notice-modal-title" aria-describedby="notice-modal-description">

  <!-- Backdrop -->
  <div id="notice-modal-backdrop" class="absolute inset-0 bg-gray-950/60 backdrop-blur-sm" aria-hidden="true"></div>

  <!-- Panel -->
  <div class="relative w-full max-w-md overflow-hidden rounded-2xl bg-white shadow-2xl ring-1 ring-gray-200" role="document">

    <!-- Brand accent stripe -->
    <div class="h-1.5 w-full bg-gradient-to-r from-brand via-brand-dark to-brand"></div>

    <!-- Decorative bubble -->
    <div aria-hidden="true" class="pointer-events-none absolute -right-10 -top-10 h-32 w-32 rounded-full bg-brand/10 blur-2xl"></div>

    <div class="relative p-6 sm:p-7">

      <!-- Icon -->
      <div class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-light text-brand">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" />
        </svg>
      </div>

      <!-- Title -->
      <h2 id="notice-modal-title" class="mt-5 text-lg font-bold tracking-tight text-gray-950">
        <%= notice.title || "We're having trouble reaching our services" %>
      </h2>

      <!-- Description -->
      <p id="notice-modal-description" class="mt-2 text-sm leading-6 text-gray-600">
        <%= notice.message || "Some parts of the site may not load correctly right now. Please try again in a moment, or contact our support team if this continues." %>
      </p>

      <!-- Meta line -->
      <% if (notice.supportEmail || notice.supportPhone) { %>
      <div class="mt-4 rounded-lg bg-gray-50 px-4 py-3 text-xs text-gray-600">
        <p class="font-semibold text-gray-800">Need help now?</p>
        <p class="mt-1">
          <% if (notice.supportEmail) { %>
          Email <a href="mailto:<%= notice.supportEmail %>" class="font-medium text-brand hover:text-brand-dark underline underline-offset-2">
            <%= notice.supportEmail %>
          </a>
          <% } %>
          <% if (notice.supportEmail && notice.supportPhone) { %> · <% } %>
          <% if (notice.supportPhone) { %>
          Call <a href="tel:<%= notice.supportPhone.replace(/\s+/g, '') %>" class="font-medium text-brand hover:text-brand-dark underline underline-offset-2">
            <%= notice.supportPhone %>
          </a>
          <% } %>
          <span class="ps-2">
            If you are admin please got to <a href="<%=locals.protocal%>admin.<%=locals.domainName%>" class="font-medium text-brand hover:text-brand-dark underline underline-offset-2"> Admin Portal</a>
        </span>
        </p>
      </div>
      <% } %>

      <div class="mt-6 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
        <button type="button" id="notice-modal-dismiss" class="inline-flex min-h-10 items-center justify-center rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm font-semibold text-gray-800 transition hover:border-gray-300 hover:bg-gray-50">
          <%= notice.dismissLabel || 'Got it' %>
        </button>

        <% if (notice.supportHref) { %>
        <a href="<%= notice.supportHref %>" class="inline-flex min-h-10 items-center justify-center rounded-lg bg-brand px-4 py-2 text-sm font-bold text-white transition hover:bg-brand-dark">
          <%= notice.ctaLabel || 'Contact support' %>
        </a>
        <% } %>
      </div>

    </div>
  </div>
</div>
<% } %>