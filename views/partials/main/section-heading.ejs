<div class="flex items-end justify-between gap-4">
  <div>
    <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand"><%= eyebrow %></p>
    <h2 class="mt-2 text-2xl font-bold tracking-tight text-gray-950 sm:text-3xl"><%= title %></h2>
    <% if (typeof subtitle !== 'undefined' && subtitle) { %>
      <p class="mt-2 max-w-xl text-sm text-gray-500 sm:text-base"><%= subtitle %></p>
    <% } %>
  </div>

  <% if (typeof viewAllHref !== 'undefined') { %>
    <a href="<%= viewAllHref %>"
       class="hidden shrink-0 text-sm font-semibold text-brand transition hover:text-brand-dark sm:inline-flex sm:items-center">
      View all
      <svg class="ml-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6 6 6-6 6" />
      </svg>
    </a>
  <% } %>
</div>