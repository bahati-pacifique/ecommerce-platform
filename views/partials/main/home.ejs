<%- include('hero', { slides: heroSlides }) %>

<!-- CATEGORIES -->
<section id="categories" class="bg-bg-soft">
  <div class="mx-auto w-full max-w-cococe px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
    <%- include('section-heading', {
      eyebrow: 'Explore',
      title: 'Shop by Category',
      subtitle: 'Find the technology you need by exploring our product categories.',
      viewAllHref: '/categories'
    }) %>

    <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4">
      <% categories.forEach(category => { %>
      <%- include('category-card', { category }) %>
      <% }) %>
    </div>
  </div>
</section>

<!-- FEATURED PRODUCTS -->
<section id="featured-products" class="bg-white">
  <div class="mx-auto w-full max-w-cococe px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
    <%- include('section-heading', {
      eyebrow: 'Handpicked for you',
      title: 'Featured Products',
      subtitle: 'Explore some of our most popular technology picks.',
      viewAllHref: '/products'
    }) %>

    <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-4">
      <% featuredProducts.forEach(product => { %>
      <%- include('product-card', { product }) %>
      <% }) %>
    </div>
  </div>
</section>

<!-- DEALS -->
<section id="deals" class="bg-bg-soft">
  <div class="mx-auto w-full max-w-cococe px-4 py-12 sm:px-6 sm:py-16 lg:px-8">

    <div class="flex items-end justify-between gap-4">
      <div>
        <div class="flex items-center gap-2">
          <span class="flex h-7 w-7 items-center justify-center rounded-full bg-brand-light text-sm" aria-hidden="true">🔥</span>
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand">Limited-time offers</p>
        </div>
        <h2 class="mt-2 text-2xl font-bold tracking-tight text-gray-950 sm:text-3xl">Today's Deals</h2>
        <p class="mt-2 max-w-xl text-sm text-gray-500 sm:text-base">Save on selected technology while supplies last.</p>
      </div>
      <div class="hidden items-center gap-2 sm:flex">
        <button id="deals-prev" type="button" aria-label="Previous deals" class="flex h-10 w-10 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-700 shadow-sm transition hover:border-gray-300 hover:bg-gray-50">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15 18-6-6 6-6" />
          </svg>
        </button>
        <button id="deals-next" type="button" aria-label="Next deals" class="flex h-10 w-10 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-700 shadow-sm transition hover:border-gray-300 hover:bg-gray-50">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18 6-6-6-6" />
          </svg>
        </button>
      </div>
    </div>

    <div class="relative mt-8">
      <div id="deals-scroll-container" class="grid grid-cols-2 gap-3
            sm:flex sm:snap-x sm:snap-mandatory sm:gap-4 sm:overflow-x-auto sm:pb-4 sm:scrollbar-hide">
        <% dealProducts.forEach(product => { %>
        <%- include('deal-card', { product }) %>
        <% }) %>
      </div>
    </div>
  </div>
</section>

<!-- BRANDS -->
<section id="brands" class="bg-white">
  <div class="mx-auto w-full max-w-cococe px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
    <%- include('section-heading', {
      eyebrow: 'Trusted technology',
      title: 'Shop by Brand',
      subtitle: 'Discover products from brands you know and trust.',
      viewAllHref: '/brands'
    }) %>

    <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
      <% brands.forEach(brand => { %>
      <%- include('brand-tile', { brand }) %>
      <% }) %>
    </div>
  </div>
</section>

<!-- PROMOTION -->
<section id="promotion" class="bg-gray-950">
  <div class="mx-auto w-full max-w-cococe px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
    <div class="relative overflow-hidden rounded-2xl bg-brand px-6 py-10 sm:px-10 sm:py-14 lg:px-16 lg:py-16">
      <div aria-hidden="true" class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-white/10"></div>
      <div aria-hidden="true" class="absolute -bottom-32 right-24 h-80 w-80 rounded-full bg-black/10"></div>
      <div class="relative max-w-2xl">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-white/80">COCOCE special offer</p>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-white sm:text-4xl lg:text-5xl">
          Upgrade your technology.
        </h2>
        <p class="mt-4 max-w-xl text-sm leading-6 text-white/80 sm:text-base">
          Find laptops, gaming devices, accessories and more—all in one place.
        </p>
        <div class="mt-7">
          <a href="#" class="inline-flex min-h-11 items-center justify-center rounded-lg bg-white px-6 py-3 text-sm font-bold text-gray-950 transition hover:bg-gray-100">
            Shop now
            <svg class="ml-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6 6 6-6 6" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- WHY COCOCE -->
<section id="why-cococe" class="bg-white">
  <div class="mx-auto w-full max-w-cococe px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand">The COCOCE difference</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-gray-950 sm:text-3xl">Shopping made simple</h2>
      <p class="mt-3 text-sm leading-6 text-gray-500 sm:text-base">
        Everything you need for your technology journey, backed by a simple and reliable shopping experience.
      </p>
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <% benefits.forEach(benefit => { %>
      <%- include('benefit-card', { benefit }) %>
      <% }) %>
    </div>
  </div>
</section>

