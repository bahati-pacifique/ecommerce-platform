<section aria-labelledby="hero-heading" class="overflow-hidden bg-white">
  <div class="mx-auto w-full max-w-cococe px-4 py-6 sm:px-6 sm:py-8 lg:px-8 lg:py-10">
    <div class="relative overflow-hidden rounded-2xl hero-gradient-bg">
      <div aria-hidden="true" class="absolute inset-0 hero-pattern-overlay"></div>
      <div aria-hidden="true" class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-white/10 blur-3xl"></div>
      <div aria-hidden="true" class="absolute -bottom-32 -left-20 h-72 w-72 rounded-full bg-black/10 blur-3xl"></div>

      <div class="relative flex flex-col lg:min-h-[500px] lg:flex-row">
        <div class="flex w-full flex-col justify-center px-6 pb-8 pt-10 sm:px-10 sm:pb-10 sm:pt-12 lg:w-[48%] lg:px-12 lg:py-16 xl:px-16">
          <div class="mb-5">
            <span class="inline-flex items-center rounded-full border border-white/20 bg-white/10 px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.16em] text-white backdrop-blur">
              COCOCE Electronics
            </span>
          </div>
          <h1 id="hero-heading"
              class="max-w-xl text-4xl font-extrabold leading-[1.05] tracking-tight text-white sm:text-5xl lg:text-5xl xl:text-6xl">
            Technology for the
            <span class="text-white underline decoration-white/40 decoration-4 underline-offset-4">way you live.</span>
          </h1>
          <p class="mt-5 max-w-lg text-sm leading-6 text-white/90 sm:text-base sm:leading-7">
            Discover laptops, computers, gaming gear, accessories and more — all in one place.
          </p>
          <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a href="#featured-products"
               class="inline-flex min-h-11 items-center justify-center rounded-lg bg-white px-6 py-3 text-sm font-bold text-gray-950 shadow-lg transition hover:bg-gray-100">
              Shop Now
              <svg class="ml-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6 6 6-6 6" />
              </svg>
            </a>
            <a href="#categories"
               class="inline-flex min-h-11 items-center justify-center rounded-lg border border-white/30 bg-white/10 px-6 py-3 text-sm font-semibold text-white backdrop-blur transition hover:bg-white/20">
              Explore Categories
            </a>
          </div>
          <div class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-xs text-white/80">
            <span class="flex items-center gap-1.5"><span class="text-white">✓</span> Genuine products</span>
            <span class="flex items-center gap-1.5"><span class="text-white">✓</span> Secure checkout</span>
            <span class="flex items-center gap-1.5"><span class="text-white">✓</span> Customer support</span>
          </div>
        </div>

        <div class="relative flex min-h-[300px] w-full items-center justify-center px-5 pb-12 sm:min-h-[360px] sm:px-8 lg:min-h-0 lg:w-[52%] lg:px-10 lg:py-10">
          <div aria-hidden="true" class="absolute h-64 w-64 rounded-full border border-white/15 sm:h-80 sm:w-80 lg:h-[420px] lg:w-[420px]"></div>
          <div aria-hidden="true" class="absolute h-48 w-48 rounded-full border border-white/25 sm:h-64 sm:w-64 lg:h-80 lg:w-80"></div>

          <div id="hero-slider" class="relative z-10 w-full max-w-[520px]"></div>

          <button id="hero-prev" type="button" aria-label="Previous hero slide"
                  class="absolute left-3 top-1/2 z-30 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-white/20 bg-black/30 text-white shadow-lg backdrop-blur transition hover:bg-black/50 sm:left-5 lg:left-4">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15 18-6-6 6-6" />
            </svg>
          </button>
          <button id="hero-next" type="button" aria-label="Next hero slide"
                  class="absolute right-3 top-1/2 z-30 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-white/20 bg-black/30 text-white shadow-lg backdrop-blur transition hover:bg-black/50 sm:right-5 lg:right-4">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18 6-6-6-6" />
            </svg>
          </button>

          <div id="hero-dots" class="absolute bottom-3 left-1/2 z-30 flex -translate-x-1/2 items-center gap-2"
               role="tablist" aria-label="Hero slides"></div>

          <div id="hero-badge"
               class="absolute bottom-10 left-5 z-20 hidden rounded-xl border border-white/20 bg-black/40 px-4 py-3 shadow-xl backdrop-blur sm:block lg:bottom-10 lg:left-6">
            <p class="text-[10px] font-semibold uppercase tracking-wider text-white/70">Featured</p>
            <p id="hero-badge-text" class="mt-1 text-sm font-semibold text-white">Latest technology</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Pass slides to the client for the carousel -->
<script>
  window.__HERO_SLIDES__ = <%- JSON.stringify(slides) %>;
</script>