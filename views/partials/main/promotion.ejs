<%
  const p = typeof promo !== 'undefined' ? promo : {};
  const eyebrow        = p.eyebrow        || 'Featured collection';
  const heading        = p.heading        || 'The new standard in performance.';
  const description    = p.description    || 'Discover our curated selection of premium laptops, engineered for people who take their work seriously.';
  const ctaLabel       = p.ctaLabel       || 'Explore the collection';
  const ctaHref        = p.ctaHref        || '/category/laptops';
  const secondaryLabel = p.secondaryLabel || null;
  const secondaryHref  = p.secondaryHref  || '#';
  const image          = p.image          || 'https://images.unsplash.com/photo-1517336714731-489689fd1ca8?w=800&h=600&fit=crop&auto=format';
%>

<section id="promotion" class="bg-white">
  <div class="mx-auto w-full max-w-cococe px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
    <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-brand-light via-white to-brand-ultralight ring-1 ring-brand/10">

      <!-- Soft bubbles -->
      <div aria-hidden="true" class="pointer-events-none absolute inset-0">
        <div class="absolute -left-16 -top-20 h-64 w-64 rounded-full bg-brand/10 blur-3xl"></div>
        <div class="absolute -bottom-24 right-1/3 h-72 w-72 rounded-full bg-brand/8 blur-3xl"></div>
      </div>

      <div class="relative grid items-center gap-8 lg:grid-cols-2">

        <!-- Copy -->
        <div class="px-6 pb-4 pt-10 sm:px-10 sm:pt-12 lg:py-16 lg:pl-12 lg:pr-6 xl:pl-16">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand">
            <%= eyebrow %>
          </p>

          <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-gray-950 sm:text-4xl lg:text-5xl">
            <%= heading %>
          </h2>

          <p class="mt-4 max-w-xl text-sm leading-6 text-gray-600 sm:text-base">
            <%= description %>
          </p>

          <div class="mt-7 flex flex-wrap gap-3">
            <a href="<%= ctaHref %>"
               class="inline-flex min-h-11 items-center justify-center rounded-lg bg-brand px-6 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-brand-dark">
              <%= ctaLabel %>
              <svg class="ml-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6 6 6-6 6" />
              </svg>
            </a>

            <% if (secondaryLabel) { %>
              <a href="<%= secondaryHref %>"
                 class="inline-flex min-h-11 items-center justify-center rounded-lg border border-gray-200 bg-white px-6 py-3 text-sm font-semibold text-gray-900 transition hover:border-gray-300 hover:bg-gray-50">
                <%= secondaryLabel %>
              </a>
            <% } %>
          </div>
        </div>

        <!-- Image -->
        <div class="relative h-64 overflow-hidden sm:h-80 lg:h-full lg:min-h-[420px]">
          <img src="<%= image %>" alt="<%= heading %>"
               class="h-full w-full object-cover" loading="lazy">
          <!-- Soft fade into the gradient panel -->
          <div aria-hidden="true" class="absolute inset-y-0 left-0 hidden w-16 bg-gradient-to-r from-white/60 to-transparent lg:block"></div>
        </div>

      </div>

    </div>
  </div>
</section>