<%function formatMoney(amount, currencyCode = 'USD') {
    const numericAmount = Number(amount);
    if (amount == null || Number.isNaN(numericAmount)) return '';

    return new Intl.NumberFormat('en-RW', {
        style: 'currency',
        currency: currencyCode,
        currencyDisplay: 'code',
        maximumFractionDigits: 0,
    }).format(numericAmount);
}
function truncate(str = '', limit = 10) {
    if (str.length <= limit) {
        return str;
    }
    // .trim()/.rstrip() avoid a space before the ellipsis
    return str.slice(0, limit).trimEnd() + "...";
}

const listingCheckBtnTxts = ['View', 'Check it out', 'Preview', 'Check', 'Continue', 'Buy now']
const cardBtnTxt = (arr) => arr[Math.floor(Math.random() * arr.length)];
%>
<article class="product-card group flex flex-col overflow-hidden rounded-xl border border-gray-200 bg-white transition duration-200">
  <div class="relative aspect-square overflow-hidden bg-gray-100">
    <img src="https://cdn.cococe.rw/<%= listing.media_key %>" alt="<%= listing.name %>" class="h-full w-full object-contain transition duration-300 group-hover:scale-105" loading="lazy">

    <% if (listing.condition) { %>
    <span class="absolute left-2 top-2 rounded-full bg-brand px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-white">
      <%= listing.condition %>
    </span>
    <% } %>

    <% if (listing.discount_percentage && Number(listing.discount_percentage) > 0) { %>
    <span class="absolute right-2 top-2 rounded-full bg-brand-dark px-2.5 py-1.5 text-[10px] font-bold text-white">
      -<%= Math.trunc(listing.discount_percentage) %>%
    </span>
    <% } %>
  </div>

  <div class="flex flex-1 flex-col p-3 sm:p-4">

    <div class="flex flex-col gap-1">
      <h3 class="line-clamp-2 text-sm font-semibold text-gray-900 sm:text-base">
        <%= listing.listing_title %>
      </h3>
      <h4 class="line-clamp-2 text-xs font-semibold text-gray-400">
        <%= truncate(listing.sku.replace(/[-_]/g, " "), 40) %>
      </h4>
    </div>

    <%if (listing.rating && Number(listing.rating) > 0){%>
    <div class="mt-1.5 flex items-center gap-1">
      <%- include('star-rating', { rating: listing.rating }) %>
      <span class="text-xs text-gray-400">(<%= listing.rating_reviews %>)</span>
    </div>
    <%}%>

    <div class="mt-2 flex items-baseline gap-2">
      <span class="text-lg font-bold text-gray-900"> <%= formatMoney(listing.current_price, listing.currency_code) %></span>
    <% if (listing.is_on_sale) { %>
    <span class="text-sm text-gray-400 line-through"><%=formatMoney(listing.regular_price, listing.currency_code) %></span>
    <% } %>
  </div>

  <a href="/l?i=<%= listing.listing_id %>" class="mt-3 w-full rounded-lg bg-brand px-2 md:px-3 py-2 text-xs font-bold text-white transition hover:bg-brand-dark sm:text-sm flex items-center gap-1 justify-center" data-id="<%= listing.listing_id %>">
    <%= cardBtnTxt(listingCheckBtnTxts)%>
  </a>
  </div>
</article>