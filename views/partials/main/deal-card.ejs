<article class="deal-card overflow-hidden rounded-xl border border-gray-200 bg-white
                sm:w-[240px] sm:shrink-0 sm:snap-start">
  <div class="relative aspect-square overflow-hidden bg-gray-100">
    <img src="<%= product.image %>" alt="<%= product.name %>" class="h-full w-full object-cover transition duration-300 group-hover:scale-105" loading="lazy">

    <% if (product.badge) { %>
    <span class="absolute left-2 top-2 rounded-full bg-brand px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-white">
      <%= product.badge %>
    </span>
    <% } %>

    <% if (product.originalPrice && product.originalPrice > product.price) { %>
    <span class="absolute right-2 top-2 rounded-full bg-brand-dark px-2.5 py-1 text-[10px] font-bold text-white">
      -<%= Math.round((1 - product.price / product.originalPrice) * 100) %>%
    </span>
    <% } %>
  </div>

  <div class="flex flex-1 flex-col p-3 sm:p-4">
    <h3 class="line-clamp-2 text-sm font-semibold text-gray-900 sm:text-base">
      <%= product.name %>
    </h3>

    <div class="mt-1.5 flex items-center gap-1">
      <%- include('star-rating', { rating: product.rating }) %>
      <span class="text-xs text-gray-400">(<%= product.reviews %>)</span>
    </div>

    <div class="mt-2 flex items-baseline gap-2">
      <span class="text-lg font-bold text-gray-900">Rwfr <%= product.price.toFixed(2) %></span>
      <% if (product.originalPrice) { %>
      <span class="text-sm text-gray-400 line-through">Rwfr <%= product.originalPrice.toFixed(2) %></span>
      <% } %>
    </div>

    <button class="add-to-cart mt-3 w-full rounded-lg bg-brand py-2 text-xs font-bold text-white transition hover:bg-brand-dark sm:text-sm" data-id="<%= product.id %>">
      Add to Cart
    </button>
  </div>
</article>