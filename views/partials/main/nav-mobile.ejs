<div id="mobile-menu" class="hidden border-b border-gray-200 bg-white md:hidden">
  <nav class="mx-auto max-w-cococe px-4 py-4">
    <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-gray-500">Shop</p>
    <div class="grid grid-cols-2 gap-2">
      <% categories.forEach(cat => { %>
        <a href="/shop-by-categories/<%= cat.title %>" target="_blank"
           class="whitespace-nowrap px-4 py-4 text-sm font-medium transition hover:text-brand">
          <%= cat.title %>
        </a>
      <% }) %>
    </div>
  </nav>
</div>