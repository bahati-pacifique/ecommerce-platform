<footer class="w-full bg-white shadow-[0_-8px_30px_rgb(0,0,0,0.04)] border-t border-gray-100">
  <div class="mx-auto max-w-7xl px-4 py-3 md:flex md:items-center md:justify-between lg:px-8">

    <div class="flex justify-center">
      <a href="<%=locals.baseUrl || '/'%>" class="flex items-center gap-2">
        <img src="/images/logos/fav.png" alt="Logo" class="h-8">
        <span class="text-xl font-bold tracking-tight text-brand">COCOCE</span>
      </a>
    </div>

    <div class="mt-4 md:order-2 md:mt-0 flex max-md:flex-col md:items-center gap-3">
      <% navs?.forEach(nav=>{%>
      <a href="<%=nav.link%>" class="text-gray-600 hover:underline hover:text-brand"><%=nav.title%></a>
      <%})%>
      <p class="text-center text-sm leading-5 text-gray-500">
        &copy; 2026 COCOCE. All rights reserved.
      </p>
    </div>

  </div>
</footer>