<%
  const tones = {
    brand:   'bg-[var(--color-brand-ultralight)] text-[var(--color-brand)]',
    violet:  'bg-violet-50 text-violet-600',
    emerald: 'bg-emerald-50 text-emerald-600',
    amber:   'bg-amber-50 text-amber-600',
    orange:  'bg-orange-50 text-orange-600',
  };
  const toneClass = tones[tone] || tones.brand;
%>
<div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
  <div class="flex items-center justify-between">
    <span class="text-sm text-slate-500"><%= label %></span>
    <span class="rounded-lg p-2 <%= toneClass %>">
      <i data-lucide="<%= icon %>" class="h-4 w-4"></i>
    </span>
  </div>
  <div class="mt-4 text-2xl font-bold"><%= value %></div>
  <% if (typeof change !== 'undefined') { %>
    <div class="mt-1 text-xs">
      <span class="font-semibold <%= change.startsWith('-') ? 'text-rose-600' : 'text-emerald-600' %>"><%= change %></span>
      <span class="ml-1 text-slate-400">vs previous period</span>
    </div>
  <% } %>
</div>