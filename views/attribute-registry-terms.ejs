      background: #EFF6FF;
      border: 1px solid #BFDBFE;
      color: #1E3A8A;
    }

    .callout-warn {
      background: #FFFBEB;
      border: 1px solid #FDE68A;
      color: #92400E;
    }

    .callout-danger {
      background: #FEF2F2;
