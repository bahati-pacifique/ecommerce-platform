  <style>
    html {
      -webkit-text-size-adjust: 100%;
      scroll-behavior: smooth;
      scrollbar-gutter: stable;
      overflow-x: clip;
    }

    body {
      font-family: 'Inter', system-ui, sans-serif;
      background: #F8FAFC;
      color: #0F172A;
      min-height: 100vh;
      margin: 0;
      overflow-x: clip;
    }

    html,
    body {
      min-width: 0;
      max-width: 100%;
    }

    [id] {
      scroll-margin-top: 88px;
    }

    .prose-doc {
      color: #334155;
      line-height: 1.75;
      font-size: 15px;
    }

    .prose-doc p {
      margin: 0 0 1rem;
    }

    .prose-doc strong {
      color: #0F172A;
      font-weight: 600;
    }

    .prose-doc a {
      color: #ED1B24;
      text-decoration: none;
      border-bottom: 1px solid rgba(237, 27, 36, 0.25);
      transition: border-color .15s ease;
    }

    .prose-doc a:hover {
      border-color: #ED1B24;
    }

    .prose-doc ul,
    .prose-doc ol {
      margin: 0 0 1rem 1.25rem;
      padding: 0;
    }

    .prose-doc li {
      margin-bottom: .4rem;
    }

    .prose-doc code {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.85em;
      background: #F1F5F9;
      border: 1px solid #E2E8F0;
      border-radius: 4px;
      padding: 1px 5px;
      color: #0F172A;
    }

    .toc-link.active {
      color: #ED1B24;
      border-left-color: #ED1B24;
      font-weight: 600;
    }

    @media print {

      header,
      footer,
      aside,
      .no-print {
        display: none !important;
      }

      body {
        background: white;
      }

      .prose-doc {
        font-size: 12pt;
      }

      a {
        border: none;
        color: #0F172A;
      }
    }
  </style>
</head>

<body>

