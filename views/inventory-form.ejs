<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>COCOCE — Create Inventory</title>
  <link rel="icon" href="/favicon.ico" type="image/x-icon">

  <meta name="description" content="COCOCE — Admin portal, COCOCE Kigali Rwanda, Laptops, Desktops, Computer accessories, Smart tv, projectors, discover what you want about digital assets near you at Kigali">
  <meta name="keywords" content="Laptops, Desktops, Memories, Storages, Servers, keyboards, Printers, Screens, Repair, Explore, Electronic, Digital, Kigali, Rwanda">
  <meta name="author" content="COCOCE RW">

  <meta property="og:image" content="https://cdn.cococe.rw/meta/cococe.png">
  <meta property="og:url" content="https://www.cococe.rw">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Laptops, Printers, Accessories, Game consoles, Electronics, and much more, cococe, your wish our priority">
  <meta property="og:description" content="COCOCE Kigali Rwanda, Laptops, Desktops, Computer accessories, Smart tv, projectors, discover what you want about digital assets near you at Kigali">
  <meta property="og:logo" content="https://cdn.cococe.rw/meta/cococe.png" />

  <meta name="twitter:card" content="https://cdn.cococe.rw/meta/cococe.png">
  <meta property="twitter:domain" content="https://cococe.rw">
  <meta property="twitter:url" content="https://cococe.rw">
  <meta name="twitter:title" content="Laptops, Printers, Accessories, Game consoles, Electronics, and much more, cococe, your wish our priority">
  <meta name="twitter:description" content="COCOCE Kigali Rwanda, Laptops, Desktops, Computer accessories, Smart tv, projectors, discover what you want about digital assets near you at Kigali">

  <script src="https://code.jquery.com/jquery-3.7.1.js" integrity="sha256-eKhayi8LEQwp4NKxN+CfCh+3qOVUtJn3QNZ0TciWLP4=" crossorigin="anonymous"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.11.0/axios.min.js" integrity="sha512-h9644v03pHqrIHThkvXhB2PJ8zf5E9IyVnrSfZg8Yj8k4RsO4zldcQc4Bi9iVLUCCsqNY0b4WXVV4UB+wbWENA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

  <link rel="icon" href="/favicon.ico" type="image/x-icon">

  <link rel="stylesheet" href="/styles/components/notification.css">
  <link rel="stylesheet" href="/styles/components/main-snackbar.css">
  <link rel="stylesheet" href="/styles/components/loaders.css">
  <link rel="stylesheet" href="/styles/main.css">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>

  <link rel="stylesheet" href="/styles/components/notification.css">
  <link rel="stylesheet" href="/styles/components/main-snackbar.css">

  <link rel="stylesheet" href="/styles/i-form.css">
</head>

<body>

  <header class="border-b border-ink-200/70 bg-white/80 backdrop-blur sticky top-0 z-30">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 h-20 flex items-center justify-between">

      <a href="/dashboard" class="flex items-center gap-2 text-ink-700 hover:text-ink-900 transition">
        <img src="/images/logos/business.png" alt="COCOCE" class="h-12">
      </a>

      <div class="flex flex-items gap-3">

        <a class="flex items-center gap-2 text-sm font-bold business-name-badge">
          <i data-lucide="user" class="text-brand"></i> 
          <%- locals.user.vendor?.business_name %>
        </a>
        <a href="mailto:sales@cococe.rw" id="helpLink" class="text-xs font-medium text-ink-500 hover:text-ink-900 transition flex items-center gap-1.5">
          <i data-lucide="circle-help" class="w-4 h-4"></i> Help
        </a>

      </div>

    </div>
  </header>

  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-6 sm:py-10">

    <nav aria-label="Breadcrumb" class="mb-5">
      <ol id="breadcrumb" class="flex flex-wrap items-center gap-1.5 text-xs sm:text-sm text-ink-500">
        <li><a href="/stores" class="hover:text-ink-900 transition">Stores</a></li>
        <li aria-hidden="true" class="text-ink-300">/</li>
        <li><a href="/inventory" class="hover:text-ink-900 transition">Inventory</a></li>
        <li aria-hidden="true" class="text-ink-300">/</li>
        <li aria-current="page" class="text-ink-900 font-medium">Create</li>
      </ol>
    </nav>

    <div class="mb-6 sm:mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink-900">Create Inventory</h1>
      <p id="pageSubtitle" class="mt-1.5 text-sm text-ink-500">Choose a store and add a stock location for it.</p>
    </div>

    <div class="mb-6 sm:mb-8" aria-label="Progress">
      <ol class="flex items-center gap-3">
        <li class="flex items-center gap-2.5 flex-1 min-w-0" data-step="0">
          <span class="step-dot bg-brand text-white" data-step-dot="0">1</span>
          <span class="text-sm font-semibold text-ink-900 truncate">Store</span>
        </li>
        <li class="step-line" data-step-line="0" aria-hidden="true"></li>
        <li class="flex items-center gap-2.5 flex-1 min-w-0" data-step="1">
          <span class="step-dot bg-ink-100 text-ink-500" data-step-dot="1">2</span>
          <span class="text-sm font-medium text-ink-500 truncate">Details</span>
        </li>
        <li class="step-line" data-step-line="1" aria-hidden="true"></li>
        <li class="flex items-center gap-2.5 flex-1 min-w-0 justify-end" data-step="2">
          <span class="step-dot bg-ink-100 text-ink-500" data-step-dot="2">3</span>
          <span class="text-sm font-medium text-ink-500 truncate">Review</span>
        </li>
      </ol>
    </div>

    <div class="bg-white border border-ink-200/70 rounded-2xl shadow-soft overflow-hidden">

      <section id="step0" class="p-5 sm:p-7">
        <header class="mb-5">
          <h2 class="text-lg font-semibold text-ink-900">Choose a store</h2>
          <p class="text-sm text-ink-500 mt-0.5">This inventory will belong to the store you select.</p>
        </header>

        <div id="noStoresState" class="hidden rounded-xl border border-dashed border-ink-200 p-8 text-center">
          <div class="mx-auto w-12 h-12 rounded-full bg-ink-100 flex items-center justify-center">
            <i data-lucide="store" class="w-5 h-5 text-ink-400"></i>
          </div>
          <h3 class="mt-3 text-sm font-semibold text-ink-900">No stores yet</h3>
          <p class="mt-1 text-xs text-ink-500 max-w-xs mx-auto">
            You need to create a store before you can add an inventory to it.
          </p>
          <a href="/stores/create" target="_blank" class="mt-4 inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-brand text-white text-sm font-semibold hover:bg-brand-dark transition">
            <i data-lucide="plus" class="w-4 h-4"></i> Create Store
          </a>
        </div>

        <div id="storeList" class="space-y-2.5" role="radiogroup" aria-label="Choose a store"></div>

        <p id="storeError" class="hidden mt-3 text-xs text-red-600 flex items-center gap-1">
          <i data-lucide="alert-circle" class="w-3.5 h-3.5"></i>
          <span>Please choose a store to continue.</span>
        </p>
      </section>

      <section id="step1" class="hidden p-5 sm:p-7">
        <div class="mb-5 -mx-5 sm:-mx-7 -mt-5 sm:-mt-7 px-5 sm:px-7 py-3.5 bg-ink-50 border-b border-ink-200/70 flex items-center justify-between gap-3">
          <div class="flex items-center gap-2.5 min-w-0">
            <i data-lucide="store" class="w-4 h-4 text-ink-400 flex-shrink-0"></i>
            <div class="min-w-0">
              <p class="text-[11px] uppercase tracking-wider font-semibold text-ink-400 leading-none">Store</p>
              <p id="storeContextName" class="text-sm font-semibold text-ink-900 truncate mt-0.5">—</p>
            </div>
          </div>
          <button type="button" id="changeStoreBtn" class="text-xs font-semibold text-brand hover:text-brand-dark transition inline-flex items-center gap-1">
            <i data-lucide="pencil" class="w-3 h-3"></i> Change
          </button>
        </div>

        <header class="mb-6">
          <h2 class="text-lg font-semibold text-ink-900">Inventory Details</h2>
          <p class="text-sm text-ink-500 mt-0.5">Add the basic information for this stock location.</p>
        </header>

        <form id="inventoryForm" novalidate class="space-y-5">
          <div class="field" data-field="title">
            <label for="title" class="block text-sm font-medium text-ink-900 mb-1.5">
              Inventory name <span class="text-brand">*</span>
            </label>
            <input id="title" name="title" type="text" maxlength="255" autocomplete="off" placeholder="e.g. Main Warehouse" aria-required="true" class="focus-brand w-full px-3.5 py-2.5 rounded-xl border border-ink-200 bg-white text-sm text-ink-900 placeholder:text-ink-400 transition">
            <div class="mt-1.5 flex items-start justify-between gap-3">
              <p class="text-xs text-ink-400">
                Try: <span class="text-ink-500">Main Warehouse</span> ·
                <span class="text-ink-500">Kigali Branch</span> ·
                <span class="text-ink-500">Back Storage</span> ·
                <span class="text-ink-500">Downtown Warehouse</span>
              </p>
              <span id="titleCount" class="text-[11px] text-ink-400 tabular-nums flex-shrink-0">0/255</span>
            </div>
            <p class="field-msg hidden mt-1.5 text-xs text-red-600 flex items-center gap-1">
              <i data-lucide="alert-circle" class="w-3.5 h-3.5"></i><span></span>
            </p>
          </div>

          <div class="field" data-field="description">
            <label for="description" class="block text-sm font-medium text-ink-900 mb-1.5">
              Description <span class="text-ink-400 font-normal">(optional)</span>
            </label>
            <textarea id="description" name="description" rows="3" placeholder="Describe this inventory location..." class="focus-brand w-full px-3.5 py-2.5 rounded-xl border border-ink-200 bg-white text-sm text-ink-900 placeholder:text-ink-400 transition resize-y min-h-[84px]"></textarea>
            <p class="text-xs text-ink-400 mt-1.5">
              Example: <span class="text-ink-500">Primary stock location for phones and electronics.</span>
            </p>
          </div>

          <div class="field" data-field="address">
            <label for="address" class="block text-sm font-medium text-ink-900 mb-1.5">
              Address <span class="text-ink-400 font-normal">(optional)</span>
            </label>
            <textarea id="address" name="address" rows="2" placeholder="e.g. KN 5 Rd, Kigali, Rwanda" class="focus-brand w-full px-3.5 py-2.5 rounded-xl border border-ink-200 bg-white text-sm text-ink-900 placeholder:text-ink-400 transition resize-y min-h-[64px]"></textarea>
            <p class="text-xs text-ink-400 mt-1.5">Enter the physical location where this inventory is stored.</p>
          </div>

          <div class="rounded-xl border border-ink-200/80 bg-ink-50/40 p-4">
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <label for="is_default" class="block text-sm font-medium text-ink-900">Set as default inventory</label>
                <p class="text-xs text-ink-500 mt-0.5">Use this as the primary inventory for this store.</p>
              </div>
              <button type="button" id="is_default" role="switch" aria-checked="false" aria-labelledby="is_default_label" class="switch mt-0.5"></button>
            </div>
            <div id="defaultConflict" class="hidden mt-3 pt-3 border-t border-ink-200/80">
              <div class="flex items-start gap-2.5">
                <i data-lucide="info" class="w-4 h-4 text-amber-500 flex-shrink-0 mt-0.5"></i>
                <div class="text-xs text-ink-700 leading-relaxed">
                  <strong id="defaultConflictName" class="font-semibold text-ink-900">Main Warehouse</strong>
                  is currently the default inventory for this store.
                  Setting this inventory as default will replace it.
                </div>
              </div>
            </div>
          </div>

          <div class="field" data-field="status">
            <label for="status" class="block text-sm font-medium text-ink-900 mb-1.5">Status</label>
            <div class="relative max-w-[220px]">
              <select id="status" name="status" class="focus-brand w-full appearance-none px-3.5 py-2.5 pr-10 rounded-xl border border-ink-200 bg-white text-sm text-ink-900 transition">
                <option value="active" selected>Active</option>
                <option value="inactive">Inactive</option>
              </select>
              <i data-lucide="chevron-down" class="w-4 h-4 text-ink-400 absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none"></i>
            </div>
            <p class="text-xs text-ink-400 mt-1.5">Inactive inventories cannot normally be used for active stock operations.</p>
          </div>
        </form>

        <div class="mt-8 pt-5 border-t border-ink-200/70 flex flex-col-reverse sm:flex-row sm:items-center sm:justify-between gap-3">
          <button type="button" id="cancelBtn" class="w-full sm:w-auto px-4 py-2.5 rounded-xl border border-ink-200 bg-white text-sm font-medium text-ink-700 hover:bg-ink-50 transition">
            Cancel
          </button>
          <button type="button" id="continueBtn" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-brand text-white text-sm font-semibold hover:bg-brand-dark transition disabled:opacity-50 disabled:cursor-not-allowed">
            Continue <i data-lucide="arrow-right" class="w-4 h-4"></i>
          </button>
        </div>
      </section>

      <section id="step2" class="hidden p-5 sm:p-7">
        <header class="mb-6">
          <h2 class="text-lg font-semibold text-ink-900">Review Inventory</h2>
          <p class="text-sm text-ink-500 mt-0.5">Review the inventory information before creating it.</p>
        </header>

        <div class="rounded-xl border border-ink-200/80 divide-y divide-ink-200/70 overflow-hidden">
          <div class="p-4 sm:p-5 flex items-start gap-4">
            <div class="w-9 h-9 rounded-lg bg-ink-100 text-ink-500 flex items-center justify-center flex-shrink-0">
              <i data-lucide="store" class="w-4 h-4"></i>
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-center justify-between gap-3">
                <p class="text-[11px] uppercase tracking-wider font-semibold text-ink-400">Store</p>
                <button type="button" data-edit-step="0" class="text-xs font-semibold text-brand hover:text-brand-dark transition inline-flex items-center gap-1">
                  <i data-lucide="pencil" class="w-3 h-3"></i> Change
                </button>
              </div>
              <p id="rv-store" class="text-sm font-semibold text-ink-900 mt-0.5 truncate">—</p>
            </div>
          </div>

          <div class="p-4 sm:p-5">
            <div class="flex items-center justify-between mb-3">
              <p class="text-[11px] uppercase tracking-wider font-semibold text-ink-400">Inventory</p>
              <button type="button" data-edit-step="1" class="text-xs font-semibold text-brand hover:text-brand-dark transition inline-flex items-center gap-1">
                <i data-lucide="pencil" class="w-3 h-3"></i> Edit
              </button>
            </div>
            <dl class="space-y-3">
              <div class="grid grid-cols-1 sm:grid-cols-[140px_1fr] gap-1 sm:gap-4">
                <dt class="text-xs font-medium text-ink-500">Name</dt>
                <dd id="rv-title" class="text-sm font-medium text-ink-900 break-words">—</dd>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-[140px_1fr] gap-1 sm:gap-4">
                <dt class="text-xs font-medium text-ink-500">Description</dt>
                <dd id="rv-description" class="text-sm text-ink-700 break-words">—</dd>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-[140px_1fr] gap-1 sm:gap-4">
                <dt class="text-xs font-medium text-ink-500">Address</dt>
                <dd id="rv-address" class="text-sm text-ink-700 break-words">—</dd>
              </div>
            </dl>
          </div>

          <div class="p-4 sm:p-5 bg-ink-50/40">
            <dl class="space-y-3">
              <div class="flex items-center justify-between gap-3">
                <dt class="text-xs font-medium text-ink-500">Default inventory</dt>
                <dd id="rv-default" class="text-sm font-semibold text-ink-900">No</dd>
              </div>
              <div class="flex items-center justify-between gap-3">
                <dt class="text-xs font-medium text-ink-500">Status</dt>
                <dd id="rv-status"></dd>
              </div>
            </dl>
          </div>
        </div>

        <div id="submitError" class="hidden mt-5 rounded-xl border border-red-200 bg-red-50 p-4 flex items-start gap-3">
          <i data-lucide="alert-triangle" class="w-5 h-5 text-red-600 flex-shrink-0 mt-0.5"></i>
          <div class="min-w-0">
            <p class="text-sm font-semibold text-red-800">We couldn't create the inventory.</p>
            <p id="submitErrorMsg" class="text-xs text-red-700 mt-0.5">Please try again.</p>
          </div>
        </div>

        <div class="mt-8 pt-5 border-t border-ink-200/70 flex flex-col-reverse sm:flex-row sm:items-center sm:justify-between gap-3">
          <button type="button" id="backBtn" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl border border-ink-200 bg-white text-sm font-medium text-ink-700 hover:bg-ink-50 transition">
            <i data-lucide="arrow-left" class="w-4 h-4"></i> Back
          </button>
          <button type="button" id="createBtn" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-brand text-white text-sm font-semibold hover:bg-brand-dark transition disabled:opacity-60 disabled:cursor-not-allowed">
            <span class="btn-label inline-flex items-center gap-2 hidden">
              <i data-lucide="plus" class="w-4 h-4"></i> Create Inventory
            </span>
          </button>
        </div>
      </section>

      <section id="stepSuccess" class="hidden p-6 sm:p-10 text-center">
        <div class="mx-auto w-16 h-16 rounded-full bg-emerald-50 flex items-center justify-center pop-in">
          <div class="w-11 h-11 rounded-full bg-emerald-500 flex items-center justify-center">
            <i data-lucide="check" class="w-6 h-6 text-white" stroke-width="3"></i>
          </div>
        </div>
        <h2 class="mt-5 text-xl sm:text-2xl font-bold text-ink-900">Inventory created successfully</h2>
        <p class="mt-2 text-sm text-ink-500 max-w-md mx-auto">
          <strong id="successInvName" class="text-ink-900">—</strong> is now available for
          <strong id="successStoreName" class="text-ink-900">—</strong>.
        </p>
        <div class="mt-7 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a id="viewInventoryBtn" href="/dashboard" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-brand text-white text-sm font-semibold hover:bg-brand-dark transition">
            Go To Dashboard
          </a>
          <a id="addStockBtn" href="/" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl border border-ink-200 bg-white text-sm font-medium text-ink-700 hover:bg-ink-50 transition hidden">
             Go Home <i data-lucide="move-right"></i>
          </a>
        </div>
        <p class="mt-6 text-xs text-ink-400">Add products to this inventory later from the Inventory dashboard.</p>
      </section>

    </div>

    <p class="mt-6 text-center text-xs text-ink-400">
      Inventories are physical stock locations. Products are added to them separately.
    </p>
  </main>

  <div id="unsavedModal" class="fixed inset-0 z-50 hidden items-center justify-center px-4">
    <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-sm" data-dismiss="unsaved"></div>
    <div class="relative bg-white rounded-2xl shadow-pop w-full max-w-md overflow-hidden rise">
      <div class="p-6">
        <div class="w-11 h-11 rounded-full bg-amber-50 flex items-center justify-center mb-4">
          <i data-lucide="alert-triangle" class="w-5 h-5 text-amber-600"></i>
        </div>
        <h3 class="text-lg font-bold text-ink-900">Leave without saving?</h3>
        <p class="mt-1.5 text-sm text-ink-500">Your inventory information hasn't been created yet.</p>
      </div>
      <div class="px-6 py-4 bg-ink-50 border-t border-ink-200/70 flex flex-col-reverse sm:flex-row sm:justify-end gap-3">
        <button id="stayBtn" class="w-full sm:w-auto px-4 py-2.5 rounded-xl border border-ink-200 bg-white text-sm font-medium text-ink-700 hover:bg-white/60 transition">Stay</button>
        <button id="leaveBtn" class="w-full sm:w-auto px-4 py-2.5 rounded-xl bg-brand text-white text-sm font-semibold hover:bg-brand-dark transition">Leave</button>
      </div>
    </div>
  </div>

  <div id="defaultConfirmModal" class="fixed inset-0 z-50 hidden items-center justify-center px-4">
    <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-sm" data-dismiss="default"></div>
    <div class="relative bg-white rounded-2xl shadow-pop w-full max-w-md overflow-hidden rise">
      <div class="p-6">
        <div class="w-11 h-11 rounded-full bg-amber-50 flex items-center justify-center mb-4">
          <i data-lucide="replace" class="w-5 h-5 text-amber-600"></i>
        </div>
        <h3 class="text-lg font-bold text-ink-900">Replace default inventory?</h3>
        <p class="mt-1.5 text-sm text-ink-500">
          <strong id="confirmCurrentName" class="text-ink-900">Main Warehouse</strong>
          is currently the default for this store. Set this new inventory as the default instead?
        </p>
      </div>
      <div class="px-6 py-4 bg-ink-50 border-t border-ink-200/70 flex flex-col-reverse sm:flex-row sm:justify-end gap-3">
        <button id="keepOldDefaultBtn" class="w-full sm:w-auto px-4 py-2.5 rounded-xl border border-ink-200 bg-white text-sm font-medium text-ink-700 hover:bg-white/60 transition">Keep current default</button>
        <button id="replaceDefaultBtn" class="w-full sm:w-auto px-4 py-2.5 rounded-xl bg-brand text-white text-sm font-semibold hover:bg-brand-dark transition">Replace default</button>
      </div>
    </div>
  </div>

  <script>
    window.__APP__ = {
      protocal: "<%= locals.protocal || 'https://' %>",
      domainName: "<%= locals.domainName || 'cococe.rw' %>",
      vendorId: "<%= (locals.user && locals.user.vendor && locals.user.vendor.id) || '' %>",
      stores: <%- JSON.stringify(locals.stores || []) %>
    };
  </script>

