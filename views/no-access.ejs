<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>COCOCE — <%=locals.title%></title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">

  <meta name="description" content="COCOCE — COCOCE Kigali Rwanda, Laptops, Desktops, Computer accessories, Smart tv, projectors, discover what you want about digital assets near you at Kigali">
  <meta name="keywords" content="Laptops, Desktops, Memories, Storages, Servers, keyboards, Printers, Screens, Repair, Explore, Electronic, Digital, Kigali, Rwanda">
  <meta name="author" content="COCOCE RW">

  <meta property="og:image" content="https://cdn.cococe.rw/meta/cococe.png">
  <meta property="og:url" content="https://www.cococe.rw">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Laptops, Printers, Accessories, Game consoles, Electronics, and much more, cococe, your wish our priority">
  <meta property="og:description" content="COCOCE Kigali Rwanda, Laptops, Desktops, Computer accessories, Smart tv, projectors, discover what you want about digital assets near you at Kigali">
  <meta property="og:logo" content="https://cdn.cococe.rw/meta/cococe.png" />

  <meta name="twitter:card" content="https://cdn.cococe.rw/meta/cococe.png">
  <meta property="twitter:domain" content="cococe.rw">
  <meta property="twitter:url" content="https://cococe.rw">
  <meta name="twitter:title" content="Laptops, Printers, Accessories, Game consoles, Electronics, and much more, cococe, your wish our priority">
  <meta name="twitter:description" content="COCOCE Kigali Rwanda, Laptops, Desktops, Computer accessories, Smart tv, projectors, discover what you want about digital assets near you at Kigali">

  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.11.0/axios.min.js" integrity="sha512-h9644v03pHqrIHThkvXhB2PJ8zf5E9IyVnrSfZg8Yj8k4RsO4zldcQc4Bi9iVLUCCsqNY0b4WXVV4UB+wbWENA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

  <link rel="stylesheet" href="/styles/components/notification.css">
  <link rel="stylesheet" href="/styles/main.css">
  <link rel="stylesheet" href="/styles/no-access.css">
</head>

<script>
  const domain = "<%=locals.protocal%>auth.<%=locals.domain%>/signout";
</script>

<body class="dots-bg">

  <nav class="px-4 md:px-10 py-3 border-b border-gray-100 bg-white/80 backdrop-blur-sm">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <a href="/" class="relative inline-block group">
        <img src="/images/logos/cococe.png" alt="Logo-brand" class="max-w-[120px] md:max-w-[100px]">
      </a>
      <span class="status-badge text-xs">Hey <%=locals.user?.username%>, <small>You do not have access to this page!</small></span>
    </div>
  </nav>

  <div class="main-content relative overflow-hidden">

    <div class="bg-shape w-72 h-72 bg-brand top-[-10%] left-[-5%] animate-float"></div>
    <div class="bg-shape w-96 h-96 bg-brand/50 bottom-[-10%] right-[-5%] animate-float" style="animation-delay: 2s;"></div>
    <div class="bg-shape w-48 h-48 bg-brand-light top-1/2 left-1/3 animate-float" style="animation-delay: 4s;"></div>

    <div class="w-full max-w-7xl flex flex-col items-center justify-center text-center animate-fade-in px-4">

      <div class="lock-icon-wrapper mb-4">
        <span class="text-[50px] text-[128px] text-brand"><i class="bi bi-shield-lock"></i></span>
      </div>

      <h1 class="text-3xl mt-1 md:text-4xl font-bold text-gray-900 mb-2 animate-slide-up">
        Access <span class="text-brand">Restricted</span>
      </h1>
      <p class="text-gray-500 text-base md:text-sm max-w-lg mx-auto mb-4 animate-slide-up p-4 mt-1" style="animation-delay: 0.1s">
        <%= locals.message %>
      </p>

      <div class="mt-4 mb-5 w-full max-w-4xl mx-auto text-left">
        <div class="bg-white border border-gray-200 rounded-2xl shadow-sm">

          <div class="flex items-center gap-2 px-6 pt-5">
            <h3 class="text-base font-semibold text-gray-900">
              Permission Details
            </h3>

            <i class="bi bi-info-circle text-gray-400"></i>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-gray-200 px-6 py-6">

            <div class="flex items-center gap-4 py-3 md:py-0">

              <div class="w-12 h-12 rounded-full bg-gray-100 flex items-center justify-center">
                <i class="bi bi-person text-gray-600 text-xl"></i>
              </div>

              <div>
                <p class="text-sm text-gray-500">
                  <%= locals.user.username %>
                </p>

                <p class="font-semibold text-xs text-gray-900">
                  <%= locals.account %> | <%= locals.user.role %>
                </p>
              </div>

            </div>

            <div class="flex items-center gap-4 py-3 md:py-0 md:px-8">

              <div class="w-full">
                <p class="text-sm text-gray-500">
                  Required
                </p>

                <div class="flex flex-nowrap gap-2 py-3 overflow-x-auto max-w-[100%] scrollbar-thin">

                  <% locals.accepted.forEach(role => { %>

                  <span class="px-3 py-1 rounded-full bg-red-50 text-brand text-xs font-medium border border-red-100 capitalize">
                    <%= role %>
                  </span>

                  <% }) %>

                </div>
              </div>

            </div>

            <div class="flex items-center gap-4 py-3 md:py-0 md:px-8">

              <div class="w-12 h-12 rounded-full bg-gray-100 flex items-center justify-center">
                <i class="bi bi-lock text-gray-600 text-xl"></i>
              </div>

              <div>
                <p class="text-sm text-gray-500">
                  Reason
                </p>
                <p class="font-medium text-xs text-gray-800 leading-6">
                  Missing Privilege
                </p>
              </div>

            </div>

          </div>

        </div>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 md:gap-8 animate-slide-up" style="animation-delay: 0.2s">
        <a href="/" class="btn-primary">
          <span class="hidden md:block">Go to the Home Page</span>
          <span class="md:hidden">Home Page</span>
        </a>
        <a href="mailto:sales@cococe.rw" class="btn-outline cursor-pointer">
          <i class="bi bi-person-plus mr-2"></i>
          Request Access
        </a>
        <form action="<%=locals.protocal%>auth.<%=locals.domain%>/signout" method="post" class="btn-outline cursor-pointer">
          <input type="hidden" value="<%=locals.user.userAccount%>" name="userAccount">
          <input type="hidden" name="host" value="<%=locals.protocal%>business.<%=locals.domainName%>/">
          <button type="submit">
            Signout <i class="bi bi-arrow-right"></i>
          </button>
        </form>

      </div>

      <div class="bg-brand-light/30 min-h-h-12 md:min-w-2xl px-4 py-3 mt-[2.5rem] rounded-xl flex items-center gap-4">

        <div>
          <i class="bi bi-question-circle"></i>
        </div>
        <div class="flex flex-col text-left gap-1">
          <strong class="text-sm">Need additional permission?</strong>
          <span class="text-xs text-gray-400">
            <a href="mailto:sales@cococe.rw">Contact our sales team </a> or <a href="<%=locals.protocal%>auth.<%=locals.domainName%>/support?q=privileges" class="text-brand hover:underline transition font-medium" target="_blank"> mention the issue</a>
          </span>
        </div>
        <a href="<%=locals.protocal%>auth.<%=locals.domainName%>/docs/privileges" target="_blank" class="ml-auto text-sm md:text-base text-brand border border-brand rounded-full px-3 py-2 hover:text-brand-dark hover:border-brand-dark hover:underline" target="_blank">
          Learn More
        </a>

      </div>
    </div>
  </div>

  <footer class="app-footer">
    <div class="app-footer-inner">
      <div class="flex items-center gap-3">
        <span class="text-sm font-bold text-brand">COCOCE</span>
        <span class="text-xs text-gray-400">© 2026 — All right reserved.</span>
      </div>
      <div class="footer-links">
        <a href="<%=locals.protocal%>auth.<%=locals.domainName%>/privacy" class="hover:text-brand transition hover:underline" target="_blank">
          Privacy
        </a>
        <a href="<%=locals.protocal%>auth.<%=locals.domainName%>/terms" class="hover:text-brand transition hover:underline" target="_blank">
          Terms
        </a>
        <a href="mailto:sales@cococe.rw" class="hover:text-brand transition hover:underline">
          Support
        </a>
        <form action="" method="post">
          <button type="submit" class="flex items-center gap-1 hover:text-brand hover:underline">
            Signout <i class="bi bi-arrow-right"></i>
          </button>
        </form>
      </div>
    </div>
  </footer>

</body>

</html>